        "CMSIS/Core/Include/core_cm4.h"
      ],
      "include": [
        "CMSIS/Core/Include"
      ],
      "triples": {
        "x86_64-linux-gnu": {
          "skip": "CMSIS-Core is Arm-only: core_cm4.h models Cortex-M registers and intrinsics, and the corpus parses it elsewhere only through a stub device header, so there is no product target"
        },
        "i686-linux-gnu": {
          "skip": "CMSIS-Core is Arm-only: core_cm4.h models Cortex-M registers and intrinsics, and the corpus parses it elsewhere only through a stub device header, so there is no product target"
        },
        "thumbv7em-none-eabihf": {
          "clang": [
            "-include",
            "ARMCM4.h"
          ]
        },
        "avr": {
          "skip": "CMSIS-Core is Arm-only: core_cm4.h models Cortex-M registers and intrinsics, and the corpus parses it elsewhere only through a stub device header, so there is no product target"
        }
