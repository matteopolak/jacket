#!/bin/sh
# Pre-commit hook: format and lint the staged files only. The checks live in tools/dev/dev.py
# (`python3 tools/dev/dev.py precommit`); see docs/tools/development.md#pre-commit-hook.
#
# Enable with `just hooks`. Skip once with `git commit --no-verify`.
#
# Environment: JAI_HOOK_SKIP="jaifmt jailint rustfmt spacing shellcheck repo locks editor" skips those checks,
# JAI_HOOK_NO_BUILD=1 never rebuilds a stale tool, JAI_HOOK_VERBOSE=1 prints what runs.

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
[ -f tools/dev/dev.py ] || exit 0
if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: warning: python3 not found; skipping the checks" >&2
    exit 0
fi
PYTHONPATH="$root/tools" exec python3 tools/dev/dev.py precommit "$@"
