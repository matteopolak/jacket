#!/bin/sh
# Pre-commit hook: format and lint the staged files only. See docs/tools/development.md#pre-commit-hook.
#
#   Jai   jaifmt --check, jailint -D warnings
#   Rust  rustfmt --check (pinned nightly, rustfmt.toml), tools/dev/rust_item_spacing.py --check
#
#   Shell shellcheck on staged *.sh and sh/bash-shebang files (skipped when shellcheck is not installed)
#   Repo  CI's style and path checks (tools/ci/check_*.py), Cargo.lock freshness, VS Code generated files
#
# Enable with `git config core.hooksPath .githooks`. Skip once with `git commit --no-verify`.
#
# Environment: JAI_HOOK_SKIP="jaifmt jailint rustfmt spacing shellcheck repo locks editor" skips those checks,
# JAI_HOOK_NO_BUILD=1 never rebuilds a stale tool, JAI_HOOK_VERBOSE=1 prints what runs.

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

# Refuse to run another checkout's copy of this hook: an absolute core.hooksPath into the main
# checkout (set when agent worktrees are created) would run its stale hook and skip every check.
hook_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)
own_dir=$(cd "$root/.githooks" 2>/dev/null && pwd -P)
if [ -n "$own_dir" ] && [ "$hook_dir" != "$own_dir" ]; then
    echo "pre-commit: error: running $hook_dir/pre-commit, not this worktree's $own_dir/pre-commit." >&2
    echo "pre-commit: core.hooksPath ($(git config core.hooksPath)) points into another checkout;" >&2
    echo "pre-commit: fix it with: git config core.hooksPath .githooks" >&2
    exit 1
fi

skipped() {
    case " ${JAI_HOOK_SKIP:-} " in *" $1 "*) return 0 ;; esac
    return 1
}

say() { [ -n "${JAI_HOOK_VERBOSE:-}" ] && echo "pre-commit: $*" >&2; return 0; }
warn() { echo "pre-commit: warning: $*" >&2; }

# The staged files that still exist after the commit, per language (rustfmt is checked for the
# workspace only, as CI runs `cargo fmt --all`). The same script backs `just fmt|lint --staged`.
jai_list=$(sh "$root/tools/dev/staged-files.sh" jai)
rs_list=$(sh "$root/tools/dev/staged-files.sh" rust)
sh_list=$(sh "$root/tools/dev/staged-files.sh" shell)
all_list=$(git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR)
[ -n "$all_list" ] || exit 0
staged_matches() { printf '%s\n' "$all_list" | grep -q -e "$@"; }

# Check what will be committed, not what is in the working tree: export the staged blobs.
tmp=$(mktemp -d "${TMPDIR:-/tmp}/jai-pre-commit.XXXXXX") || exit 0
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
printf '%s\n' "$jai_list" "$rs_list" "$sh_list" | grep . | tr '\n' '\0' |
    git checkout-index --prefix="$tmp/" -z --stdin || {
    warn "could not export the staged files; skipping the checks"
    exit 0
}
for cfg in jacket.toml rustfmt.toml rust-toolchain.toml; do
    git cat-file -e ":$cfg" 2>/dev/null && git show ":$cfg" >"$tmp/$cfg"
done

# Run `$@` with the lines of standard input appended as arguments.
with_list() {
    while IFS= read -r f; do
        [ -n "$f" ] && set -- "$@" "$f"
    done
    "$@"
}

# Where cargo builds: $CARGO_TARGET_DIR, else cargo's own answer (.cargo/config.toml), else target/.
target_dir() {
    if [ -n "${CARGO_TARGET_DIR:-}" ]; then
        printf '%s\n' "$CARGO_TARGET_DIR"
        return
    fi
    if command -v cargo >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
        dir=$(cargo metadata --no-deps --format-version 1 --offline 2>/dev/null |
            python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])' 2>/dev/null) &&
            [ -n "$dir" ] && { printf '%s\n' "$dir"; return; }
    fi
    printf '%s\n' "$root/target"
}

exe() { # the first existing path among $1 and $1.exe
    for p in "$1" "$1.exe"; do [ -f "$p" ] && { echo "$p"; return 0; }; done
    return 1
}

stale() { # does any file under the directories $2.. have a newer mtime than $1?
    bin=$1
    shift
    [ -n "$(find "$@" -type f \( -name '*.rs' -o -name '*.jai' -o -name '*.toml' \) -newer "$bin" 2>/dev/null | head -n 1)" ]
}

failed=0
fixes=""
add_fix() { fixes="$fixes
  $1"; }

# --- jaifmt ---------------------------------------------------------------------------------
find_jaifmt() {
    bin=$(exe "$target/jaifmt") || bin=""
    if [ -z "$JAI_HOOK_NO_BUILD" ]; then
        # The newer of the release and debug builds: a stale one may not compile the current jaifmt.
        jaic=$(exe "$target/release/jaic") || jaic=""
        debug=$(exe "$target/debug/jaic") || debug=""
        if [ -n "$debug" ] && { [ -z "$jaic" ] || [ -n "$(find "$debug" -newer "$jaic")" ]; }; then jaic=$debug; fi
        if [ -n "$jaic" ] && { [ -z "$bin" ] || stale "$bin" jaifmt stdlib/Extensions/Jai_Format stdlib/Extensions/Args; }; then
            say "rebuilding jaifmt"
            if "$jaic" jaifmt/main.jai -O2 -exe "$target/jaifmt" >/dev/null 2>&1 &&
                built=$(exe "$target/jaifmt"); then
                bin=$built
            else
                warn "could not rebuild jaifmt; using the existing one"
            fi
        fi
    fi
    [ -n "$bin" ] || bin=$(command -v jaifmt) || bin=""
    echo "$bin"
}

# --- jailint --------------------------------------------------------------------------------
find_jailint() {
    bin=""
    for p in "$target/release/jailint" "$target/debug/jailint"; do
        b=$(exe "$p") || continue
        if ! stale "$b" crates/jailint crates/jaic crates/jaic-cli stdlib/prelude/module.jai Cargo.lock; then
            bin=$b
            break
        fi
    done
    if [ -z "$bin" ] && [ -z "$JAI_HOOK_NO_BUILD" ] && command -v cargo >/dev/null 2>&1; then
        say "rebuilding jailint"
        if cargo build --quiet -p jailint >/dev/null 2>&1; then
            bin=$(exe "$target/debug/jailint") || bin=""
        else
            warn "could not rebuild jailint"
        fi
    fi
    [ -n "$bin" ] || bin=$(exe "$target/release/jailint") || bin=$(exe "$target/debug/jailint") || bin=$(command -v jailint) || bin=""
    echo "$bin"
}

if [ -n "$jai_list" ]; then
    target=$(target_dir)
    if skipped jaifmt; then
        :
    else
        jaifmt=$(find_jaifmt)
        if [ -z "$jaifmt" ]; then
            warn "jaifmt not found (build jaifmt into the cargo target directory, see docs/tools/development.md#pre-commit-hook); skipping the Jai format check"
        else
            say "jaifmt --check"
            if ! (cd "$tmp" && with_list "$jaifmt" --check) <<EOF
$jai_list
EOF
            then
                failed=1
                add_fix "jaifmt <files>"
            fi
        fi
    fi
    if skipped jailint; then
        :
    else
        jailint=$(find_jailint)
        if [ -z "$jailint" ]; then
            warn "jailint not found (cargo build -p jailint, see docs/tools/development.md#pre-commit-hook); skipping the Jai lint check"
        else
            # Linting needs the whole program around a file, so it reads the working tree.
            partial=""
            while IFS= read -r f; do
                git diff --quiet -- "$f" || partial="$partial $f"
            done <<EOF
$jai_list
EOF
            [ -z "$partial" ] || warn "partially staged, linted as in the working tree:$partial"
            # A platform's modules (Windows, Linux, X11, ...) cannot compile on another host, as in `just lint`.
            say "jailint -D warnings"
            if ! with_list "$jailint" -D warnings --allow-incomplete <<EOF
$jai_list
EOF
            then
                failed=1
                add_fix "jailint --fix <files>   (then fix the rest by hand)"
            fi
        fi
    fi
fi

# --- Rust -----------------------------------------------------------------------------------
if [ -n "$rs_list" ]; then
    if skipped rustfmt; then
        :
    elif ! command -v rustfmt >/dev/null 2>&1; then
        warn "rustfmt not found; skipping the Rust format check"
    else
        # Stdin mode: no module following, and the staged text is what is read.
        rs_bad=0
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            # In stdin mode rustfmt reports a diff but still exits 0, so read the output too.
            out=$(git show ":$f" | rustfmt --check --edition 2024 2>&1)
            status=$?
            if [ "$status" != 0 ] || [ -n "$out" ]; then
                echo "rustfmt: $f would change" >&2
                esc=$(printf '%s' "$f" | sed 's/[&|\\]/\\&/g')
                printf '%s\n' "$out" | sed "s|<stdin>|$esc|" >&2
                rs_bad=1
            fi
        done <<EOF
$rs_list
EOF
        if [ "$rs_bad" = 1 ]; then
            failed=1
            add_fix "cargo fmt --all"
        fi
    fi
    if skipped spacing; then
        :
    elif [ ! -f "$root/tools/dev/rust_item_spacing.py" ] || ! command -v python3 >/dev/null 2>&1; then
        warn "python3 or tools/dev/rust_item_spacing.py not found; skipping the Rust item spacing check"
    else
        if ! out=$(cd "$tmp" && with_list python3 "$root/tools/dev/rust_item_spacing.py" --check <<EOF
$rs_list
EOF
        ); then
            printf '%s\n' "$out" | sed "s|$tmp/||" >&2
            failed=1
            add_fix "python3 tools/dev/rust_item_spacing.py <files>"
        fi
    fi
fi

# --- Shell ----------------------------------------------------------------------------------
if [ -n "$sh_list" ] && ! skipped shellcheck; then
    if ! command -v shellcheck >/dev/null 2>&1; then
        warn "shellcheck not found; skipping the shell lint check"
    else
        say "shellcheck"
        # The staged copies, so the findings are about what will be committed.
        if ! out=$(cd "$tmp" && with_list shellcheck <<EOF
$sh_list
EOF
        ); then
            printf '%s\n' "$out" >&2
            failed=1
            add_fix "shellcheck <files>"
        fi
    fi
fi

# Repository checks CI runs on every push. They read the working tree, so a partly staged file is
# checked as it is on disk.
if ! skipped repo && command -v python3 >/dev/null 2>&1; then
    for check in check_source_style check_repo_paths check_ci_sources; do
        script="$root/tools/ci/$check.py"
        [ -f "$script" ] || continue
        say "running $check"
        if ! python3 "$script" >"$tmp/.out" 2>&1; then
            cat "$tmp/.out" >&2
            failed=1
            add_fix "python3 tools/ci/$check.py"
        fi
    done
fi

# A manifest change must come with its lock files (CI builds with --locked).
if ! skipped locks && command -v cargo >/dev/null 2>&1 && staged_matches 'Cargo\.toml$' -e 'Cargo\.lock$'; then
    for manifest in Cargo.toml fuzz/Cargo.toml; do
        [ -f "$root/$manifest" ] || continue
        say "checking the lock file of $manifest"
        if cargo metadata --locked --offline --format-version 1 --manifest-path "$root/$manifest" \
            >/dev/null 2>"$tmp/.out" || ! grep -q "cannot update the lock file" "$tmp/.out"; then
            continue
        fi
        echo "pre-commit: $(dirname "$manifest")/Cargo.lock is out of date" >&2
        failed=1
        add_fix "cargo metadata --format-version 1 --manifest-path $manifest >/dev/null"
    done
fi

# The VS Code grammar and schemas are generated from the compiler and config sources.
vscode="$root/editors/vscode"
if ! skipped editor && [ -d "$vscode/scripts" ] && staged_matches '^crates/' -e '^editors/vscode/'; then
    major=$(node --version 2>/dev/null | sed 's/^v\([0-9]*\).*/\1/')
    if [ "${major:-0}" -lt 24 ]; then
        warn "node 24 not found; skipping the VS Code generated-file check"
    else
        # "script args": build-grammar.ts has no subcommand, build.ts takes `schemas`.
        for gen in "build-grammar.ts" "build.ts schemas"; do
            say "running $gen --check"
            # shellcheck disable=SC2086 # $gen is a script name, then its subcommand
            if ! (cd "$vscode" && node scripts/$gen --check) >"$tmp/.out" 2>&1; then
                cat "$tmp/.out" >&2
                failed=1
                add_fix "(cd editors/vscode && node scripts/$gen)"
            fi
        done
    fi
fi

if [ "$failed" = 1 ]; then
    {
        echo
        echo "pre-commit: checks failed. Fix, re-stage (git add) and commit again:$fixes"
        echo "pre-commit: or skip the hook once with: git commit --no-verify"
    } >&2
    exit 1
fi
exit 0
