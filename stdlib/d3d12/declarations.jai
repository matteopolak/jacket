ID3D12CommandQueue_GetClockCalibration :: inline (this: *ID3D12CommandQueue, pGpuTimestamp: *u64, pCpuTimestamp: *u64) -> HRESULT {
    return this.vtable.GetClockCalibration(this, pGpuTimestamp, pCpuTimestamp);
}

ID3D12CommandQueue_GetDesc :: inline (this: *ID3D12CommandQueue) -> D3D12_COMMAND_QUEUE_DESC {
