// Convenience operations

get_Nominal_Range :: (fields: D3D11_VIDEO_PROCESSOR_COLOR_SPACE) -> u32 {
    return cast(u32) ((fields.__bitfield >> 4) & 3);
}

get_Reserved :: (fields: D3D11_VIDEO_PROCESSOR_COLOR_SPACE) -> u32 {
    return cast(u32) ((fields.__bitfield >> 6) & 67108863);
}

get_RGB_Range :: (fields: D3D11_VIDEO_PROCESSOR_COLOR_SPACE) -> bool {
    return ((fields.__bitfield >> 1) & 1) != 0;
}

get_Usage :: (fields: D3D11_VIDEO_PROCESSOR_COLOR_SPACE) -> bool {
    return ((fields.__bitfield >> 0) & 1) != 0;
}

get_YCbCr_Matrix :: (fields: D3D11_VIDEO_PROCESSOR_COLOR_SPACE) -> bool {
    return ((fields.__bitfield >> 2) & 1) != 0;
}

get_YCbCr_xvYCC :: (fields: D3D11_VIDEO_PROCESSOR_COLOR_SPACE) -> bool {
    return ((fields.__bitfield >> 3) & 1) != 0;
}

