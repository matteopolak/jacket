set_Nominal_Range :: (fields: *D3D11_VIDEO_PROCESSOR_COLOR_SPACE, value: u32) {
    fields.__bitfield = (fields.__bitfield & ~(cast(u32) 48)) | ((value & 3) << 4);
}

set_Reserved :: (fields: *D3D11_VIDEO_PROCESSOR_COLOR_SPACE, value: u32) {
    fields.__bitfield = (fields.__bitfield & ~(cast(u32) 4294967232)) | ((value & 67108863) << 6);
}

set_RGB_Range :: (fields: *D3D11_VIDEO_PROCESSOR_COLOR_SPACE, value: bool) {
    fields.__bitfield = (fields.__bitfield & ~(cast(u32) 2)) | (((cast(u32) value) & 1) << 1);
}

set_Usage :: (fields: *D3D11_VIDEO_PROCESSOR_COLOR_SPACE, value: bool) {
    fields.__bitfield = (fields.__bitfield & ~(cast(u32) 1)) | (((cast(u32) value) & 1) << 0);
}

set_YCbCr_Matrix :: (fields: *D3D11_VIDEO_PROCESSOR_COLOR_SPACE, value: bool) {
    fields.__bitfield = (fields.__bitfield & ~(cast(u32) 4)) | (((cast(u32) value) & 1) << 2);
}

set_YCbCr_xvYCC :: (fields: *D3D11_VIDEO_PROCESSOR_COLOR_SPACE, value: bool) {
    fields.__bitfield = (fields.__bitfield & ~(cast(u32) 8)) | (((cast(u32) value) & 1) << 3);
}

