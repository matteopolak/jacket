// Public DWARF values from the reviewed spec; independently grouped by role.

Dwarf_Base_Type :: enum {
    ADDRESS :: 0x01;
    BOOLEAN :: 0x02;
    COMPLEX_FLOAT :: 0x03;
    DECIMAL_FLOAT :: 0x0f;
    EDITED :: 0x0c;
    FLOAT :: 0x04;
    HI_USER :: 0xff;
    IMAGINARY_FLOAT :: 0x09;
    LO_USER :: 0x80;
    NUMERIC_STRING :: 0x0b;
    PACKED_DECIMAL :: 0x0a;
    SIGNED :: 0x05;
    SIGNED_CHAR :: 0x06;
    SIGNED_FIXED :: 0x0d;
    UNSIGNED :: 0x07;
    UNSIGNED_CHAR :: 0x08;
    UNSIGNED_FIXED :: 0x0e;
    UTF :: 0x10;
}

