--- a/rpmalloc.c
+++ b/rpmalloc.c
@@ -885,12 +885,23 @@
 static void
 _rpmalloc_set_name(void* address, size_t size) {
 #if defined(__linux__) || defined(__ANDROID__)
+#if BINDING_RPMALLOC_RUNTIME_CONFIGURATION
+	char *name = binding_rpmalloc_live_name(_memory_huge_pages);
+#else
 	const char *name = _memory_huge_pages ? _memory_config.huge_page_name : _memory_config.page_name;
-	if (address == MAP_FAILED || !name)
+#endif
+	if (address == MAP_FAILED || !name) {
+#if BINDING_RPMALLOC_RUNTIME_CONFIGURATION
+		free(name);
+#endif
 		return;
+	}
 	// If the kernel does not support CONFIG_ANON_VMA_NAME or if the call fails
 	// (e.g. invalid name) it is a no-op basically.
 	(void)prctl(PR_SET_VMA, PR_SET_VMA_ANON_NAME, (uintptr_t)address, size, (uintptr_t)name);
+#if BINDING_RPMALLOC_RUNTIME_CONFIGURATION
+	free(name);
+#endif
 #else
 	(void)sizeof(size);
 	(void)sizeof(address);
