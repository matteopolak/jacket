// Generated by tools/generators/generate_simd_lanes.py. Real scalar fallback kernels.

// Returns a vector of `N` lanes with every lane equal to `factor`. The lane type is the type of `factor`, so cast literals (`cast(s32) 7`); a bare `7` makes `s64` lanes. `N` must be a compile-time constant.
//
// ```jai
// v := set(4, cast(s32) 7);
// assert(v.data[0] == 7 && v.data[3] == 7);
// ```
set :: ($N: s64, factor: $T) -> SIMD_Array(N, T) #no_abc #no_aoc {
    result: SIMD_Array(N, T);
    for 0..N - 1 result.data[it] = factor;
    return result;
}

// Writes the lanes of `a` to memory starting at byte address `base`, in lane order, as one contiguous block of `size_of(a)` bytes. No alignment is needed.
//
// The caller guarantees the room; nothing is bounds-checked, and a null `base` fails an assert.
//
// ```jai
// storage: [4] s32;
// store(storage.data, set(4, cast(s32) 9));
// assert(storage[0] == 9 && storage[3] == 9);
// ```
store :: (base: *void, a: $T/SIMD_Array) #no_abc #no_aoc {
    B.assert(base != null || a.count == 0, "SIMD store requires writable storage");
    memcpy(base, a.data.data, size_of(T));
}

// Reads `N` lanes of type `F` from consecutive memory starting at `base`, lane 0 from the lowest address. Both the lane count and the lane type are explicit: `load(pointer, 4, s32)`. No alignment is needed.
//
// Reads `N * size_of(F)` bytes without checking that they exist; a null `base` fails an assert.
//
// ```jai
// numbers: [4] s32 = .[10, 20, 30, 40];
// v := load(numbers.data, 4, s32);
// assert(v.data[0] == 10 && v.data[3] == 40);
// ```
load :: (base: *void, $N: int, $F: Type) -> SIMD_Array(N, F) #no_abc #no_aoc {
    B.assert(base != null || N == 0, "SIMD load requires readable storage");
    result: SIMD_Array(N, F);
    memcpy(result.data.data, base, size_of(result));
    return result;
}

// Gathers one `F` per lane from `base + offsets.data[i]`, where each offset is a signed byte displacement (not an element index), and returns them in lane order. The result has as many lanes as `offsets`, whose lane type can be any integer type.
//
// Equal offsets repeat a value; negative ones reach below `base`. Nothing is bounds-checked; a null `base` fails an assert.
//
// ```jai
// numbers: [4] s32 = .[10, 20, 30, 40];
// offsets := set(3, cast(s64) 0);
// offsets.data = .[12, 0, 4]; // byte offsets: 3 * size_of(s32), 0, 1 * size_of(s32)
// v := load_from_offsets(numbers.data, offsets, s32);
// assert(v.data[0] == 40 && v.data[1] == 10 && v.data[2] == 20);
// ```
load_from_offsets :: (base: *void, offsets: $O/SIMD_Array, $F: Type) -> SIMD_Array(offsets.count, F) #no_abc #no_aoc {
    #assert type_info(O.type).type == .INTEGER;
    B.assert(base != null || offsets.count == 0, "SIMD gather requires readable storage");
    result: SIMD_Array(offsets.count, F);

    for 0..offsets.count - 1 {
        source := cast(*u8) base + cast(s64) offsets.data[it];
        memcpy(*result.data[it], source, size_of(F));
    }

    return result;
}

// Scatters the lanes of `a` to `base + offsets.data[i]`, each offset a signed byte displacement. `a` and `offsets` must have the same lane count (checked at compile time).
//
// Lanes are written in order, so when two offsets are equal the later lane wins. Nothing is bounds-checked; a null `base` fails an assert.
//
// ```jai
// numbers: [4] s32;
// values := set(2, cast(s32) 0);
// values.data = .[7, 8];
// offsets := set(2, cast(s64) 0);
// offsets.data = .[8, 0];
// store_with_offsets(values, numbers.data, offsets);
// assert(numbers[2] == 7 && numbers[0] == 8);
// ```
store_with_offsets :: (a: $T/SIMD_Array, base: *void, offsets: $O/SIMD_Array) #no_abc #no_aoc {
    #assert type_info(O.type).type == .INTEGER;
    #assert a.count == offsets.count;
    B.assert(base != null || a.count == 0, "SIMD scatter requires writable storage");

    for 0..a.count - 1 {
        target := cast(*u8) base + cast(s64) offsets.data[it];
        memcpy(target, *a.data[it], size_of(a.type));
    }
}

// Returns `N` lanes of type `I` holding `0, STEP, 2 * STEP, ...`: lane `i` is `i * STEP`. `STEP` can be negative. Useful as the offsets of a gather or scatter. `N` must be positive.
//
// ```jai
// indices := get_looping_indices(4, s32);
// assert(indices.data[0] == 0 && indices.data[3] == 3);
// stepped := get_looping_indices(4, s32, 3);
// assert(stepped.data[2] == 6);
// ```
get_looping_indices :: ($N: int, $I: Type, $STEP := 1) -> SIMD_Array(N, I) #no_abc #no_aoc {
    #assert N > 0;
    result: SIMD_Array(N, I);
    for 0..N - 1 result.data[it] = cast(I) (it * STEP);
    return result;
}

// Adds two vectors lane by lane.
//
// Integer lanes wrap on overflow, with no overflow check.
//
// ```jai
// a := set(4, cast(s32) 3);
// sum := a + set(4, cast(s32) 5);
// assert(sum.data[0] == 8 && sum.data[3] == 8);
// assert((a + cast(s32) 1).data[0] == 4);
// assert((cast(s32) 1 + a).data[0] == 4);
// ```
operator + :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = a.data[it] + b.data[it];
    return result;
}

// Adds `factor` to every lane. The scalar can be on either side.
operator + :: (a: $T/SIMD_Array, factor: a.type) -> T #symmetric #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = a.data[it] + factor;
    return result;
}

// Subtracts the lanes of `b` from those of `a`.
//
// Integer lanes wrap on overflow, so unsigned lanes wrap below zero.
//
// The scalar form also accepts the scalar on the left (it is `#symmetric`), but that spelling computes `vector - scalar`, not `scalar - vector`. To subtract a vector from a scalar, make the scalar a vector with `set` first.
//
// ```jai
// a := set(4, cast(s32) 3);
// assert((a - set(4, cast(s32) 5)).data[0] == -2);
// assert((a - cast(s32) 1).data[0] == 2);
// assert((set(4, cast(s32) 10) - a).data[0] == 7);
// ```
operator - :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = a.data[it] - b.data[it];
    return result;
}

// Subtracts `factor` from every lane. Put the scalar on the right: `scalar - vector` is accepted but gives the same result as `vector - scalar`.
operator - :: (a: $T/SIMD_Array, factor: a.type) -> T #symmetric #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = a.data[it] - factor;
    return result;
}

// Multiplies two vectors lane by lane.
//
// Integer lanes wrap on overflow, with no overflow check.
//
// ```jai
// a := set(4, cast(s32) 3);
// assert((a * set(4, cast(s32) 5)).data[0] == 15);
// assert((a * cast(s32) 2).data[3] == 6);
// assert((cast(s32) 2 * a).data[3] == 6);
// ```
operator * :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = a.data[it] * b.data[it];
    return result;
}

// Multiplies every lane by `factor`. The scalar can be on either side.
operator * :: (a: $T/SIMD_Array, factor: a.type) -> T #symmetric #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = a.data[it] * factor;
    return result;
}

// Divides the lanes of `a` by those of `b`.
//
// Integer lanes round toward zero. Division by zero behaves as scalar division does: it is not checked, and an integer lane traps or gives a platform result, while a float lane gives infinity or NaN.
//
// The scalar form also accepts the scalar on the left (it is `#symmetric`), but that spelling computes `vector / scalar`, not `scalar / vector`. To divide a scalar by a vector, make the scalar a vector with `set` first.
//
// ```jai
// a := set(4, cast(s32) 15);
// assert((a / set(4, cast(s32) 5)).data[0] == 3);
// assert((a / cast(s32) 2).data[0] == 7);
// assert((set(4, cast(s32) 30) / a).data[0] == 2);
// ```
operator / :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = a.data[it] / b.data[it];
    return result;
}

// Divides every lane by `factor`. Put the scalar on the right: `scalar / vector` is accepted but gives the same result as `vector / scalar`.
operator / :: (a: $T/SIMD_Array, factor: a.type) -> T #symmetric #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = a.data[it] / factor;
    return result;
}

// Compares lane by lane: each lane of the result is 1 where the lane of `a` is equal to the lane of `b`, else 0 (1.0 and 0.0 for float lanes). The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
//
// ```jai
// a := set(4, cast(s32) 3);
// b := a;
// b.data[2] = 9;
// same := a == b;
// assert(same.data[0] == 1 && same.data[2] == 0);
// assert(get_mask(a < b) == 4);
// assert(get_mask(a == cast(s32) 3) == 15);
// ```
//
// For float lanes a NaN is unequal to everything, itself included, as in scalar code.
operator == :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] == b.data[it]);
    return result;
}

// Compares every lane with `factor`: each lane of the result is 1 where the lane of `a` is equal to `factor`, else 0. The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
operator == :: (a: $T/SIMD_Array, factor: a.type) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] == factor);
    return result;
}

// Compares lane by lane: each lane of the result is 1 where the lane of `a` is different from the lane of `b`, else 0 (1.0 and 0.0 for float lanes). The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
operator != :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] != b.data[it]);
    return result;
}

// Compares every lane with `factor`: each lane of the result is 1 where the lane of `a` is different from `factor`, else 0. The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
operator != :: (a: $T/SIMD_Array, factor: a.type) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] != factor);
    return result;
}

// Compares lane by lane: each lane of the result is 1 where the lane of `a` is greater than the lane of `b`, else 0 (1.0 and 0.0 for float lanes). The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
operator > :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] > b.data[it]);
    return result;
}

// Compares every lane with `factor`: each lane of the result is 1 where the lane of `a` is greater than `factor`, else 0. The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
operator > :: (a: $T/SIMD_Array, factor: a.type) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] > factor);
    return result;
}

// Compares lane by lane: each lane of the result is 1 where the lane of `a` is greater than or equal to the lane of `b`, else 0 (1.0 and 0.0 for float lanes). The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
operator >= :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] >= b.data[it]);
    return result;
}

// Compares every lane with `factor`: each lane of the result is 1 where the lane of `a` is greater than or equal to `factor`, else 0. The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
operator >= :: (a: $T/SIMD_Array, factor: a.type) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] >= factor);
    return result;
}

// Compares lane by lane: each lane of the result is 1 where the lane of `a` is less than the lane of `b`, else 0 (1.0 and 0.0 for float lanes). The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
operator < :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] < b.data[it]);
    return result;
}

// Compares every lane with `factor`: each lane of the result is 1 where the lane of `a` is less than `factor`, else 0. The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
operator < :: (a: $T/SIMD_Array, factor: a.type) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] < factor);
    return result;
}

// Compares lane by lane: each lane of the result is 1 where the lane of `a` is less than or equal to the lane of `b`, else 0 (1.0 and 0.0 for float lanes). The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
operator <= :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] <= b.data[it]);
    return result;
}

// Compares every lane with `factor`: each lane of the result is 1 where the lane of `a` is less than or equal to `factor`, else 0. The result has the type of the operands, not `bool`, and is not an all-ones mask; pass it to `get_mask` to get one bit per lane.
operator <= :: (a: $T/SIMD_Array, factor: a.type) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = cast(a.type) (a.data[it] <= factor);
    return result;
}

// The lane-wise smaller of two vectors. Each lane is `Basic.min` of the two values, so with a NaN lane the answer depends on the operand order, as it does in scalar code.
//
// ```jai
// a := set(4, cast(s32) 3);
// b := set(4, cast(s32) 5);
// assert(min(a, b).data[0] == 3);
// assert(min(a, cast(s32) 4).data[0] == 3);
// ```
min :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = B.min(a.data[it], b.data[it]);
    return result;
}

// The lane-wise smaller of each lane and `factor`. Each lane is `Basic.min` of the two values, so with a NaN lane the answer depends on the operand order, as it does in scalar code.
min :: (a: $T/SIMD_Array, factor: a.type) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = B.min(a.data[it], factor);
    return result;
}

// The lane-wise larger of two vectors. Each lane is `Basic.max` of the two values, so with a NaN lane the answer depends on the operand order, as it does in scalar code.
//
// ```jai
// a := set(4, cast(s32) 3);
// b := set(4, cast(s32) 5);
// assert(max(a, b).data[0] == 5);
// assert(max(a, cast(s32) 4).data[0] == 4);
// ```
max :: (a: $T/SIMD_Array, b: T) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = B.max(a.data[it], b.data[it]);
    return result;
}

// The lane-wise larger of each lane and `factor`. Each lane is `Basic.max` of the two values, so with a NaN lane the answer depends on the operand order, as it does in scalar code.
max :: (a: $T/SIMD_Array, factor: a.type) -> T #no_abc #no_aoc {
    result: T;
    for 0..a.count - 1 result.data[it] = B.max(a.data[it], factor);
    return result;
}

// The sum of all lanes, added in lane order from the first lane, as a single value of the lane type. Integer lanes wrap on overflow; for floats the order of addition fixes the rounding.
//
// ```jai
// v := set(4, cast(s32) 3);
// assert(horizontal_sum(v) == 12);
// ```
horizontal_sum :: (a: $T/SIMD_Array) -> a.type {
    result: a.type;
    for a.data result += it;
    return result;
}

// Adds neighbouring lane pairs of `a` and of `b` and interleaves the sums: the result is `[a0 + a1, b0 + b1, a2 + a3, b2 + b3, ...]`. The lane count must be even (checked at compile time).
//
// ```jai
// a := set(4, cast(s32) 0);
// b := set(4, cast(s32) 0);
// a.data = .[1, 2, 3, 4];
// b.data = .[10, 20, 30, 40];
// r := horizontal_add(a, b);
// assert(r.data[0] == 3 && r.data[1] == 30 && r.data[2] == 7 && r.data[3] == 70);
// ```
horizontal_add :: (a: $T/SIMD_Array, b: T) -> (interleaved_result: T) {
    #assert (a.count % 2) == 0;
    result: T;

    for 0..a.count / 2 - 1 {
        result.data[it * 2] = a.data[it * 2] + a.data[it * 2 + 1];
        result.data[it * 2 + 1] = b.data[it * 2] + b.data[it * 2 + 1];
    }

    return result;
}

// Packs which lanes are nonzero into the bits of a number: bit `i` is set when lane `i` is not zero (-0.0 counts as zero). Pair it with a comparison to test many lanes at once.
//
// At most 64 lanes are allowed (checked at compile time); with exactly 64 lanes bit 63 is the sign bit, so a full set of lanes reads as `-1`.
//
// ```jai
// v := set(4, cast(s32) 0);
// v.data = .[0, 5, 0, 7];
// assert(get_mask(v) == 0b1010);
// assert(get_mask(v > cast(s32) 6) == 0b1000);
// assert(get_mask(set(64, cast(u8) 1)) == -1);
// ```
get_mask :: (a: $T/SIMD_Array) -> s64 {
    #assert a.count <= 64;
    bits: u64;
    one: u64 = 1;

    for 0..a.count - 1 {
        if cast(bool) a.data[it] bits |= one << it;
    }

    result: s64;

    memcpy(*result, *bits, 8);

    return result;
}

#scope_file
B :: #import "Basic";
