wgpuAdapterGetFeatures :: (adapter: WGPUAdapter, features: *WGPUSupportedFeatures) #foreign libwgpu;
wgpuAdapterGetInfo :: (adapter: WGPUAdapter, info: *WGPUAdapterInfo) -> WGPUStatus #foreign libwgpu;
