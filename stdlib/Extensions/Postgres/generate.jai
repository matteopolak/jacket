// `generate`: reads the catalog of a migrated database and writes `db/schema.jai`, a struct per
// table and view, an enum per Postgres enum, and the notes the ORM reads. docs/postgres/schema.md
// has the overview.
//
//     source, problem := Pg.generate_schema(config, "db/migrations");   // needs a server
//     source, problem := Pg.schema_source(catalog, hash);               // just the text

#scope_export

// A Postgres enum.
Catalog_Enum :: struct {
    key: string; // `"schema"."name"`, as `Described_Type.qualified`
    schema: string;
    name: string;
    labels: [] string; // in sort order
}

Catalog_Column :: struct {
    name: string;
    sql_type: string; // `format_type`, for the doc comment
    base: string; // what `jai_type_of` takes: "int8", "text[]", "json", or "enum" / "enum[]"
    enum_key: string; // the `Catalog_Enum.key` of an enum column or enum array
    nullable: bool;
    primary_key: bool;
    has_default: bool; // a default, identity or generated: an insert may leave it out
    generated: bool; // always generated: an insert may not give it a value
}

// A table, view, materialized view or foreign table.
Catalog_Relation :: struct {
    schema: string;
    name: string;
    view: bool;
    columns: [] Catalog_Column;
}

Catalog_Foreign_Key :: struct {
    schema: string; // the referencing table
    table: string;
    columns: [] string;
    target_schema: string;
    target_table: string;
    target_columns: [] string;
}

Catalog :: struct {
    enums: [] Catalog_Enum;
    relations: [] Catalog_Relation;
    foreign_keys: [] Catalog_Foreign_Key;
}

// Reads the catalog of the migrations' schema database (see schema_databases.jai) on the server
// `config` names, building it first when there is none, and returns the text of `db/schema.jai`;
// or what went wrong. Runs on a fiber, like every call that talks to the server.
generate_schema :: (config: Config, migrations_folder: string) -> source: string, problem: string {
    catalog, hash, problem := migrated_catalog(config, migrations_folder);
    if problem return "", problem;

    return schema_source(catalog, hash);
}

// The catalog of the migrations in `migrations_folder` and their schema hash, read from the
// schema database on the server `config` names (built first when there is none); or what went
// wrong. Runs on a fiber, like every call that talks to the server.
migrated_catalog :: (config: Config, migrations_folder: string) -> Catalog, hash: string, problem: string {
    migrations, problem := read_migrations(migrations_folder);
    if problem return .{}, "", problem;
    if !migrations.count return .{}, "", tprint("%: there are no migrations to generate a schema from", migrations_folder);

    admin, error := connect(config);
    if error.kind != .NONE return .{}, "", tprint("cannot connect: %", error_text(error));

    defer close(admin);

    hash := schema_hash(migrations);
    name := schema_database_name(hash);
    existing, list_error := schema_database_names(admin);

    if list_error.kind != .NONE return .{}, "", tprint("cannot list the schema databases: %", error_text(list_error));

    if !array_find(existing, name) {
        build_problem, _, _ := build_schema_database(admin, config, migrations, name);
        if build_problem return .{}, "", build_problem;

        prune_schema_databases(admin);
    }

    target := config;
    target.database = name;

    db, db_error := connect(target);
    if db_error.kind != .NONE return .{}, "", tprint("cannot connect to the schema database: %", error_text(db_error));

    defer close(db);

    catalog, catalog_error := load_catalog(db);
    if catalog_error.kind != .NONE return .{}, "", tprint("reading the catalog: %", error_text(catalog_error));

    return catalog, hash, "";
}

// The text of `db/schema.jai` for a catalog made from migrations with this schema hash, or a
// problem such as a column that cannot be a field name. Laid out as the formatter would.
schema_source :: (catalog: Catalog, hash: string) -> source: string, problem: string {
    names, problem := assign_names(catalog);
    if problem return "", problem;

    builder: String_Builder;
    builder.allocator = temp;

    json_keys: [..] string;
    json_keys.allocator = temp;

    for relation: catalog.relations {
        for column: relation.columns {
            if column.base == "json" || column.base == "jsonb" array_add(*json_keys, json_key(relation, column));
        }
    }

    print_to_builder(*builder, "// Generated by the pg tool's `generate` from db/migrations: do not edit it. Change a\n// migration, then generate again.\n%%\n\n", SCHEMA_HASH_MARKER, hash);

    // json_columns.jai is the user's own list of the Jai types the json columns hold.
    append(*builder, "#scope_file\n\nPg :: #import \"Extensions/Postgres\";\n\n");
    append(*builder, "#if #run Pg.file_exists_beside(#file, \"json_columns.jai\") {\n    #load \"json_columns.jai\";\n} else {\n    Json_Columns :: Pg.Json_Column.[];\n}\n\n#scope_export\n\n");
    append(*builder, "#run Pg.check_schema(#file);\n");
    append(*builder, "#run Pg.check_json_columns(Json_Columns, string.[");
    for json_keys print_to_builder(*builder, "%\"%\"", ifx it_index then ", " else "", it);

    append(*builder, "]);\n");

    for catalog.enums {
        print_to_builder(*builder, "\n/// Enum %.%.\n% :: enum {\n", it.schema, it.name, names.enums[it_index]);

        for label: it.labels print_to_builder(*builder, "    %;\n", enum_member_name(label));

        append(*builder, "}\n");
    }

    for catalog.relations {
        problem = append_relation(*builder, catalog, names, it_index);
        if problem return "", problem;
    }

    return builder_to_string(*builder), "";
}

// Everything the generator needs from a migrated database.
load_catalog :: (db: *Connection) -> Catalog, Pg_Error {
    catalog: Catalog;

    enums, error := load_enums(db);

    if error.kind != .NONE return catalog, error;

    relations: [] Catalog_Relation;
    relations, error = load_relations(db);
    if error.kind != .NONE return catalog, error;

    keys: [] Catalog_Foreign_Key;
    keys, error = load_constraints(db, relations);
    if error.kind != .NONE return catalog, error;

    catalog.enums = enums;
    catalog.relations = relations;
    catalog.foreign_keys = keys;

    return catalog, .{};
}

#scope_file

// What the catalog queries leave out: the system schemas, and what an extension owns.
USER_OBJECTS :: #string SQL
    n.nspname !~ '^pg_' and n.nspname <> 'information_schema'
    and not exists (select 1 from pg_depend d where d.objid = %.oid and d.deptype = 'e')
SQL

load_enums :: (db: *Connection) -> [] Catalog_Enum, Pg_Error {
    result, error := query_dynamic(db, tprint(#string SQL
        select quote_ident(n.nspname) || '.' || quote_ident(t.typname), n.nspname::text, t.typname::text, e.enumlabel::text
        from pg_enum e join pg_type t on t.oid = e.enumtypid join pg_namespace n on n.oid = t.typnamespace
        where % order by n.nspname, t.typname, e.enumsortorder
    SQL, tprint(USER_OBJECTS, "t")));

    if error.kind != .NONE return .[], error;

    defer free_result(*result);

    enums: [..] Catalog_Enum;
    row := 0;

    while row < result.row_count {
        key := text_cell(*result, row, 0);
        end := row;

        while end < result.row_count && text_cell(*result, end, 0) == key end += 1;

        labels := NewArray(end - row, string);
        for *labels it.* = copy_string(text_cell(*result, row + it_index, 3));

        array_add(*enums, .{ copy_string(key), copy_string(text_cell(*result, row, 1)), copy_string(text_cell(*result, row, 2)), labels });
        row = end;
    }

    return enums, .{};
}

load_relations :: (db: *Connection) -> [] Catalog_Relation, Pg_Error {
    result, error := query_dynamic(db, tprint(#string SQL
        select n.nspname::text, c.relname::text, c.relkind::text, a.attname::text, a.atttypid::int8, format_type(a.atttypid, a.atttypmod),
            a.attnotnull::text, (a.atthasdef or a.attidentity <> '')::text, (a.attgenerated <> '' or a.attidentity = 'a')::text
        from pg_class c join pg_namespace n on n.oid = c.relnamespace join pg_attribute a on a.attrelid = c.oid
        where c.relkind in ('r', 'p', 'v', 'm', 'f') and not c.relispartition and c.relname <> 'jacket_migrations'
            and a.attnum > 0 and not a.attisdropped and %
        order by n.nspname, c.relname, a.attnum
    SQL, tprint(USER_OBJECTS, "c")));

    if error.kind != .NONE return .[], error;

    defer free_result(*result);

    // The base type of every column, resolved the way typed queries do it.
    columns: [..] Column;
    columns.allocator = temp;

    for row: 0..result.row_count - 1 {
        type_oid, _ := get(*result, row, 4, s64);
        array_add(*columns, .{ type_oid = cast(u32) type_oid });
    }

    types, types_error := resolve_types(db, .{ columns = columns });
    if types_error.kind != .NONE return .[], types_error;

    relations: [..] Catalog_Relation;
    row := 0;

    while row < result.row_count {
        schema := text_cell(*result, row, 0);
        name := text_cell(*result, row, 1);
        kind := text_cell(*result, row, 2);
        end := row;

        while end < result.row_count && text_cell(*result, end, 1) == name && text_cell(*result, end, 0) == schema end += 1;

        relation: Catalog_Relation;
        relation.schema = copy_string(schema);
        relation.name = copy_string(name);
        relation.view = kind == "v" || kind == "m";
        relation.columns = NewArray(end - row, Catalog_Column);

        for *relation.columns {
            at := row + it_index;
            type_oid, _ := get(*result, at, 4, s64);
            view := relation.view;

            it.name = copy_string(text_cell(*result, at, 3));
            it.sql_type = copy_string(text_cell(*result, at, 5));
            it.base = copy_string(base_name(*types, cast(u32) type_oid));
            it.enum_key = copy_string(enum_key_of(*types, cast(u32) type_oid));
            // A view's columns carry no NOT NULL, so none is known to hold a value.
            it.nullable = view || text_cell(*result, at, 6) != "true";
            it.has_default = text_cell(*result, at, 7) == "true";
            it.generated = text_cell(*result, at, 8) == "true";

            if it.enum_key it.base = ifx ends_with(it.base, "[]") then "enum[]" else "enum";
        }

        array_add(*relations, relation);
        row = end;
    }

    return relations, .{};
}

// The enum a type is, is an array of, or is a domain over; or an empty string.
enum_key_of :: (types: *Described_Types, oid: u32) -> string {
    type := find_type(types, oid);

    for 1..8 {
        if !type return "";
        if type.kind == #char "e" return type.qualified;

        if type.kind == #char "d" type = find_type(types, type.base_oid);
        else if type.category == #char "A" && type.element_oid type = find_type(types, type.element_oid);
        else return "";
    }

    return "";
}

// Primary keys (marked on the relations' columns) and foreign keys.
load_constraints :: (db: *Connection, relations: [] Catalog_Relation) -> [] Catalog_Foreign_Key, Pg_Error {
    result, error := query_dynamic(db, #string SQL
        select c.contype::text, n.nspname::text, r.relname::text, fn.nspname::text, fr.relname::text,
            (select array_agg(a.attname::text order by k.ord) from unnest(c.conkey) with ordinality as k(num, ord) join pg_attribute a on a.attrelid = c.conrelid and a.attnum = k.num),
            (select array_agg(a.attname::text order by k.ord) from unnest(c.confkey) with ordinality as k(num, ord) join pg_attribute a on a.attrelid = c.confrelid and a.attnum = k.num)
        from pg_constraint c join pg_class r on r.oid = c.conrelid join pg_namespace n on n.oid = r.relnamespace
            left join pg_class fr on fr.oid = c.confrelid left join pg_namespace fn on fn.oid = fr.relnamespace
        where c.contype in ('p', 'f') order by n.nspname, r.relname, c.conname
    SQL);

    if error.kind != .NONE return .[], error;

    defer free_result(*result);

    keys: [..] Catalog_Foreign_Key;

    for row: 0..result.row_count - 1 {
        schema := text_cell(*result, row, 1);
        table := text_cell(*result, row, 2);
        columns, _ := get(*result, row, 5, [] string);

        relation: *Catalog_Relation;

        for *relations if it.schema == schema && it.name == table relation = it;
        if !relation continue; // a partition, or something the schema leaves out

        if text_cell(*result, row, 0) == "p" {
            for name: columns for *relation.columns if it.name == name it.primary_key = true;
            continue;
        }

        key: Catalog_Foreign_Key;
        target_columns, _ := get(*result, row, 6, [] string);

        key.schema = relation.schema;
        key.table = relation.name;
        key.columns = copy_strings(columns);
        key.target_schema = copy_string(text_cell(*result, row, 3));
        key.target_table = copy_string(text_cell(*result, row, 4));
        key.target_columns = copy_strings(target_columns);
        array_add(*keys, key);
    }

    return keys, .{};
}

copy_strings :: (strings: [] string) -> [] string {
    copy := NewArray(strings.count, string);
    for strings copy[it_index] = copy_string(it);

    return copy;
}

// ---- names ----

#scope_export

Names :: struct {
    enums: [] string; // the Jai type of each enum, in the catalog's order
    relations: [] string; // and of each relation
}

// The Jai names of the catalog's types. One whose preferred name is taken falls back to a longer
// one, so two tables never collapse into one struct.
assign_names :: (catalog: Catalog) -> Names, problem: string {
    taken: [..] string;
    taken.allocator = temp;

    enums := NewArray(catalog.enums.count, string,, temp);
    relations := NewArray(catalog.relations.count, string,, temp);

    for catalog.enums {
        if !word_name(it.name) return .{}, tprint("the enum %.% has a name that cannot be a Jai name", it.schema, it.name);

        base := tprint("%%", schema_prefix(it.schema), pascal_case(it.name));
        enums[it_index] = claim(*taken, base, tprint("%_Enum", base));
    }

    for catalog.relations {
        if !word_name(it.name) return .{}, tprint("the table % has a name that cannot be a Jai name", it.name);

        prefix := schema_prefix(it.schema);
        plural := tprint("%%", prefix, pascal_case(it.name));
        relations[it_index] = claim(*taken, tprint("%%", prefix, pascal_case(singular(it.name))), plural, tprint("%_%", plural, ifx it.view then "View" else "Table"));
    }

    return .{ enums, relations }, "";
}

#scope_file

// The first candidate nobody has, which is then taken; else the last with a number.
claim :: (taken: *[..] string, candidates: ..string) -> string {
    for candidates {
        if !array_find(taken.*, it) {
            array_add(taken, it);
            return it;
        }
    }

    n := 2;

    while true {
        candidate := tprint("%_%", candidates[candidates.count - 1], n);

        if !array_find(taken.*, candidate) {
            array_add(taken, candidate);
            return candidate;
        }

        n += 1;
    }

    return "";
}

// Types outside `public` start with their schema, so `audit.events` cannot meet `public.events`.
schema_prefix :: (schema: string) -> string {
    if schema == "public" return "";

    return tprint("%_", pascal_case(schema));
}

word_name :: (name: string) -> bool {
    if !name.count return false;

    for name if !(is_alnum(it) && it < 0x80) && it != #char "_" return false;

    return true;
}

// `blog_posts` as `Blog_Posts`.
pascal_case :: (name: string) -> string {
    out := copy_string(name,, temp);
    start := true;

    for *out {
        if it.* == #char "_" {
            start = true;
            continue;
        }

        if start it.* = to_upper(it.*);

        start = false;
    }

    // A name that starts with a digit is not a Jai name.
    if out.count && is_digit(out[0]) return tprint("T_%", out);

    return out;
}

// `blog_posts` as `blog_post`: one English plural, enough for table names.
singular :: (word: string) -> string {
    if word.count > 3 && ends_with(word, "ies") return tprint("%y", slice(word, 0, word.count - 3));

    for string.["sses", "shes", "ches", "xes", "zes"] {
        if ends_with(word, it) return slice(word, 0, word.count - 2);
    }

    if ends_with(word, "ss") || ends_with(word, "us") || ends_with(word, "is") return word;
    if word.count > 1 && ends_with(word, "s") return slice(word, 0, word.count - 1);

    return word;
}

// "table.column", with the schema in front when it is not `public`: how `Json_Columns` names a
// column.
json_key :: (relation: Catalog_Relation, column: Catalog_Column) -> string {
    if relation.schema == "public" return tprint("%.%", relation.name, column.name);

    return tprint("%.%.%", relation.schema, relation.name, column.name);
}

// ---- output ----

MODULE_TYPES :: string.["Uuid", "Timestamp", "Local_Timestamp", "Date", "Time", "Interval", "Numeric", "Json_Raw"];

// The Jai type of a Postgres base type (not an enum or json), as `Pg` names it.
pg_type_text :: (base: string) -> string {
    if ends_with(base, "[]") return tprint("[] %", pg_type_text(slice(base, 0, base.count - 2)));

    text := jai_type_of(base);
    if array_find(MODULE_TYPES, text) return tprint("Pg.%", text);

    return text;
}

#scope_export

// The type of a column's field, or a problem: an enum the catalog does not list.
field_type :: (relation: Catalog_Relation, column: Catalog_Column, catalog: Catalog, names: Names) -> string, problem: string {
    text: string;

    if column.base == "enum" || column.base == "enum[]" {
        found := false;

        for catalog.enums if it.key == column.enum_key {
            text = names.enums[it_index];
            found = true;
        }

        if !found return "", tprint("%.%.% is an enum (%) that the catalog does not list", relation.schema, relation.name, column.name, column.enum_key);

        if column.base == "enum[]" text = tprint("[] %", text);
    } else if column.base == "json" || column.base == "jsonb" {
        text = tprint("Pg.Json(Pg.json_column_type(\"%\"))", json_key(relation, column));
    } else {
        text = pg_type_text(column.base);
    }

    if column.nullable text = tprint("Pg.Nullable(%)", text);

    return text, "";
}

#scope_file

// How a belongs-to relation is called: the foreign key column without `_id`, else the column. It
// may not share a name with a column of its table or with another relation, so it falls back to
// the referenced table's name and then to a number.
relation_name :: (key: Catalog_Foreign_Key, taken: [] string, columns: [] Catalog_Column) -> string {
    first := key.columns[0];
    name := first;

    if key.columns.count == 1 && ends_with(first, "_id") && first.count > 3 name = slice(first, 0, first.count - 3);

    if name_is_free(name, taken, columns) return name;

    fallback := singular(key.target_table);
    if name_is_free(fallback, taken, columns) return fallback;

    n := 2;
    while !name_is_free(tprint("%_%", fallback, n), taken, columns) n += 1;

    return tprint("%_%", fallback, n);
}

name_is_free :: (name: string, taken: [] string, columns: [] Catalog_Column) -> bool {
    return !array_find(taken, name) && !column_called(columns, name);
}

column_called :: (columns: [] Catalog_Column, name: string) -> bool {
    for columns if it.name == name return true;
    return false;
}

find_relation :: (catalog: Catalog, schema: string, table: string) -> s64 {
    for catalog.relations if it.schema == schema && it.name == table return it_index;
    return -1;
}

join_columns :: (columns: [] string) -> string {
    return join(..columns, separator = ",",, temp);
}

// One struct: the relation notes (this table's foreign keys, and the foreign keys that point at
// it), then a field per column.
append_relation :: (builder: *String_Builder, catalog: Catalog, names: Names, index: s64) -> problem: string {
    relation := catalog.relations[index];
    type_name := names.relations[index];

    for column: relation.columns {
        if !valid_field_name(column.name) {
            return tprint("%.%: \"%\" cannot be a field name; rename the column in a migration", relation.schema, relation.name, column.name);
        }
    }

    print_to_builder(builder, "\n/// % %.%.\n% :: struct @pg_table(%.%)", ifx relation.view then "View" else "Table", relation.schema, relation.name, type_name, relation.schema, relation.name);

    taken: [..] string;
    taken.allocator = temp;

    for key: catalog.foreign_keys {
        if key.schema != relation.schema || key.table != relation.name continue;

        target := find_relation(catalog, key.target_schema, key.target_table);
        if target < 0 continue;

        name := relation_name(key, taken, relation.columns);

        array_add(*taken, name);

        print_to_builder(builder, " @pg_belongs_to(%:%:%:%)", name, join_columns(key.columns), names.relations[target], join_columns(key.target_columns));
    }

    many: [..] string;
    many.allocator = temp;

    for key: catalog.foreign_keys {
        if key.target_schema != relation.schema || key.target_table != relation.name continue;

        source := find_relation(catalog, key.schema, key.table);
        if source < 0 continue;

        name := key.table;
        if array_find(many, name) name = tprint("%_by_%", key.table, key.columns[0]);

        n := 2;

        while array_find(many, name) {
            name = tprint("%_by_%_%", key.table, key.columns[0], n);
            n += 1;
        }

        array_add(*many, name);

        print_to_builder(builder, " @pg_has_many(%:%:%:%)", name, names.relations[source], join_columns(key.columns), join_columns(key.target_columns));
    }

    append(builder, " {\n");

    for column: relation.columns {
        field, problem := field_type(relation, column, catalog, names);
        if problem return problem;

        print_to_builder(builder, "    /// %, %\n    %: %;", column.sql_type, ifx column.nullable then "nullable" else "not null", column.name, field);

        if column.primary_key append(builder, " @pg_primary_key");
        if column.has_default append(builder, " @pg_default");
        if column.generated append(builder, " @pg_generated");
        if column.base == "json" append(builder, " @pg_json");

        append(builder, "\n");
    }

    append(builder, "}\n");

    return "";
}
