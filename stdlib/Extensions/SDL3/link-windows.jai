// Windows SDK system libraries needed by SDL3-static.
#library,system,link_always "user32"; @native(external)
#library,system,link_always "gdi32"; @native(external)
#library,system,link_always "winmm"; @native(external)
#library,system,link_always "imm32"; @native(external)
#library,system,link_always "ole32"; @native(external)
#library,system,link_always "oleaut32"; @native(external)
#library,system,link_always "version"; @native(external)
#library,system,link_always "uuid"; @native(external)
#library,system,link_always "advapi32"; @native(external)
#library,system,link_always "setupapi"; @native(external)
#library,system,link_always "shell32"; @native(external)
#library,system,link_always "cfgmgr32"; @native(external)

#library,system,link_always "dinput8"; @native(external)
#library,system,link_always "kernel32"; @native(external)
