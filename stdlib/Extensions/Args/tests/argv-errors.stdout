--jobs -> kind=MISSING_VALUE message=[option `--jobs` needs a value] option=[--jobs] value=[] suggestion=[] set_jobs=false
--jobs=100 -> kind=OUT_OF_RANGE message=[value `100` for `--jobs` is out of range (1..64)] option=[--jobs] value=[100] suggestion=[] set_jobs=false
--jobs=many -> kind=INVALID_VALUE message=[invalid value `many` for `--jobs`: expected an integer] option=[--jobs] value=[many] suggestion=[] set_jobs=false
--check=yes -> kind=UNEXPECTED_VALUE message=[option `--check` does not take a value] option=[--check] value=[] suggestion=[] set_jobs=false
-z -> kind=UNKNOWN_OPTION message=[unknown option `-z`] option=[-z] value=[z] suggestion=[] set_jobs=false
