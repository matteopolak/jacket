CLI_POWERSHELL :: #string END_OF_TEXT
# PowerShell completion for jaifmt. Add this to your $PROFILE.

Register-ArgumentCompleter -Native -CommandName 'jaifmt' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)
    $elements = @($commandAst.CommandElements | ForEach-Object { $_.ToString() })
    $command = 'jaifmt'
    $previous = ''
    foreach ($element in $elements | Select-Object -Skip 1) {
        switch ("$command;$element") {
        }
    }

    $previous = if ($elements.Count -gt 1) { $elements[$elements.Count - 1] } else { '' }
    if ($wordToComplete -eq '' -and $elements.Count -gt 1) { $previous = $elements[$elements.Count - 1] }
    elseif ($elements.Count -gt 2) { $previous = $elements[$elements.Count - 2] }

    $values = switch ("$command;$previous") {
        'jaifmt;--color' { @('auto', 'always', 'never') }
        default { $null }
    }
    if ($null -ne $values) {
        $values | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
            [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
        }
        return
    }

    $completions = switch ($command) {
        'jaifmt' {
            @(
                [System.Management.Automation.CompletionResult]::new('-c', '-c', 'ParameterName', 'Do not write; list the files that would change')
                [System.Management.Automation.CompletionResult]::new('--check', '--check', 'ParameterName', 'Do not write; list the files that would change')
                [System.Management.Automation.CompletionResult]::new('--no-check', '--no-check', 'ParameterName', 'Do not write; list the files that would change')
                [System.Management.Automation.CompletionResult]::new('-j', '-j', 'ParameterName', 'Parallel jobs')
                [System.Management.Automation.CompletionResult]::new('--jobs', '--jobs', 'ParameterName', 'Parallel jobs')
                [System.Management.Automation.CompletionResult]::new('--color', '--color', 'ParameterName', 'When to colour the output')
                [System.Management.Automation.CompletionResult]::new('--config', '--config', 'ParameterName', 'Use this config file')
                [System.Management.Automation.CompletionResult]::new('-v', '-v', 'ParameterName', 'Say more (repeat for more)')
                [System.Management.Automation.CompletionResult]::new('--verbose', '--verbose', 'ParameterName', 'Say more (repeat for more)')
                [System.Management.Automation.CompletionResult]::new('-h', '-h', 'ParameterName', 'Print help')
                [System.Management.Automation.CompletionResult]::new('--help', '--help', 'ParameterName', 'Print help')
                [System.Management.Automation.CompletionResult]::new('-V', '-V', 'ParameterName', 'Print version')
                [System.Management.Automation.CompletionResult]::new('--version', '--version', 'ParameterName', 'Print version')
            )
        }
    }

    $completions | Where-Object { $_.CompletionText -like "$wordToComplete*" }
}
END_OF_TEXT;

TOOL_BASH :: #string END_OF_TEXT
# bash completion for tool
# Save as /etc/bash_completion.d/tool or source it from ~/.bashrc.

_tool() {
    local cur prev cmd i
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cmd="tool"
    for ((i = 1; i < COMP_CWORD; i++)); do
        case "${cmd}:${COMP_WORDS[i]}" in
            tool:build) cmd="tool__build" ;;
            tool:run) cmd="tool__run" ;;
            tool:remote-add) cmd="tool__remote_add" ;;
        esac
    done

    case "${cmd}:${prev}" in
        tool:--config)
            COMPREPLY=($(compgen -f -- "$cur"))
            return 0 ;;
        tool__build:--target)
            COMPREPLY=()
            return 0 ;;
        tool__build:--config)
            COMPREPLY=($(compgen -f -- "$cur"))
            return 0 ;;
        tool__run:--config)
            COMPREPLY=($(compgen -f -- "$cur"))
            return 0 ;;
        tool__remote_add:--config)
            COMPREPLY=($(compgen -f -- "$cur"))
            return 0 ;;
    esac

    local words="" subcommands=""
    case "$cmd" in
        tool) words="-v --verbose --config -q --quiet --no-quiet -h --help -V --version"; subcommands="build run remote-add" ;;
        tool__build) words="-r --release --no-release --target -v --verbose --config -h --help"; subcommands="" ;;
        tool__run) words="-v --verbose --config -h --help"; subcommands="" ;;
        tool__remote_add) words="-v --verbose --config -h --help"; subcommands="" ;;
    esac

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "$words" -- "$cur"))
    elif [[ -n "$subcommands" ]]; then
        COMPREPLY=($(compgen -W "$subcommands" -- "$cur"))
    else
        COMPREPLY=($(compgen -f -- "$cur"))
    fi
}

complete -F _tool -o bashdefault -o default tool
END_OF_TEXT;

TOOL_ZSH :: #string END_OF_TEXT
#compdef tool

# zsh completion for tool. Save as _tool in a directory on $fpath.

_tool() {
    local context state state_descr line
    typeset -A opt_args
    _arguments -C \
        '*-v[More output (repeat for more)]' \
        '*--verbose[More output (repeat for more)]' \
        '--config=[Configuration file]:FILE:_files' \
        '-q[Less output]' \
        '--quiet[Less output]' \
        '--no-quiet[Less output]' \
        '(-h --help)'{-h,--help}'[Print help]' \
        '(-V --version)'{-V,--version}'[Print version]' \
        '1: :->command' \
        '*:: :->arguments' && return
    case $state in
        command)
            local -a commands
            commands=(
                'build:Compile the project'
                'run:Run a program'
                'remote-add:Add a remote'
            )
            _describe -t commands 'command' commands ;;
        arguments)
            case $line[1] in
                build) _tool__build ;;
                run) _tool__run ;;
                remote-add) _tool__remote_add ;;
            esac ;;
    esac
}

_tool__build() {
    local context state state_descr line
    typeset -A opt_args
    _arguments -C \
        '-r[Optimise]' \
        '--release[Optimise]' \
        '--no-release[Optimise]' \
        '--target=[Target triple]:TARGET: ' \
        '*-v[More output (repeat for more)]' \
        '*--verbose[More output (repeat for more)]' \
        '--config=[Configuration file]:FILE:_files' \
        '(-h --help)'{-h,--help}'[Print help]' \
        '*:FILES:_files' \
        && return
}

_tool__run() {
    local context state state_descr line
    typeset -A opt_args
    _arguments -C \
        '*-v[More output (repeat for more)]' \
        '*--verbose[More output (repeat for more)]' \
        '--config=[Configuration file]:FILE:_files' \
        '(-h --help)'{-h,--help}'[Print help]' \
        ':PROGRAM:_files' \
        '*:ARGUMENTS:_files' \
        && return
}

_tool__remote_add() {
    local context state state_descr line
    typeset -A opt_args
    _arguments -C \
        '*-v[More output (repeat for more)]' \
        '*--verbose[More output (repeat for more)]' \
        '--config=[Configuration file]:FILE:_files' \
        '(-h --help)'{-h,--help}'[Print help]' \
        ':NAME:_files' \
        ':URL:_files' \
        && return
}

if [ "$funcstack[1]" = "_tool" ]; then
    _tool "$@"
else
    compdef _tool tool
fi
END_OF_TEXT;

