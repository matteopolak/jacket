CLI_BASH :: #string END_OF_TEXT
# bash completion for jaifmt
# Save as /etc/bash_completion.d/jaifmt or source it from ~/.bashrc.

_jaifmt() {
    local cur prev cmd i
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cmd="jaifmt"
    for ((i = 1; i < COMP_CWORD; i++)); do
        case "${cmd}:${COMP_WORDS[i]}" in
        esac
    done

    case "${cmd}:${prev}" in
        jaifmt:--jobs|-j)
            COMPREPLY=()
            return 0 ;;
        jaifmt:--color)
            COMPREPLY=($(compgen -W "auto always never" -- "$cur"))
            return 0 ;;
        jaifmt:--config)
            COMPREPLY=($(compgen -f -- "$cur"))
            return 0 ;;
    esac

    local words="" subcommands=""
    case "$cmd" in
        jaifmt) words="-c --check --no-check -j --jobs --color --config -v --verbose -h --help -V --version"; subcommands="" ;;
    esac

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "$words" -- "$cur"))
    elif [[ -n "$subcommands" ]]; then
        COMPREPLY=($(compgen -W "$subcommands" -- "$cur"))
    else
        COMPREPLY=($(compgen -f -- "$cur"))
    fi
}

complete -F _jaifmt -o bashdefault -o default jaifmt
END_OF_TEXT;

CLI_ZSH :: #string END_OF_TEXT
#compdef jaifmt

# zsh completion for jaifmt. Save as _jaifmt in a directory on $fpath.

_jaifmt() {
    local context state state_descr line
    typeset -A opt_args
    _arguments -C \
        '-c[Do not write; list the files that would change]' \
        '--check[Do not write; list the files that would change]' \
        '--no-check[Do not write; list the files that would change]' \
        '-j+[Parallel jobs]:JOBS: ' \
        '--jobs=[Parallel jobs]:JOBS: ' \
        '--color=[When to colour the output]:COLOR:(auto always never)' \
        '--config=[Use this config file]:FILE:_files' \
        '*-v[Say more (repeat for more)]' \
        '*--verbose[Say more (repeat for more)]' \
        '(-h --help)'{-h,--help}'[Print help]' \
        '(-V --version)'{-V,--version}'[Print version]' \
        '*:PATHS:_files' \
        && return
}

if [ "$funcstack[1]" = "_jaifmt" ]; then
    _jaifmt "$@"
else
    compdef _jaifmt jaifmt
fi
END_OF_TEXT;

