// The expected help and completion texts. Generated by data/bless.jai; do not edit by hand.

CLI_HELP :: #string END_OF_TEXT
Format Jai source files.

Usage: jaifmt [OPTIONS] [PATHS]...

Arguments:
  [PATHS]...           Files or directories to format

Options:
  -c, --[no-]check     Do not write; list the files that would change
  -j, --jobs <JOBS>    Parallel jobs [default: 4] [range: 1..64] [env: JAIFMT_JOBS]
      --color <COLOR>  When to colour the output [possible values: auto, always, never]
      --config <FILE>  Use this config file
  -v, --verbose        Say more (repeat for more)
  -h, --help           Print help
  -V, --version        Print version
END_OF_TEXT;

