// Rewrites golden.jai from the current output, for when a change to the help or completion
// layout is intended:
//
//     jaic run stdlib/Extensions/Args/tests/data/bless.jai > stdlib/Extensions/Args/tests/data/golden.jai
//
// (Not named like a test and not under tests/*.jai, so the stdlib runtime harness skips it.)

#import "Basic";
#import "String";

#load "outputs.jai";

main :: () {
    print("// The expected help and completion texts. Generated by data/bless.jai; do not edit by hand.\n\n");
    for help_outputs() print_golden(it);
    for completion_outputs() print_golden(it);
}

print_golden :: (entry: Named_Text) {
    print("% :: #string END_OF_TEXT\n%END_OF_TEXT;\n\n", entry.name, entry.text);
}
