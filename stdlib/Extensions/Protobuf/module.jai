// Binary protobuf messages generated by Extensions/Protobuf/Schema.
//
// Import with a name: `Proto :: #import "Extensions/Protobuf";`.
// Decoded allocations belong to context.allocator and are released by `Proto.free`.

// Why encoding or decoding stopped. Decode offsets are measured from the start of input.
Error_Kind :: enum u8 {
    NONE;
    TRUNCATED;
    BAD_TAG;
    BAD_WIRE_TYPE;
    BAD_GROUP;
    VARINT_TOO_LONG;
    TOO_DEEP;
    TOO_LARGE;
    BAD_UTF8;
    MISSING_REQUIRED;
    FIELD_ZERO;
}

// An encoding or decoding failure. The owned path names a field, including repeated indices.
Error :: struct {
    kind: Error_Kind;
    offset: s64;
    path: string;
}

// Limits for decode and merge. With borrow, the input must outlive the result. As with Json,
// use an arena or temp allocator whose free is a no-op and reset it instead of freeing the
// result; failed decodes also release borrowed slices through that allocator.
Decode_Options :: struct {
    max_depth: s64 = 100;
    max_size: s64 = 2147483647;
    borrow := false;
    discard_unknown := false;
}

// Explicit scalar presence, including a present default value.
Optional :: struct(T: Type) {
    has: bool;
    value: T;
}

// A map entry for MAP=.ARRAY; duplicates and wire order are retained.
Map_Entry :: struct(K: Type, V: Type) {
    key: K;
    value: V;
}

// Encodes into one exact-sized allocation; TOO_LARGE returns no bytes before allocation.
encode :: (value: $T) -> [] u8, Error {
    r := Reader.{ options = .{ max_depth = 2147483647 } };

    #if T.proto_has_required if !T.proto_check(*value, *r) return .{}, r.error;

    cache: [..] u32;

    defer array_free(cache);
    count := T.proto_size(*value, *cache);
    if count > 2147483647 return .{}, .{ kind = .TOO_LARGE };

    // The exact-size writer initializes the complete output.
    result := allocate_bytes(count);
    w := Writer.{ bytes = result, cache = cache };

    write_message(*w, *value);
    assert(w.pos == count);

    return result, .{};
}

// Appends a generated message to a resizable byte array.
encode_into :: (out: *[..] u8, value: $T) -> Error {
    bytes, error := encode(value);
    if error.kind != .NONE return error;

    defer Basic.free(bytes.data);
    array_add(out, ..bytes);

    return .{};
}

// Appends a generated message to a String_Builder.
encode_into :: (out: *String_Builder, value: $T) -> Error {
    bytes, error := encode(value);
    if error.kind != .NONE return error;

    defer Basic.free(bytes.data);
    append(out, string.{ bytes.count, bytes.data });

    return .{};
}

// Computes the encoded byte length without allocating output, saturating at 2 GiB.
size :: (value: $T) -> s64 {
    cache: [..] u32;
    defer array_free(cache);
    return T.proto_size(*value, *cache);
}

// Decodes a generated message. A failure releases all allocations and returns a zero value.
decode :: ($T: Type, bytes: [] u8, options := Decode_Options.{}) -> T, Error {
    value: T;
    error := merge(*value, bytes, options);
    if error.kind != .NONE T.proto_free(*value);
    return value, error;
}

// Merges wire data into a generated message. On failure the successfully merged prefix remains
// owned by value and must be freed. Strings and scalar values replace; message values merge.
merge :: (value: *$T, bytes: [] u8, options := Decode_Options.{}) -> Error {
    r := Reader.{ bytes = bytes, options = options };
    if bytes.count > options.max_size || options.max_size < 0 fail(*r, .TOO_LARGE);
    else if T.proto_merge(value, *r) {
        r.depth = 0;
        #if T.proto_has_required T.proto_check(value, *r);
    }

    return r.error;
}

// Releases a decoded message recursively and resets it; safe to call twice.
free :: (value: *$T) {
    T.proto_free(value);
} @FreesArgument

// Releases the error path and resets the error; safe to call twice.
free :: (error: *Error) {
    Basic.free(error.path);
    error.* = .{};
} @FreesArgument

// Deep equality of generated messages, including preserved unknown bytes.
equal :: (a: $T, b: T) -> bool {
    return T.proto_equal(*a, *b);
}

// A path relative to the calling Jai source, allocated with context.allocator.
beside :: (path: string, loc := #caller_location) -> string {
    return sprint("%/%", path_strip_filename(loc.fully_pathed_filename), path);
}

#load "wire.jai";
#load "fields.jai";

#scope_module
Basic :: #import "Basic";
#import "Basic";
#import "String";
