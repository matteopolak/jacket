    .{ "request/method.md:347", "request: SOURCE request", false, "", -1, "SOURCE /music/sweet/music HTTP/1.1\x0d\x0aHost: example.com\x0d\x0a\x0d\x0a", "M\x01SOURCE\x01/music/sweet/music\x011.1\x0aH\x01Host\x01example.com\x0aD\x0aC", "" },
    .{ "request/method.md:375", "request: SOURCE request with ICE", false, "", -1, "SOURCE /music/sweet/music ICE/1.0\x0d\x0aHost: example.com\x0d\x0a\x0d\x0a", "M\x01SOURCE\x01/music/sweet/music\x011.0\x0aH\x01Host\x01example.com\x0aD\x0aC", "ICE is not HTTP: only HTTP/1.0 and HTTP/1.1 are accepted" },
    .{ "request/method.md:405", "request: OPTIONS request with RTSP", false, "", -1, "OPTIONS /music/sweet/music RTSP/1.0\x0d\x0aHost: example.com\x0d\x0a\x0d\x0a", "M\x01OPTIONS\x01/music/sweet/music\x011.0\x0aH\x01Host\x01example.com\x0aD\x0aC", "RTSP is not HTTP: only HTTP/1.0 and HTTP/1.1 are accepted" },
    .{ "request/method.md:433", "request: ANNOUNCE request with RTSP", false, "", -1, "ANNOUNCE /music/sweet/music RTSP/1.0\x0d\x0aHost: example.com\x0d\x0a\x0d\x0a", "M\x01ANNOUNCE\x01/music/sweet/music\x011.0\x0aH\x01Host\x01example.com\x0aD\x0aC", "RTSP is not HTTP: only HTTP/1.0 and HTTP/1.1 are accepted" },
    .{ "request/method.md:461", "request: PRI request HTTP2", false, "", -1, "PRI * HTTP/1.1\x0d\x0a\x0d\x0aSM\x0d\x0a\x0d\x0a", "E\x01Pause on PRI/Upgrade", "" },
    .{ "request/method.md:485", "request: QUERY request", false, "", -1, "QUERY /contacts HTTP/1.1\x0d\x0aHost: example.org\x0d\x0aContent-Type: example/query\x0d\x0aAccept: text/csv\x0d\x0aContent-Length: 41\x0d\x0a\x0d\x0aselect surname, givenname, email limit 10", "M\x01QUERY\x01/contacts\x011.1\x0aH\x01Host\x01example.org\x0aH\x01Content-Type\x01example/query\x0aH\x01Accept\x01text/csv\x0aH\x01Content-Length\x0141\x0aD\x0aB\x0173656c656374207375726e616d652c20676976656e6e616d652c20656d61696c206c696d6974203130\x0aC", "" },
    .{ "request/uri.md:7", "request: Quotes in URI", false, "", -1, "GET /with_\"lovely\"_quotes?foo=\\\"bar\\\" HTTP/1.1\x0d\x0a\x0d\x0a", "M\x01GET\x01/with_\"lovely\"_quotes?foo=\\\"bar\\\"\x011.1\x0aD\x0aC", "" },
    .{ "request/uri.md:32", "request: Query URL with question mark", false, "", -1, "GET /test.cgi?foo=bar?baz HTTP/1.1\x0d\x0a\x0d\x0a", "M\x01GET\x01/test.cgi?foo=bar?baz\x011.1\x0aD\x0aC", "" },
    .{ "request/uri.md:55", "request: Host terminated by a query string", false, "", -1, "GET http://hypnotoad.org?hail=all HTTP/1.1\x0d\x0a\x0d\x0a\x0d\x0a", "M\x01GET\x01http://hypnotoad.org?hail=all\x011.1\x0aD\x0aC", "" },
    .{ "request/uri.md:78", "request: `host:port` terminated by a query string", false, "", -1, "GET http://hypnotoad.org:1234?hail=all HTTP/1.1\x0d\x0a\x0d\x0a", "M\x01GET\x01http://hypnotoad.org:1234?hail=all\x011.1\x0aD\x0aC", "" },
    .{ "request/uri.md:105", "request: Query URL with vertical bar character", false, "", -1, "GET /test.cgi?query=| HTTP/1.1\x0d\x0a\x0d\x0a", "M\x01GET\x01/test.cgi?query=|\x011.1\x0aD\x0aC", "" },
    .{ "request/uri.md:128", "request: `host:port` terminated by a space", false, "", -1, "GET http://hypnotoad.org:1234 HTTP/1.1\x0d\x0a\x0d\x0a", "M\x01GET\x01http://hypnotoad.org:1234\x011.1\x0aD\x0aC", "" },
    .{ "request/uri.md:151", "request: Disallow UTF-8 in URI path in strict mode", false, "", -1, "GET /\xce\xb4\xc2\xb6/\xce\xb4t/pope?q=1#narf HTTP/1.1\x0d\x0aHost: github.com\x0d\x0a\x0d\x0a", "E\x01Invalid char in url path", "" },
    .{ "request/uri.md:168", "request: Fragment in URI", false, "", -1, "GET /forums/1/topics/2375?page=1#posts-17408 HTTP/1.1\x0d\x0a\x0d\x0a", "M\x01GET\x01/forums/1/topics/2375?page=1#posts-17408\x011.1\x0aD\x0aC", "a fragment is never part of a request target (RFC 9112 3.2), so a target with # is refused" },
    .{ "request/uri.md:191", "request: Underscore in hostname", false, "", -1, "CONNECT home_0.netscape.com:443 HTTP/1.0\x0d\x0aUser-agent: Mozilla/1.1N\x0d\x0aProxy-authorization: basic aGVsbG86d29ybGQ=\x0d\x0a\x0d\x0a", "M\x01CONNECT\x01home_0.netscape.com:443\x011.0\x0aH\x01User-agent\x01Mozilla/1.1N\x0aH\x01Proxy-authorization\x01basic aGVsbG86d29ybGQ=\x0aD\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "llhttp stops after a CONNECT request (it counts as an upgrade) and fails on what follows; the codec reports the request and leaves the tunnel to the server" },
    .{ "request/uri.md:225", "request: `host:port` and basic auth", false, "", -1, "GET http://a\x2512:b!&*$@hypnotoad.org:1234/toto HTTP/1.1\x0d\x0a\x0d\x0a", "M\x01GET\x01http://a\x2512:b!&*$@hypnotoad.org:1234/toto\x011.1\x0aD\x0aC", "" },
    .{ "request/uri.md:248", "request: Space in URI", false, "", -1, "GET /foo bar/ HTTP/1.1\x0d\x0a\x0d\x0a", "E\x01Expected HTTP/, RTSP/ or ICE/", "" },
    .{ "request/connection.md:9", "request: Setting flag", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aConnection: keep-alive\x0d\x0a\x0d\x0a", "M\x01PUT\x01/url\x011.1\x0aH\x01Connection\x01keep-alive\x0aD\x0aC", "" },
    .{ "request/connection.md:37", "request: Restarting when keep-alive is explicitly", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aConnection: keep-alive\x0d\x0a\x0d\x0aPUT /url HTTP/1.1\x0d\x0aConnection: keep-alive\x0d\x0a\x0d\x0a", "M\x01PUT\x01/url\x011.1\x0aH\x01Connection\x01keep-alive\x0aD\x0aC\x0aM\x01PUT\x01/url\x011.1\x0aH\x01Connection\x01keep-alive\x0aD\x0aC", "" },
    .{ "request/connection.md:84", "request: No restart when keep-alive is off (1.0)", false, "", -1, "PUT /url HTTP/1.0\x0d\x0a\x0d\x0aPUT /url HTTP/1.1\x0d\x0a\x0d\x0a", "M\x01PUT\x01/url\x011.0\x0aD\x0aC\x0aE\x01Data after `Connection: close`", "" },
    .{ "request/connection.md:113", "request: Resetting flags when keep-alive is off (1.0, lenient)", false, "lenient-keep-alive", -1, "PUT /url HTTP/1.0\x0d\x0aContent-Length: 0\x0d\x0a\x0d\x0aPUT /url HTTP/1.1\x0d\x0aTransfer-Encoding: chunked\x0d\x0a\x0d\x0a", "M\x01PUT\x01/url\x011.0\x0aH\x01Content-Length\x010\x0aD\x0aC\x0aM\x01PUT\x01/url\x011.1\x0aH\x01Transfer-Encoding\x01chunked\x0aD", "" },
    .{ "request/connection.md:159", "request: CRLF between requests, implicit `keep-alive`", false, "", -1, "POST / HTTP/1.1\x0d\x0aHost: www.example.com\x0d\x0aContent-Type: application/x-www-form-urlencoded\x0d\x0aContent-Length: 4\x0d\x0a\x0d\x0aq=42\x0d\x0a\x0d\x0aGET / HTTP/1.1", "M\x01POST\x01/\x011.1\x0aH\x01Host\x01www.example.com\x0aH\x01Content-Type\x01application/x-www-form-urlencoded\x0aH\x01Content-Length\x014\x0aD\x0aB\x01713d3432\x0aC", "" },
    .{ "request/connection.md:211", "request: Not treating `\\r` as `-`", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aConnection: keep\x0dalive\x0d\x0a\x0d\x0a", "E\x01Missing expected LF after header value", "" },
    .{ "request/connection.md:239", "request: Setting flag on `close`", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aConnection: close\x0d\x0a\x0d\x0a", "M\x01PUT\x01/url\x011.1\x0aH\x01Connection\x01close\x0aD\x0aC", "" },
    .{ "request/connection.md:267", "request: Setting flag on `close` followed by tab", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aConnection: close\x09\x0d\x0a\x0d\x0a", "M\x01PUT\x01/url\x011.1\x0aH\x01Connection\x01close\x09\x0aD\x0aC", "" },
    .{ "request/connection.md:297", "request: CRLF between requests, explicit `close`", false, "", -1, "POST / HTTP/1.1\x0d\x0aHost: www.example.com\x0d\x0aContent-Type: application/x-www-form-urlencoded\x0d\x0aContent-Length: 4\x0d\x0aConnection: close\x0d\x0a\x0d\x0aq=42\x0d\x0a\x0d\x0aGET / HTTP/1.1", "M\x01POST\x01/\x011.1\x0aH\x01Host\x01www.example.com\x0aH\x01Content-Type\x01application/x-www-form-urlencoded\x0aH\x01Content-Length\x014\x0aH\x01Connection\x01close\x0aD\x0aB\x01713d3432\x0aC\x0aE\x01Data after `Connection: close`", "" },
    .{ "request/connection.md:347", "request: CRLF between requests, explicit `close` followed by tab", false, "", -1, "POST / HTTP/1.1\x0d\x0aHost: www.example.com\x0d\x0aContent-Type: application/x-www-form-urlencoded\x0d\x0aContent-Length: 4\x0d\x0aConnection: close\x09\x0d\x0a\x0d\x0aq=42\x0d\x0a\x0d\x0aGET / HTTP/1.1", "M\x01POST\x01/\x011.1\x0aH\x01Host\x01www.example.com\x0aH\x01Content-Type\x01application/x-www-form-urlencoded\x0aH\x01Content-Length\x014\x0aH\x01Connection\x01close\x09\x0aD\x0aB\x01713d3432\x0aC\x0aE\x01Data after `Connection: close`", "" },
    .{ "request/connection.md:397", "request: CRLF between requests, explicit `close` (lenient)", false, "lenient-keep-alive", -1, "POST / HTTP/1.1\x0d\x0aHost: www.example.com\x0d\x0aContent-Type: application/x-www-form-urlencoded\x0d\x0aContent-Length: 4\x0d\x0aConnection: close\x0d\x0a\x0d\x0aq=42\x0d\x0a\x0d\x0aGET / HTTP/1.1", "M\x01POST\x01/\x011.1\x0aH\x01Host\x01www.example.com\x0aH\x01Content-Type\x01application/x-www-form-urlencoded\x0aH\x01Content-Length\x014\x0aH\x01Connection\x01close\x0aD\x0aB\x01713d3432\x0aC", "" },
    .{ "request/connection.md:456", "request: Sample", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aConnection: close, token, upgrade, token, keep-alive\x0d\x0a\x0d\x0a", "M\x01PUT\x01/url\x011.1\x0aH\x01Connection\x01close, token, upgrade, token, keep-alive\x0aD\x0aC", "" },
    .{ "request/connection.md:484", "request: Multiple tokens with folding", false, "lenient-headers", -1, "GET /demo HTTP/1.1\x0d\x0aHost: example.com\x0d\x0aConnection: Something,\x0d\x0a Upgrade, ,Keep-Alive\x0d\x0aSec-WebSocket-Key2: 12998 5 Y3 1  .P00\x0d\x0aSec-WebSocket-Protocol: sample\x0d\x0aUpgrade: WebSocket\x0d\x0aSec-WebSocket-Key1: 4 @1  46546xW\x250l 1 5\x0d\x0aOrigin: http://example.com\x0d\x0a\x0d\x0aHot diggity dogg", "M\x01GET\x01/demo\x011.1\x0aH\x01Host\x01example.com\x0aH\x01Connection\x01Something, Upgrade, ,Keep-Alive\x0aH\x01Sec-WebSocket-Key2\x0112998 5 Y3 1  .P00\x0aH\x01Sec-WebSocket-Protocol\x01sample\x0aH\x01Upgrade\x01WebSocket\x0aH\x01Sec-WebSocket-Key1\x014 @1  46546xW\x250l 1 5\x0aH\x01Origin\x01http://example.com\x0aD\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "" },
    .{ "request/connection.md:545", "request: Multiple tokens with folding and LWS", false, "", -1, "GET /demo HTTP/1.1\x0d\x0aConnection: keep-alive, upgrade\x0d\x0aUpgrade: WebSocket\x0d\x0a\x0d\x0aHot diggity dogg", "M\x01GET\x01/demo\x011.1\x0aH\x01Connection\x01keep-alive, upgrade\x0aH\x01Upgrade\x01WebSocket\x0aD\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "llhttp treats a request with Upgrade as the end of HTTP and fails on the bytes after it; the codec keeps parsing because a server may ignore Upgrade (RFC 9110 7.8). Head.upgrade tells the server to look" },
    .{ "request/connection.md:579", "request: Multiple tokens with folding, LWS, and CRLF", false, "lenient-headers", -1, "GET /demo HTTP/1.1\x0d\x0aConnection: keep-alive, \x0d\x0a upgrade\x0d\x0aUpgrade: WebSocket\x0d\x0a\x0d\x0aHot diggity dogg", "M\x01GET\x01/demo\x011.1\x0aH\x01Connection\x01keep-alive,  upgrade\x0aH\x01Upgrade\x01WebSocket\x0aD\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "" },
    .{ "request/connection.md:614", "request: Invalid whitespace token with `Connection` header field", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aConnection : upgrade\x0d\x0aContent-Length: 4\x0d\x0aUpgrade: ws\x0d\x0a\x0d\x0aabcdefgh", "E\x01Invalid header field char", "" },
    .{ "request/connection.md:640", "request: Invalid whitespace token with `Connection` header field (lenient)", false, "lenient-headers", -1, "PUT /url HTTP/1.1\x0d\x0aConnection : upgrade\x0d\x0aContent-Length: 4\x0d\x0aUpgrade: ws\x0d\x0a\x0d\x0aabcdefgh", "M\x01PUT\x01/url\x011.1\x0aH\x01Connection \x01upgrade\x0aH\x01Content-Length\x014\x0aH\x01Upgrade\x01ws\x0aD\x0aB\x0161626364\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "" },
    .{ "request/connection.md:682", "request: Setting a flag and pausing", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aConnection: upgrade\x0d\x0aUpgrade: ws\x0d\x0a\x0d\x0a", "M\x01PUT\x01/url\x011.1\x0aH\x01Connection\x01upgrade\x0aH\x01Upgrade\x01ws\x0aD\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "llhttp treats a request with Upgrade as the end of HTTP and fails on the bytes after it; the codec keeps parsing because a server may ignore Upgrade (RFC 9110 7.8). Head.upgrade tells the server to look" },
    .{ "request/connection.md:716", "request: Emitting part of body and pausing", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aConnection: upgrade\x0d\x0aContent-Length: 4\x0d\x0aUpgrade: ws\x0d\x0a\x0d\x0aabcdefgh", "M\x01PUT\x01/url\x011.1\x0aH\x01Connection\x01upgrade\x0aH\x01Content-Length\x014\x0aH\x01Upgrade\x01ws\x0aD\x0aB\x0161626364\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "llhttp treats a request with Upgrade as the end of HTTP and fails on the bytes after it; the codec keeps parsing because a server may ignore Upgrade (RFC 9110 7.8). Head.upgrade tells the server to look" },
    .{ "request/connection.md:756", "request: Upgrade GET request", false, "", -1, "GET /demo HTTP/1.1\x0d\x0aHost: example.com\x0d\x0aConnection: Upgrade\x0d\x0aSec-WebSocket-Key2: 12998 5 Y3 1  .P00\x0d\x0aSec-WebSocket-Protocol: sample\x0d\x0aUpgrade: WebSocket\x0d\x0aSec-WebSocket-Key1: 4 @1  46546xW\x250l 1 5\x0d\x0aOrigin: http://example.com\x0d\x0a\x0d\x0aHot diggity dogg", "M\x01GET\x01/demo\x011.1\x0aH\x01Host\x01example.com\x0aH\x01Connection\x01Upgrade\x0aH\x01Sec-WebSocket-Key2\x0112998 5 Y3 1  .P00\x0aH\x01Sec-WebSocket-Protocol\x01sample\x0aH\x01Upgrade\x01WebSocket\x0aH\x01Sec-WebSocket-Key1\x014 @1  46546xW\x250l 1 5\x0aH\x01Origin\x01http://example.com\x0aD\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "llhttp treats a request with Upgrade as the end of HTTP and fails on the bytes after it; the codec keeps parsing because a server may ignore Upgrade (RFC 9110 7.8). Head.upgrade tells the server to look" },
    .{ "request/connection.md:815", "request: Upgrade POST request", false, "", -1, "POST /demo HTTP/1.1\x0d\x0aHost: example.com\x0d\x0aConnection: Upgrade\x0d\x0aUpgrade: HTTP/2.0\x0d\x0aContent-Length: 15\x0d\x0a\x0d\x0asweet post bodyHot diggity dogg", "M\x01POST\x01/demo\x011.1\x0aH\x01Host\x01example.com\x0aH\x01Connection\x01Upgrade\x0aH\x01Upgrade\x01HTTP/2.0\x0aH\x01Content-Length\x0115\x0aD\x0aB\x01737765657420706f737420626f6479\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "llhttp treats a request with Upgrade as the end of HTTP and fails on the bytes after it; the codec keeps parsing because a server may ignore Upgrade (RFC 9110 7.8). Head.upgrade tells the server to look" },
    .{ "request/content-length.md:7", "request: `Content-Length` with zeroes", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aContent-Length: 003\x0d\x0a\x0d\x0aabc", "M\x01PUT\x01/url\x011.1\x0aH\x01Content-Length\x01003\x0aD\x0aB\x01616263\x0aC", "" },
    .{ "request/content-length.md:44", "request: `Content-Length` with follow-up headers", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aContent-Length: 003\x0d\x0aOhai: world\x0d\x0a\x0d\x0aabc", "M\x01PUT\x01/url\x011.1\x0aH\x01Content-Length\x01003\x0aH\x01Ohai\x01world\x0aD\x0aB\x01616263\x0aC", "" },
    .{ "request/content-length.md:78", "request: Error on `Content-Length` overflow", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aContent-Length: 1000000000000000000000\x0d\x0a", "E\x01Content-Length overflow", "" },
    .{ "request/content-length.md:103", "request: Error on duplicate `Content-Length`", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aContent-Length: 1\x0d\x0aContent-Length: 2\x0d\x0a", "E\x01Duplicate Content-Length", "" },
    .{ "request/content-length.md:132", "request: Error on simultaneous `Content-Length` and `Transfer-Encoding: identity`", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aContent-Length: 1\x0d\x0aTransfer-Encoding: identity\x0d\x0a\x0d\x0a", "E\x01Transfer-Encoding can't be present with Content-Length", "" },
    .{ "request/content-length.md:162", "request: Invalid whitespace token with `Content-Length` header field", false, "", -1, "PUT /url HTTP/1.1\x0d\x0aConnection: upgrade\x0d\x0aContent-Length : 4\x0d\x0aUpgrade: ws\x0d\x0a\x0d\x0aabcdefgh", "E\x01Invalid header field char", "" },
