    .{ "request/finish.md:58", "request: It should be unsafe to finish inside of the header", false, "", 2, "PUT / HTTP/1.1\x0d\x0aContent-Leng", "", "" },
    .{ "request/pipelining.md:7", "request: Should parse multiple events", false, "", -1, "POST /aaa HTTP/1.1\x0d\x0aContent-Length: 3\x0d\x0a\x0d\x0aAAA\x0d\x0aPUT /bbb HTTP/1.1\x0d\x0aContent-Length: 4\x0d\x0a\x0d\x0aBBBB\x0d\x0aPATCH /ccc HTTP/1.1\x0d\x0aContent-Length: 5\x0d\x0a\x0d\x0aCCCC", "M\x01POST\x01/aaa\x011.1\x0aH\x01Content-Length\x013\x0aD\x0aB\x01414141\x0aC\x0aM\x01PUT\x01/bbb\x011.1\x0aH\x01Content-Length\x014\x0aD\x0aB\x0142424242\x0aC\x0aM\x01PATCH\x01/ccc\x011.1\x0aH\x01Content-Length\x015\x0aD\x0aB\x0143434343", "" },
