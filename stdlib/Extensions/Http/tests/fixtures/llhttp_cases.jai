    .{ "request/invalid.md:313", "request: Invalid header token #2", false, "", -1, "GET / HTTP/1.1\x0d\x0aFoo\x01\x09est: Bar\x0d\x0a\x0d\x0a", "E\x01Invalid header token", "" },
    .{ "request/invalid.md:336", "request: Invalid header token #3", false, "", -1, "GET / HTTP/1.1\x0d\x0a: Bar\x0d\x0a\x0d\x0a", "E\x01Invalid header token", "" },
    .{ "request/invalid.md:359", "request: Invalid method", false, "", -1, "MKCOLA / HTTP/1.1\x0d\x0a\x0d\x0a", "E\x01Expected space after method", "any method token is accepted (RFC 9110 9.1; the server answers 501 for methods it does not know), llhttp has a fixed method list" },
