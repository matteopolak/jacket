    .{ "response/transfer-encoding.md:7", "response: Empty `Transfer-Encoding` with `Content-Length`", true, "", -1, "HTTP/1.1 200 OK\x0d\x0aTransfer-Encoding:\x0d\x0aContent-Length: 5\x0d\x0a\x0d\x0ahello", "E\x01Empty Transfer-Encoding", "" },
    .{ "response/transfer-encoding.md:31", "response: Trailing space on chunked body", true, "", -1, "HTTP/1.1 200 OK\x0d\x0aContent-Type: text/plain\x0d\x0aTransfer-Encoding: chunked\x0d\x0a\x0d\x0a25  \x0d\x0aThis is the data in the first chunk\x0d\x0a\x0d\x0a1C\x0d\x0aand this is the second one\x0d\x0a\x0d\x0a0  \x0d\x0a\x0d\x0a", "S\x01200\x01OK\x011.1\x0aH\x01Content-Type\x01text/plain\x0aH\x01Transfer-Encoding\x01chunked\x0aD\x0aE\x01Invalid character in chunk size", "" },
    .{ "response/transfer-encoding.md:70", "response: `chunked` before other transfer-encoding", true, "", -1, "HTTP/1.1 200 OK\x0d\x0aAccept: */*\x0d\x0aTransfer-Encoding: chunked, deflate\x0d\x0a\x0d\x0aWorld", "S\x01200\x01OK\x011.1\x0aH\x01Accept\x01*/*\x0aH\x01Transfer-Encoding\x01chunked, deflate\x0aD\x0aB\x01576f726c64", "chunked must be the last coding: the codec refuses `chunked, deflate`, where RFC 9112 6.1 would read the response until close (a smuggling risk)" },
    .{ "response/transfer-encoding.md:101", "response: multiple transfer-encoding where chunked is not the last one", true, "", -1, "HTTP/1.1 200 OK\x0d\x0aAccept: */*\x0d\x0aTransfer-Encoding: chunked\x0d\x0aTransfer-Encoding: identity\x0d\x0a\x0d\x0aWorld", "S\x01200\x01OK\x011.1\x0aH\x01Accept\x01*/*\x0aH\x01Transfer-Encoding\x01chunked\x0aH\x01Transfer-Encoding\x01identity\x0aD\x0aB\x01576f726c64", "chunked must be the last coding: the codec refuses it followed by another Transfer-Encoding line, where RFC 9112 6.1 would read the response until close (a smuggling risk)" },
    .{ "response/transfer-encoding.md:139", "response: `chunkedchunked` transfer-encoding does not enable chunked enconding", true, "", -1, "HTTP/1.1 200 OK\x0d\x0aAccept: */*\x0d\x0aTransfer-Encoding: chunkedchunked\x0d\x0a\x0d\x0a2\x0d\x0aOK\x0d\x0a0\x0d\x0a\x0d\x0a", "S\x01200\x01OK\x011.1\x0aH\x01Accept\x01*/*\x0aH\x01Transfer-Encoding\x01chunkedchunked\x0aD\x0aB\x0132\x0aB\x010d\x0aB\x010a\x0aB\x014f4b\x0aB\x010d\x0aB\x010a\x0aB\x0130\x0aB\x010d\x0aB\x010a\x0aB\x010d\x0aB\x010a", "`chunkedchunked` is no known coding: refused at the head, where llhttp reads the response until close" },
    .{ "response/transfer-encoding.md:184", "response: Chunk extensions", true, "", -1, "HTTP/1.1 200 OK\x0d\x0aHost: localhost\x0d\x0aTransfer-encoding: chunked\x0d\x0a\x0d\x0a5;ilovew3;somuchlove=aretheseparametersfor\x0d\x0ahello\x0d\x0a6;blahblah;blah\x0d\x0a world\x0d\x0a0\x0d\x0a\x0d\x0a", "S\x01200\x01OK\x011.1\x0aH\x01Host\x01localhost\x0aH\x01Transfer-encoding\x01chunked\x0aD\x0aB\x0168656c6c6f\x0aB\x0120776f726c64\x0aC", "" },
    .{ "response/transfer-encoding.md:239", "response: No semicolon before chunk extensions", true, "", -1, "HTTP/1.1 200 OK\x0d\x0aHost: localhost\x0d\x0aTransfer-encoding: chunked\x0d\x0a\x0d\x0a2 erfrferferf\x0d\x0aaa\x0d\x0a0 rrrr\x0d\x0a\x0d\x0a", "S\x01200\x01OK\x011.1\x0aH\x01Host\x01localhost\x0aH\x01Transfer-encoding\x01chunked\x0aD\x0aE\x01Invalid character in chunk size", "" },
    .{ "response/transfer-encoding.md:275", "response: No extension after semicolon", true, "", -1, "HTTP/1.1 200 OK\x0d\x0aHost: localhost\x0d\x0aTransfer-encoding: chunked\x0d\x0a\x0d\x0a2;\x0d\x0aaa\x0d\x0a0\x0d\x0a\x0d\x0a", "S\x01200\x01OK\x011.1\x0aH\x01Host\x01localhost\x0aH\x01Transfer-encoding\x01chunked\x0aD\x0aE\x01Invalid character in chunk extensions", "" },
    .{ "response/transfer-encoding.md:311", "response: Chunk extensions quoting", true, "", -1, "HTTP/1.1 200 OK\x0d\x0aHost: localhost\x0d\x0aTransfer-Encoding: chunked\x0d\x0a\x0d\x0a5;ilovew3=\"I love; extensions\";somuchlove=\"aretheseparametersfor\";blah;foo=bar\x0d\x0ahello\x0d\x0a6;blahblah;blah\x0d\x0a world\x0d\x0a0\x0d\x0a", "S\x01200\x01OK\x011.1\x0aH\x01Host\x01localhost\x0aH\x01Transfer-Encoding\x01chunked\x0aD\x0aB\x0168656c6c6f\x0aB\x0120776f726c64", "" },
    .{ "response/transfer-encoding.md:372", "response: Unbalanced chunk extensions quoting", true, "", -1, "HTTP/1.1 200 OK\x0d\x0aHost: localhost\x0d\x0aTransfer-Encoding: chunked\x0d\x0a\x0d\x0a5;ilovew3=\"abc\";somuchlove=\"def; ghi\x0d\x0ahello\x0d\x0a6;blahblah;blah\x0d\x0a world\x0d\x0a0\x0d\x0a", "S\x01200\x01OK\x011.1\x0aH\x01Host\x01localhost\x0aH\x01Transfer-Encoding\x01chunked\x0aD\x0aE\x01Invalid character in chunk extensions quoted value", "" },
    .{ "response/transfer-encoding.md:416", "response: Invalid OBS fold after chunked value", true, "lenient-headers", -1, "HTTP/1.1 200 OK\x0d\x0aTransfer-Encoding: chunked\x0d\x0a  abc\x0d\x0a\x0d\x0a5\x0d\x0aWorld\x0d\x0a0\x0d\x0a\x0d\x0a", "S\x01200\x01OK\x011.1\x0aH\x01Transfer-Encoding\x01chunked  abc\x0aD\x0aB\x0135\x0aB\x010d\x0aB\x010a\x0aB\x01576f726c64\x0aB\x010d\x0aB\x010a\x0aB\x0130\x0aB\x010d\x0aB\x010a\x0aB\x010d\x0aB\x010a", "" },
