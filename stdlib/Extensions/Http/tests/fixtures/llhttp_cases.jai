    .{ "request/method.md:276", "request: LINK request", false, "", -1, "LINK /images/my_dog.jpg HTTP/1.1\x0d\x0aHost: example.com\x0d\x0aLink: <http://example.com/profiles/joe>; rel=\"tag\"\x0d\x0aLink: <http://example.com/profiles/sally>; rel=\"tag\"\x0d\x0a\x0d\x0a", "M\x01LINK\x01/images/my_dog.jpg\x011.1\x0aH\x01Host\x01example.com\x0aH\x01Link\x01<http://example.com/profiles/joe>; rel=\"tag\"\x0aH\x01Link\x01<http://example.com/profiles/sally>; rel=\"tag\"\x0aD\x0aC", "" },
