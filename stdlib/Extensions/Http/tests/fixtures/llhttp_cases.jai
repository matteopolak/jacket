    .{ "request/method.md:30", "request: CONNECT request", false, "", -1, "CONNECT 0-home0.netscape.com:443 HTTP/1.0\x0d\x0aUser-agent: Mozilla/1.1N\x0d\x0aProxy-authorization: basic aGVsbG86d29ybGQ=\x0d\x0a\x0d\x0asome data\x0d\x0aand yet even more data", "M\x01CONNECT\x010-home0.netscape.com:443\x011.0\x0aH\x01User-agent\x01Mozilla/1.1N\x0aH\x01Proxy-authorization\x01basic aGVsbG86d29ybGQ=\x0aD\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "" },
    .{ "request/method.md:65", "request: CONNECT request with CAPS", false, "", -1, "CONNECT HOME0.NETSCAPE.COM:443 HTTP/1.0\x0d\x0aUser-agent: Mozilla/1.1N\x0d\x0aProxy-authorization: basic aGVsbG86d29ybGQ=\x0d\x0a\x0d\x0a", "M\x01CONNECT\x01HOME0.NETSCAPE.COM:443\x011.0\x0aH\x01User-agent\x01Mozilla/1.1N\x0aH\x01Proxy-authorization\x01basic aGVsbG86d29ybGQ=\x0aD\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "llhttp stops after a CONNECT request (it counts as an upgrade) and fails on what follows; the codec reports the request and leaves the tunnel to the server" },
    .{ "request/method.md:99", "request: CONNECT with body", false, "", -1, "CONNECT foo.bar.com:443 HTTP/1.0\x0d\x0aUser-agent: Mozilla/1.1N\x0d\x0aProxy-authorization: basic aGVsbG86d29ybGQ=\x0d\x0aContent-Length: 10\x0d\x0a\x0d\x0ablarfcicle\"", "M\x01CONNECT\x01foo.bar.com:443\x011.0\x0aH\x01User-agent\x01Mozilla/1.1N\x0aH\x01Proxy-authorization\x01basic aGVsbG86d29ybGQ=\x0aH\x01Content-Length\x0110\x0aD\x0aC\x0aE\x01Pause on CONNECT/Upgrade", "llhttp stops after a CONNECT request (it counts as an upgrade) and fails on what follows; the codec reports the request and its framed body and leaves the tunnel to the server" },
