    .{ "request/invalid.md:399", "request: Corrupted Connection header", false, "", -1, "GET / HTTP/1.1\x0d\x0aHost: www.example.com\x0d\x0aConnection\x0d\x1b5\xc3\x95eep-Alive\x0d\x0aAccept-Encoding: gzip\x0d\x0a\x0d\x0a", "E\x01Invalid header token", "" },
    .{ "request/invalid.md:428", "request: Corrupted header name", false, "", -1, "GET / HTTP/1.1\x0d\x0aHost: www.example.com\x0d\x0aX-Some-Header\x0d\x1b5\xc3\x95eep-Alive\x0d\x0aAccept-Encoding: gzip\x0d\x0a\x0d\x0a", "E\x01Invalid header token", "" },
    .{ "request/invalid.md:458", "request: Missing CR between headers", false, "", -1, "GET / HTTP/1.1\x0d\x0aHost: localhost\x0d\x0aDummy: x\x0aContent-Length: 23\x0d\x0a\x0d\x0aGET / HTTP/1.1\x0d\x0aDummy: GET /admin HTTP/1.1\x0d\x0aHost: localhost\x0d\x0a\x0d\x0a", "E\x01Missing expected CR after header value", "" },
    .{ "request/invalid.md:493", "request: Invalid HTTP version", false, "", -1, "GET / HTTP/5.6", "E\x01Invalid HTTP version", "start line errors are found when the line is complete; llhttp fails on the first bad byte, before the CRLF" },
    .{ "request/invalid.md:512", "request: Invalid space after start line", false, "", -1, "GET / HTTP/1.1\x0d\x0a Host: foo", "E\x01Unexpected space after start line", "" },
    .{ "request/invalid.md:534", "request: Only LFs present", false, "", -1, "POST / HTTP/1.1\x0aTransfer-Encoding: chunked\x0aTrailer: Baz\x0d\x0aFoo: abc\x0aBar: def\x0a\x0a1\x0aA\x0a1;abc\x0aB\x0a1;def=ghi\x0aC\x0a1;jkl=\"mno\"\x0aD\x0a0\x0a\x0aBaz: ghi\x0a\x0a\\", "E\x01Expected CRLF after version", "" },
    .{ "request/invalid.md:571", "request: Only LFs present (lenient)", false, "lenient-all", -1, "POST / HTTP/1.1\x0aTransfer-Encoding: chunked\x0aTrailer: Baz\x0d\x0aFoo: abc\x0aBar: def\x0a\x0a1\x0aA\x0a1;abc\x0aB\x0a1;def=ghi\x0aC\x0a1;jkl=\"mno\"\x0aD\x0a0\x0a\x0aBaz: ghi\x0a\x0a", "M\x01POST\x01/\x011.1\x0aH\x01Transfer-Encoding\x01chunked\x0aH\x01Trailer\x01Baz\x0aH\x01Foo\x01abc\x0aH\x01Bar\x01def\x0aD\x0aB\x0141\x0aB\x0142\x0aB\x0143\x0aB\x0144\x0aT\x01Baz\x01ghi\x0aC", "" },
    .{ "request/invalid.md:654", "request: Spaces before headers", false, "", -1, "POST /hello HTTP/1.1\x0d\x0aHost: localhost\x0d\x0aFoo: bar\x0d\x0a Content-Length: 38\x0d\x0a\x0d\x0aGET /bye HTTP/1.1\x0d\x0aHost: localhost\x0d\x0a\x0d\x0a", "E\x01Unexpected whitespace after header value", "" },
