    .{ "request/invalid.md:69", "request: HTTP protocol and ANNOUNCE method", false, "", -1, "ANNOUNCE /music/sweet/music HTTP/1.0\x0d\x0aHost: example.com\x0d\x0a\x0d\x0a", "E\x01Invalid method for HTTP/x.x request", "any method token is accepted (RFC 9110 9.1; the server answers 501 for methods it does not know), llhttp has a fixed method list" },
    .{ "request/invalid.md:90", "request: Headers separated by CR", false, "", -1, "GET / HTTP/1.1\x0d\x0aFoo: 1\x0dBar: 2\x0d\x0a\x0d\x0a", "E\x01Missing expected LF after header value", "" },
