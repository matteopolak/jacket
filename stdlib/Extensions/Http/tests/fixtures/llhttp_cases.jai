    .{ "request/invalid.md:150", "request: Headers separated by dummy characters", false, "", -1, "GET / HTTP/1.1\x0d\x0aConnection: close\x0d\x0aHost: a\x0d\x0a\x0dZGET /evil: HTTP/1.1\x0d\x0aHost: a\x0d\x0a", "E\x01Expected LF after headers", "" },
    .{ "request/invalid.md:184", "request: Headers separated by dummy characters (lenient)", false, "lenient-optional-lf-after-cr", -1, "GET / HTTP/1.1\x0d\x0aConnection: close\x0d\x0aHost: a\x0d\x0a\x0dZGET /evil: HTTP/1.1\x0d\x0aHost: a\x0d\x0a", "M\x01GET\x01/\x011.1\x0aH\x01Connection\x01close\x0aH\x01Host\x01a\x0aD\x0aC\x0aE\x01Data after `Connection: close`", "" },
    .{ "request/invalid.md:219", "request: Empty headers separated by CR", false, "", -1, "POST / HTTP/1.1\x0d\x0aConnection: Close\x0d\x0aHost: localhost:5000\x0d\x0ax:\x0dTransfer-Encoding: chunked\x0d\x0a\x0d\x0a1\x0d\x0aA\x0d\x0a0\x0d\x0a", "E\x01Expected LF after CR", "" },
