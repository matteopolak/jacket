        assert(M.abs(cast(float64) rgb.component[1] - cast(float64) 0.0) < 0.000001);
        assert(M.abs(cast(float64) rgb.component[2] - cast(float64) 0.43634214997291565) < 0.000001);
    }

    {
        lab := C.linear_srgb_to_oklab(M.xyz(cast(float32) -0.46400606632232666, cast(float32) -0.8515693545341492, cast(float32) 1.5897934436798096));

        assert(M.abs(cast(float64) lab.component[0] - cast(float64) -0.8106820583343506) < 0.000001);
        assert(M.abs(cast(float64) lab.component[1] - cast(float64) 0.7044439315795898) < 0.000001);
        assert(M.abs(cast(float64) lab.component[2] - cast(float64) -1.370726466178894) < 0.000001);
        rgb := C.oklab_to_linear_srgb(lab);

        assert(M.abs(cast(float64) rgb.component[0] - cast(float64) 0.0) < 0.000001);
        assert(M.abs(cast(float64) rgb.component[1] - cast(float64) 0.0) < 0.000001);
        assert(M.abs(cast(float64) rgb.component[2] - cast(float64) 1.0) < 0.000001);
    }

    print("independent oracle ok\n");
}
