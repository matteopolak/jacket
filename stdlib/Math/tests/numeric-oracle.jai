    {
        matrix := M.Matrix3.{ 10, 5, 2, 2, 7, -4, 3, -5, 15 };
        ok, result := M.inverse(matrix);

        assert(ok);
        assert(M.abs(result.coef[0][0] - cast(float32) 0.14705882352941177) < 0.00001);
        assert(M.abs(result.coef[0][1] - cast(float32) -0.14705882352941177) < 0.00001);
        assert(M.abs(result.coef[0][2] - cast(float32) -0.058823529411764705) < 0.00001);
        assert(M.abs(result.coef[1][0] - cast(float32) -0.0726643598615917) < 0.00001);
        assert(M.abs(result.coef[1][1] - cast(float32) 0.2491349480968858) < 0.00001);
        assert(M.abs(result.coef[1][2] - cast(float32) 0.07612456747404844) < 0.00001);
        assert(M.abs(result.coef[2][0] - cast(float32) -0.05363321799307959) < 0.00001);
        assert(M.abs(result.coef[2][1] - cast(float32) 0.11245674740484429) < 0.00001);
        assert(M.abs(result.coef[2][2] - cast(float32) 0.10380622837370242) < 0.00001);
    }

