        assert(M.abs(result.coef[0][1] - cast(float32) 0.012269938650306749) < 0.00001);
        assert(M.abs(result.coef[0][2] - cast(float32) -0.18404907975460122) < 0.00001);
        assert(M.abs(result.coef[1][0] - cast(float32) -0.1165644171779141) < 0.00001);
        assert(M.abs(result.coef[1][1] - cast(float32) 0.06748466257668712) < 0.00001);
        assert(M.abs(result.coef[1][2] - cast(float32) -0.012269938650306749) < 0.00001);
