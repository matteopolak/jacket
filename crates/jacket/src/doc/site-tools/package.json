{
  "name": "jacket-doc-site-assets",
  "private": true,
  "description": "Development-only lint, format and type checks for the plain JS and CSS in ../site/assets. Nothing here is built or shipped: jacket embeds the asset files as they are.",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "lint": "pnpm run lint:js && pnpm run lint:types && pnpm run lint:css && pnpm run fmt:check",
    "lint:js": "cd ../site && oxlint -c ../site-tools/.oxlintrc.json --deny-warnings assets",
    "lint:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "lint:css": "stylelint \"../site/assets/*.css\"",
    "fmt": "cd ../site && oxfmt -c ../site-tools/.oxfmtrc.json assets",
    "fmt:check": "cd ../site && oxfmt -c ../site-tools/.oxfmtrc.json --check assets",
    "check-ages": "node ../../../../../editors/vscode/scripts/check-dependency-age.ts --dir ."
  },
  "devDependencies": {
    "oxfmt": "0.73.0",
    "oxlint": "1.85.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3"
  }
}
