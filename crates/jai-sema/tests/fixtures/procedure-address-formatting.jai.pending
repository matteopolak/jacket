// Parsing this source does not establish VM formatting or portable publication.
increment::(value:s32)->s32 { return value+1; }
main::()->int {
    original:Any=increment;
    address:=(cast(**void)original.value_pointer).*;
    boxed:Any=address;
    remaining:=(cast(*u64)boxed.value_pointer).*;
    alphabet::"0123456789abcdef";
    output:[16]u8;
    end:=output.data+16;
    cursor:=end;
    while remaining {
        digit:=remaining%16;
        remaining/=16;
        cursor-=1;
        cursor.*=alphabet[digit];
    }
    return 42;
}
