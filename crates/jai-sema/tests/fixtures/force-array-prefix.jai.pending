Prefix::struct { low:u64; }
Wide::struct { low:u64; high:u64; }
main::()->int {
    values:[2]u64=.[42,0xffffffffffffffff];
    signed:=cast,force([2]s64)values;
    if signed[1]!=-1 return 1;
    wide:Wide=.{42,99};
    prefix:=cast,FORCE(Prefix)wide;
    if prefix.low!=42 return 2;
    return signed[0];
}
