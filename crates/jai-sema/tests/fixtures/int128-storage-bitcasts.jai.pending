// Independently authored two-word storage cases matching Basic/Int128's layouts.
S128::struct { low:u64; high:s64; }
U128::struct { low:u64; high:u64; }
calls:int=0;
produce::()->S128 { calls+=1; return .{41,-1}; }
main::()->int {
    original:S128=.{41,-1};
    unsigned:=cast,force(U128)original;
    if unsigned.high!=0xffffffffffffffff return 1;
    unsigned.low=42;
    signed:=cast,force(S128)unsigned;
    if signed.high!=-1 || original.low!=41 return 2;
    evaluated:=cast,force(U128)produce();
    if calls!=1 || evaluated.low!=41 return 3;
    return cast(int)signed.low;
}
