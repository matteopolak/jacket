---
import type {Example} from '../generated/doc-site.js';
interface Props {example:Example}
const {example}=Astro.props;
---
{example.runnable && <button type="button" class="btn sm js-only" data-act="reset" hidden title="Put the original example back">Reset</button>}
<button type="button" class="btn sm js-only" data-act="copy" aria-label="Copy this example" title="Copy">Copy</button>
{example.playgroundUrl && <a class="btn sm" href={example.playgroundUrl} aria-label="Open this example in the playground" title="Open in the playground">↗</a>}
{example.runnable ? <button type="button" class="btn sm js-only" data-act="run" data-program={example.id}>Run ▸</button> : example.reason && <button type="button" class="btn sm js-only" disabled title={example.reason}>Run ▸</button>}
