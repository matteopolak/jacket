# SDL3 generated assets use exact UTF-8/LF bytes for reproducibility and SHA256.
# Keep the policy within the new SDL3 module and its generated native/ABI files.
/stdlib/Extensions/SDL3/* text eol=lf
/tools/native/sdl3/inline-*.c text eol=lf
/tools/native/sdl3/macros.c text eol=lf
/stdlib/Extensions/SDL3/tests/driven/layout-*.jai text eol=lf
/stdlib/Extensions/SDL3/tests/c-layout-*.h text eol=lf
