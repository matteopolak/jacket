# SDL3 generated assets use exact UTF-8/LF bytes for reproducibility and SHA256.
# Keep the policy within the new SDL3 module and its generated native/ABI files.
/stdlib/Extensions/SDL3/* text eol=lf
/tools/native/sdl3/inline-*.c text eol=lf
/tools/native/sdl3/macros.c text eol=lf
/stdlib/Extensions/SDL3/tests/driven/layout-*.jai text eol=lf
/stdlib/Extensions/SDL3/tests/c-layout-*.h text eol=lf

# jaifmt goldens compare exact bytes (including intentionally mixed newlines).
/stdlib/Extensions/Jai_Format/tests/fixtures/* -text

# The glob table is read by Rust and Jai tests that split on "\n".
/tests/glob/cases.txt text eol=lf

# Postgres schema goldens are compared with generated LF text.
/stdlib/Extensions/Postgres/tests/schema/* text eol=lf

# Image and compression fixtures are compared byte for byte; some have no NUL bytes and would
# otherwise get CRLF line endings on a Windows checkout.
/stdlib/Extensions/Image/tests/fixtures/** -text
/examples/webgpu/textured_cube/assets/** -text
