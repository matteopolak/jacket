{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TOML (jaifmt.toml, jailint.toml)",
  "scopeName": "source.toml.jai-settings",
  "patterns": [
    { "include": "#comment" },
    {
      "name": "meta.table.toml",
      "match": "^\\s*(\\[\\[?)\\s*([^\\]]+?)\\s*(\\]\\]?)",
      "captures": {
        "1": { "name": "punctuation.definition.table.toml" },
        "2": { "name": "entity.name.section.toml" },
        "3": { "name": "punctuation.definition.table.toml" }
      }
    },
    {
      "match": "^\\s*([A-Za-z0-9_.-]+|\"[^\"]*\")\\s*(=)",
      "captures": {
        "1": { "name": "variable.other.key.toml" },
        "2": { "name": "keyword.operator.assignment.toml" }
      }
    },
    { "include": "#value" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.toml",
      "match": "#.*$"
    },
    "value": {
      "patterns": [
        { "include": "#comment" },
        {
          "name": "string.quoted.triple.toml",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "name": "constant.character.escape.toml", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.double.toml",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [{ "name": "constant.character.escape.toml", "match": "\\\\." }]
        },
        { "name": "string.quoted.single.toml", "match": "'[^']*'" },
        { "name": "constant.language.boolean.toml", "match": "\\b(?:true|false)\\b" },
        { "name": "constant.numeric.toml", "match": "[+-]?\\b(?:0x[0-9A-Fa-f_]+|0o[0-7_]+|0b[01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)\\b" },
        { "name": "punctuation.definition.array.toml", "match": "[\\[\\]]" },
        { "name": "punctuation.separator.array.toml", "match": "," }
      ]
    }
  }
}
