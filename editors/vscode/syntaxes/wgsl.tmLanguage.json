{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WGSL (in Jai here-strings)",
  "scopeName": "source.wgsl.jai-embedded",
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#attribute" },
        { "include": "#function-declaration" },
        { "include": "#type-declaration" },
        { "include": "#var-template" },
        { "include": "#number" },
        { "include": "#keyword" },
        { "include": "#type" },
        { "include": "#call" },
        { "include": "#operator" },
        { "include": "#punctuation" }
      ]
    },
    "comments": {
      "patterns": [
        { "include": "#block-comment" },
        {
          "name": "comment.line.double-slash.wgsl",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.wgsl" } },
          "end": "$"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.wgsl",
      "begin": "/\\*",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.wgsl" } },
      "end": "\\*/",
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.wgsl" } },
      "patterns": [{ "include": "#block-comment" }]
    },
    "attribute": {
      "match": "(@)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.attribute.wgsl" },
        "2": { "name": "entity.name.function.decorator.wgsl" }
      }
    },
    "function-declaration": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.wgsl" },
        "2": { "name": "entity.name.function.wgsl" }
      }
    },
    "type-declaration": {
      "match": "\\b(struct|alias)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.wgsl" },
        "2": { "name": "entity.name.type.wgsl" }
      }
    },
    "var-template": {
      "comment": "var<storage, read_write>: the address space and access mode.",
      "begin": "\\b(var)\\s*(<)",
      "beginCaptures": {
        "1": { "name": "storage.type.variable.wgsl" },
        "2": { "name": "punctuation.definition.template.begin.wgsl" }
      },
      "end": ">",
      "endCaptures": { "0": { "name": "punctuation.definition.template.end.wgsl" } },
      "patterns": [
        {
          "name": "storage.modifier.wgsl",
          "match": "\\b(?:function|private|workgroup|uniform|storage|handle|read|write|read_write)\\b"
        },
        { "name": "punctuation.separator.comma.wgsl", "match": "," }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.wgsl",
          "match": "\\b0[xX](?:[0-9a-fA-F]+\\.?[0-9a-fA-F]*|\\.[0-9a-fA-F]+)(?:[pP][+-]?[0-9]+)?[iufh]?\\b"
        },
        {
          "name": "constant.numeric.float.wgsl",
          "match": "(?:\\b[0-9]+\\.[0-9]*|(?<![A-Za-z0-9_])\\.[0-9]+)(?:[eE][+-]?[0-9]+)?[fh]?|\\b[0-9]+[eE][+-]?[0-9]+[fh]?\\b"
        },
        { "name": "constant.numeric.decimal.wgsl", "match": "\\b[0-9]+[iufh]?\\b" }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.wgsl",
          "match": "\\b(?:if|else|switch|case|default|loop|for|while|break|continue|continuing|return|discard)\\b"
        },
        { "name": "storage.type.wgsl", "match": "\\b(?:fn|var|let|const|override|struct|alias)\\b" },
        { "name": "keyword.other.wgsl", "match": "\\b(?:enable|requires|diagnostic|const_assert)\\b" },
        { "name": "constant.language.boolean.wgsl", "match": "\\b(?:true|false)\\b" }
      ]
    },
    "type": {
      "name": "support.type.wgsl",
      "match": "\\b(?:bool|i32|u32|f32|f16|vec[234][iufh]?|mat[234]x[234][fh]?|array|atomic|ptr|sampler|sampler_comparison|texture_(?:1d|2d|2d_array|3d|cube|cube_array|multisampled_2d|external|storage_(?:1d|2d|2d_array|3d)|depth_(?:2d|2d_array|cube|cube_array|multisampled_2d)))\\b"
    },
    "call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.wgsl" } }
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.arrow.wgsl", "match": "->" },
        { "name": "keyword.operator.logical.wgsl", "match": "&&|\\|\\||!(?!=)" },
        { "name": "keyword.operator.comparison.wgsl", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.assignment.compound.wgsl", "match": "(?:<<|>>|[-+*/%&|^])=" },
        { "name": "keyword.operator.bitwise.wgsl", "match": "<<|>>|[&|^~]" },
        { "name": "keyword.operator.increment.wgsl", "match": "\\+\\+|--" },
        { "name": "keyword.operator.arithmetic.wgsl", "match": "[-+*/%]" },
        { "name": "keyword.operator.relational.wgsl", "match": "[<>]" },
        { "name": "keyword.operator.assignment.wgsl", "match": "=" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.wgsl", "match": ";" },
        { "name": "punctuation.separator.comma.wgsl", "match": "," },
        { "name": "punctuation.separator.colon.wgsl", "match": ":" },
        { "name": "punctuation.accessor.wgsl", "match": "\\." }
      ]
    }
  }
}
