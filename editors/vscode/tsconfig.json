{
  "compilerOptions": {
    "module": "preserve",
    "target": "es2023",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "types": ["node", "mocha"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "*.config.ts"]
}
