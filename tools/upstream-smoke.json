          "name": "initialise the arrays Reset leaves uninitialised",
          "argv": [
            "{python}",
            "-c",
            "import pathlib\nfor f in pathlib.Path('src').glob('reflect_*.jai'):\n    f.write_text(f.read_text().replace('Reset( d, count, initialized = false );', 'Reset( d, count );').replace('Reset( d, count, false );', 'Reset( d, count );'))"
