    {
      "id": "chess-engine",
      "project": "danieltan1517--chess-jai",
      "steps": [
        {
          "name": "build.jai - ai release",
          "kind": "jaic",
          "argv": [
            "build",
            "build.jai",
            "-",
            "ai",
            "release"
          ],
          "timeout": 900,
          "outputs": [
            "ceij"
          ]
        },
        {
          "name": "UCI handshake and perft 4",
          "argv": [
            "./ceij"
          ],
          "stdin": "uci\nisready\nposition startpos\ngo perft 4\nquit\n",
          "timeout": 60,
          "contains": [
            "uciok",
            "readyok",
            "Total 197281 nodes"
          ]
        },
        {
          "name": "search to depth 6",
          "argv": [
            "./ceij"
          ],
          "stdin": "uci\nisready\nposition startpos moves e2e4\ngo depth 6\nquit\n",
          "timeout": 120,
          "contains": [
            "info depth 6",
            "bestmove "
          ]
        },
        {
          "name": "perft_all",
          "argv": [
            "./ceij"
          ],
          "stdin": "perft_all\nquit\n",
          "timeout": 300,
          "contains": [
            "perft successful at the depth of: 5, 3605103 nodes",
            "All perft tests complete!"
          ],
          "not_contains": [
            "failed"
          ]
        }
      ]
    },
