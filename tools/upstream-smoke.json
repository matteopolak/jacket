      "only": ["macos-x64", "linux-x64", "windows-x64"],
      "only_reason": "build.jai calls Machine_X64's get_cpu_info() unconditionally in the build program, which executes the x86 CPUID instruction; the build cannot run on an ARM host",
      "steps": [
        {
          "name": "build.jai - ai release",
          "kind": "jaic",
          "argv": [
            "build.jai",
            "-",
            "ai",
            "release"
          ],
          "timeout": 900,
          "outputs": [
            "ceij"
          ]
        },
        {
          "name": "UCI handshake and perft 4",
          "argv": [
            "./ceij"
          ],
          "stdin": "uci\nisready\nposition startpos\ngo perft 4\nquit\n",
          "timeout": 60,
          "contains": [
            "uciok",
            "readyok",
            "Total 197281 nodes"
          ]
        },
        {
          "name": "search to depth 6",
          "argv": [
            "./ceij"
          ],
          "stdin": "uci\nisready\nposition startpos moves e2e4\ngo depth 6\nquit\n",
          "timeout": 120,
          "contains": [
            "info depth 6",
            "bestmove "
          ]
        },
        {
          "name": "perft_all",
          "argv": [
            "./ceij"
          ],
          "stdin": "perft_all\nquit\n",
          "timeout": 300,
          "contains": [
