      "id": "jai-tracy",
      "project": "rluba--jai-tracy",
      "link": [
        "_modules",
        "wolfpld--tracy"
      ],
      "only": [
        "macos-arm64",
        "macos-x64",
        "linux-x64",
        "linux-arm64"
      ],
      "only_reason": "libtracy is only built for macOS and Linux here",
      "steps": [
        {
          "name": "compile libtracy from the pinned Tracy client",
          "argv": [
            "{python}",
            "-c",
            "import subprocess, sys, pathlib\nd = 'macos' if sys.platform == 'darwin' else 'linux'\npathlib.Path(d).mkdir(exist_ok=True)\nsubprocess.run(['clang++', '-O2', '-DTRACY_ENABLE', '-std=c++11', '-Wno-deprecated-declarations', '-c', '-o', d + '/TracyClient.o', 'tracy/public/TracyClient.cpp'], check=True)\nsubprocess.run(['ar', '-rc', d + '/libtracy.a', d + '/TracyClient.o'], check=True)\n"
          ]
        },
        {
          "name": "tests/test.jai -plug tracy",
          "kind": "jaic",
          "argv": [
            "build",
            "tests/test.jai",
            "-I",
            "../_modules",
            "-plug",
            "tracy",
            "-min_size",
            "1",
            "-o",
            "tracy_test"
          ],
          "timeout": 600
        },
        {
          "argv": [
            "./tracy_test"
          ],
          "timeout": 120
        }
