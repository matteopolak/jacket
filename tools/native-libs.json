        "profiles/mojoshader_profile_metal.c", "profiles/mojoshader_profile_spirv.c"
      ]
    },
    "pl_mpeg": {"source": "pl_mpeg", "code": "#include <stdio.h>\n#include <stdlib.h>\n#define PL_MPEG_IMPLEMENTATION\n#include \"pl_mpeg.h\"\n"},
