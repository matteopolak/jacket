# Generated by tools/render_packages.py from packaging/homebrew/jacket.rb.tmpl in
# https://github.com/matteopolak/jacket for release v@VERSION@. Do not edit by hand.
class Jacket < Formula
  desc "Independent toolchain for the Jai language: compiler, LSP, linter and formatter"
  homepage "https://github.com/matteopolak/jacket"
  # Plus the jaic Runtime Library Exception (LICENSE-EXCEPTION), which has no SPDX identifier.
  license "AGPL-3.0-or-later"

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    on_arm do
      url "@BASE_URL@/jacket-macos-arm64.tar.gz"
      sha256 "@SHA256_MACOS_ARM64@"
    end
    on_intel do
      url "@BASE_URL@/jacket-macos-x64.tar.gz"
      sha256 "@SHA256_MACOS_INTEL@"
    end
  end

  on_linux do
    on_arm do
      url "@BASE_URL@/jacket-linux-arm64.tar.gz"
      sha256 "@SHA256_LINUX_ARM@"
    end
    on_intel do
      url "@BASE_URL@/jacket-linux-x64.tar.gz"
      sha256 "@SHA256_LINUX_X64@"
    end
  end

  def install
    # jaic, jailint and jailsp find stdlib/ (including its prelude) next to the real file
    # behind the bin/ symlinks, and native libraries (wgpu-native, stb_*, rpmalloc) in
    # ../native-libs.
    libexec.install "jaic", "jailsp", "jailint", "jaifmt", "stdlib"
    libexec.install "native-libs"
    bin.install_symlink libexec/"jaic", libexec/"jailsp", libexec/"jailint", libexec/"jaifmt"
    doc.install "README.md", "CHANGELOG.md"
  end

  test do
    (testpath/"hello.jai").write <<~JAI
      #import "Basic";

      main :: () {
          print("Hello from Homebrew!\\n");
      }
    JAI
    assert_equal "Hello from Homebrew!\n", shell_output("#{bin}/jaic hello.jai -interp")
    assert_equal "main :: () {\n    x := 1;\n}\n", pipe_output("#{bin}/jaifmt --stdin", "main::(){x:=1;}")
    system bin/"jailint", "hello.jai"
  end
end
