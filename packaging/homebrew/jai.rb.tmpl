# Generated by tools/render_packages.py from packaging/homebrew/jai.rb.tmpl in
# https://github.com/matteopolak/jai for release v@VERSION@. Do not edit by hand.
class Jai < Formula
  desc "Independent toolchain for the Jai language: compiler, LSP, linter and formatter"
  homepage "https://github.com/matteopolak/jai"
  # Plus the jaic Runtime Library Exception (LICENSE-EXCEPTION), which has no SPDX identifier.
  license "AGPL-3.0-or-later"

  livecheck do
    url :stable
    strategy :github_latest
  end

  # Releases ship macOS arm64 and Linux x86-64 builds only (LLVM publishes no Intel macOS build
  # of LLVM 23). The other platforms get the URL of the nearest build so the formula still loads
  # there, and `depends_on arch:` refuses the install with a clear message.
  on_macos do
    depends_on arch: :arm64

    on_arm do
      url "@BASE_URL@/@ARCHIVE_PREFIX@-macos-arm64.tar.gz"
      sha256 "@SHA256_MACOS_ARM64@"
    end
    on_intel do
      url "@BASE_URL@/@ARCHIVE_PREFIX@-macos-arm64.tar.gz"
      sha256 "@SHA256_MACOS_ARM64@"
    end
  end

  on_linux do
    depends_on arch: :x86_64

    on_arm do
      url "@BASE_URL@/@ARCHIVE_PREFIX@-linux-x64.tar.gz"
      sha256 "@SHA256_LINUX_X64@"
    end
    on_intel do
      url "@BASE_URL@/@ARCHIVE_PREFIX@-linux-x64.tar.gz"
      sha256 "@SHA256_LINUX_X64@"
    end
  end

  def install
    # jaic, jailint and jailsp find stdlib/ (including its bootstrap entry) next to the real file
    # behind the bin/ symlinks, and native libraries (wgpu-native) in ../artifacts/native-libs.
    libexec.install "jaic", "jailsp", "jailint", "jaifmt", "stdlib", "artifacts"
    bin.install_symlink libexec/"jaic", libexec/"jailsp", libexec/"jailint", libexec/"jaifmt"
    doc.install "README.md", "CHANGELOG.md"
  end

  test do
    (testpath/"hello.jai").write <<~JAI
      #import "Basic";

      main :: () {
          print("Hello from Homebrew!\\n");
      }
    JAI
    assert_equal "Hello from Homebrew!\n", shell_output("#{bin}/jaic run hello.jai")
    assert_equal "main :: () {\n    x := 1;\n}\n", pipe_output("#{bin}/jaifmt --stdin", "main::(){x:=1;}")
    system bin/"jailint", "hello.jai"
  end
end
