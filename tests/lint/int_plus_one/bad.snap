---
source: crates/jailint/tests/rules.rs
---
warning[int_plus_one]: `x >= y + 1` is a strict comparison written with `1`
  --> tests/lint/int_plus_one/bad.jai:8:8
   |
 8 |     if x >= y + 1 print("a\n");
   |        ^^^^^^^^^^
   |
help: write `x > y`
   |
 8 ~     if x > y print("a\n");
   |
   = note: `int_plus_one` is `warn` by default

warning[int_plus_one]: `x - 1 >= y` is a strict comparison written with `1`
  --> tests/lint/int_plus_one/bad.jai:9:8
   |
 9 |     if x - 1 >= y print("b\n");
   |        ^^^^^^^^^^
   |
help: write `x > y`
   |
 9 ~     if x > y print("b\n");
   |
   = note: `int_plus_one` is `warn` by default

warning[int_plus_one]: `y + 1 <= x` is a strict comparison written with `1`
  --> tests/lint/int_plus_one/bad.jai:10:8
   |
10 |     if y + 1 <= x print("c\n");
   |        ^^^^^^^^^^
   |
help: write `y < x`
   |
10 ~     if y < x print("c\n");
   |
   = note: `int_plus_one` is `warn` by default

warning[int_plus_one]: `y <= x - 1` is a strict comparison written with `1`
  --> tests/lint/int_plus_one/bad.jai:11:8
   |
11 |     if y <= x - 1 print("d\n");
   |        ^^^^^^^^^^
   |
help: write `y < x`
   |
11 ~     if y < x print("d\n");
   |
   = note: `int_plus_one` is `warn` by default

warning[int_plus_one]: `n >= y + 1` is a strict comparison written with `1`
  --> tests/lint/int_plus_one/bad.jai:12:8
   |
12 |     if n >= y + 1 print("e\n");
   |        ^^^^^^^^^^
   |
help: write `n > y`
   |
12 ~     if n > y print("e\n");
   |
   = note: `int_plus_one` is `warn` by default

warning[int_plus_one]: `(x + y) - 1 >= n` is a strict comparison written with `1`
  --> tests/lint/int_plus_one/bad.jai:13:8
   |
13 |     if (x + y) - 1 >= n print("f\n");
   |        ^^^^^^^^^^^^^^^^
   |
help: write `(x + y) > n`
   |
13 ~     if (x + y) > n print("f\n");
   |
   = note: `int_plus_one` is `warn` by default

warning[int_plus_one]: `x >= (y + 1)` is a strict comparison written with `1`
  --> tests/lint/int_plus_one/bad.jai:15:12
   |
15 |     ok := (x >= (y + 1));
   |            ^^^^^^^^^^^^
   |
help: write `x > y`
   |
15 ~     ok := (x > y);
   |
   = note: `int_plus_one` is `warn` by default
