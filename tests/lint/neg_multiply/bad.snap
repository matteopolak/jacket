warning[neg_multiply]: `x * -1` is a negation
  --> tests/lint/neg_multiply/bad.jai:8:10
   |
 8 |     a := x * -1;
   |          ^^^^^^
   |
help: write `-x`
   |
 8 ~     a := -x;
   |
   = note: `neg_multiply` is `warn` by default

warning[neg_multiply]: `-1 * y` is a negation
  --> tests/lint/neg_multiply/bad.jai:9:10
   |
 9 |     b := -1 * y;
   |          ^^^^^^
   |
help: write `-y`
   |
 9 ~     b := -y;
   |
   = note: `neg_multiply` is `warn` by default

warning[neg_multiply]: `f * -1.0` is a negation
  --> tests/lint/neg_multiply/bad.jai:10:10
   |
10 |     c := f * -1.0;
   |          ^^^^^^^^
   |
help: write `-f`
   |
10 ~     c := -f;
   |
   = note: `neg_multiply` is `warn` by default

warning[neg_multiply]: `(x + y) * -1` is a negation
  --> tests/lint/neg_multiply/bad.jai:11:10
   |
11 |     d := (x + y) * -1;
   |          ^^^^^^^^^^^^
   |
help: write `-(x + y)`
   |
11 ~     d := -(x + y);
   |
   = note: `neg_multiply` is `warn` by default

warning[neg_multiply]: `2 * x * -1` is a negation
  --> tests/lint/neg_multiply/bad.jai:12:10
   |
12 |     e := 2 * x * -1;
   |          ^^^^^^^^^^
   |
help: write `-(2 * x)`
   |
12 ~     e := -(2 * x);
   |
   = note: `neg_multiply` is `warn` by default

warning[neg_multiply]: `x * -1` is a negation
  --> tests/lint/neg_multiply/bad.jai:13:10
   |
13 |     g := x * -1 + y;
   |          ^^^^^^
   |
help: write `-x`
   |
