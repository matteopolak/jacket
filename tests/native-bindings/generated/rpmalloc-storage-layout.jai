public_storage_separation_checks :: () {
    heap: Heap;
    span: Span;

    assert(size_of(Heap) == storage_size(6));
    assert(cast(u64) *heap.span_cache - cast(u64) *heap != storage_offset(47));
    assert(size_of(Heap) == storage_size(6));
    assert(cast(u64) *heap.span_free_deferred - cast(u64) *heap != storage_offset(48));
    assert(size_of(Span) != storage_size(5));
    assert(cast(u64) *span.free_list_deferred - cast(u64) *span != storage_offset(33));
    assert(type_info(Heap).name == "Heap");
    assert(type_info(Span).name == "Span");
}
