#module_parameters(DEFINE_SYSTEM_ENTRY_POINT: bool, DEFINE_INITIALIZATION: bool, ENABLE_BACKTRACE_ON_CRASH: bool);

OS_IS_UNIX :: (Basic.STRING_BUILDER_BUFFER_SIZE > 0) && (OS == .MACOS || OS == .LINUX || OS == .PS5 || OS == .IOS || OS == .ANDROID);

using,except(OS_IS_UNIX) Canonical :: #import,file "@CANONICAL_RUNTIME_ENTRY@"(DEFINE_SYSTEM_ENTRY_POINT = DEFINE_SYSTEM_ENTRY_POINT, DEFINE_INITIALIZATION = DEFINE_INITIALIZATION, ENABLE_BACKTRACE_ON_CRASH = ENABLE_BACKTRACE_ON_CRASH);

#scope_file
Basic :: #import "Basic";
