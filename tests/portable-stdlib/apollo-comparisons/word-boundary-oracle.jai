using,only(.["<", "<=", ">", ">=", "==", "!"]) B;

verify :: (a: B.S128, b: B.S128, comparison: s32, az: bool, bz: bool) {
    B.assert((a < b) == (comparison < 0));
    B.assert((a <= b) == (comparison <= 0));
    B.assert((a > b) == (comparison > 0));
    B.assert((a >= b) == (comparison >= 0));
    B.assert((a == b) == (comparison == 0));
    B.assert((a != b) == (comparison != 0));
    B.assert((!a) == az && (!b) == bz);
}

