// Basic's string_to_float64 / string_to_float: every decimal text converts to the nearest
// float64 (float32), bit for bit. The expected bits come from a correctly rounding reference
// conversion; the cases cover short decimals such as 0.3 (where summing digit * 0.1^k is off by
// one ulp), 17-digit round-trip strings, more than 19 significant digits, subnormals, the
// largest finite value and overflow to infinity.
#import "Basic";

Case64 :: struct {
    text: string;
    bits: u64;
}
Case32 :: struct {
    text: string;
    bits: u32;
}

main :: () {
    failures := 0;
    for CASES_64 {
        value, ok, rest := string_to_float64(it.text);
        bits := (cast(*u64) *value).*;
        if !ok || rest != "" || bits != it.bits {
            print("string_to_float64(\"%\") = % (bits %), expected bits %\n", it.text, value, formatInt(bits, base = 16), formatInt(it.bits, base = 16));
            failures += 1;
        }
    }
    for CASES_32 {
        value, ok, rest := string_to_float(it.text);
        bits := (cast(*u32) *value).*;
        if !ok || rest != "" || bits != it.bits {
            print("string_to_float(\"%\") = % (bits %), expected bits %\n", it.text, value, formatInt(bits, base = 16), formatInt(it.bits, base = 16));
            failures += 1;
        }
    }
    assert(failures == 0, "% conversions were not correctly rounded", failures);

    // The remainder and the failure cases are unchanged by the rounding.
    value, ok, rest := string_to_float64("  -1.25e+2xyz");
    assert(ok && value == -125 && rest == "xyz");
    value, ok, rest = string_to_float64("2.5e");
    assert(ok && value == 2.5 && rest == "e");
    value, ok, rest = string_to_float64(".5");
    assert(ok && value == 0.5 && rest == "");
    value, ok, rest = string_to_float64("5.");
    assert(ok && value == 5 && rest == "");
    _, ok, rest = string_to_float64("-.e5");
    assert(!ok && rest == "-.e5");
    _, ok, rest = string_to_float64("");
    assert(!ok && rest == "");
    _, ok = string_to_float64("1e5000");
    assert(!ok, "an exponent past 4000 is refused");
    huge: float64;
    huge, ok = string_to_float64("1e400");
    assert(ok && huge == huge + 1 && huge > 0, "overflow gives infinity: %", huge);
    tiny: float64;
    tiny, ok = string_to_float64("-1e-400");
    assert(ok && tiny == 0 && ((cast(*u64) *tiny).* >> 63) == 1, "underflow keeps the sign");
    long_text: String_Builder;
    append(*long_text, "0.");
    for 1..400 append(*long_text, "3");
    long_value: float64;
    long_value, ok = string_to_float64(builder_to_string(*long_text));
    assert(ok && long_value == 1.0 / 3.0, "400 digits of 1/3: %", long_value);
    print("ok\n");
}

