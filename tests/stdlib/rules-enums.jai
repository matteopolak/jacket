// Checks the claims of docs/language/enums.md, one group per rule.
// rules: enum.1 enum.2 enum.3 enum.4 enum.5 enum.6 enum.7 enum.8 enum.9 enum.10 enum.11 enum.12 enum.13 enum.14 enum.15 enum.16
#import "Basic";

Shade :: enum {
    DARK;
    MID :: 10;
    LIGHT;
    BRIGHT;
}
Tiny :: enum u8 {
    P;
    Q;
    R;
}
Medium :: enum s16 {
    P;
}
Perm :: enum_flags u32 {
    READ;
    WRITE;
    EXEC;
}
Exact :: enum u16 #specified {
    ONE :: 1;
    TWO :: 2;
}
Whole :: enum #complete {
    YES;
    NO;
}

Generated :: enum {
    #insert "GEN_A; GEN_B;";
    LAST;
}

Sc :: enum s32 {
    FIRST;
    LAST;
    IPV6 :: LAST + cast(Sc) 50;
}
Rank :: enum {
    FIRST;
    SECOND;
    THIRD;
}

Ticket :: struct(order: Rank = .FIRST) {
    seats: int;
}

main :: () {
    // enum.1: members count up from zero.
    assert(cast(int) Shade.DARK == 0, "first member is 0");
    assert(cast(int) Tiny.Q == 1 && cast(int) Tiny.R == 2, "members count up");

    // enum.2: an explicit value sets the member and numbering continues after it.
    assert(cast(int) Shade.MID == 10, "explicit value");
    assert(cast(int) Shade.LIGHT == 11 && cast(int) Shade.BRIGHT == 12, "numbering continues");

    // enum.3: the default backing type is 8 bytes.
    assert(size_of(Shade) == 8, "default enum is 8 bytes");

    // enum.4: an explicit base type sets the size.
    assert(size_of(Tiny) == 1, "enum u8 is 1 byte");
    assert(size_of(Medium) == 2, "enum s16 is 2 bytes");
    assert(size_of(Perm) == 4, "enum_flags u32 is 4 bytes");

    // enum.5: a member prints by name; a flags combination prints names joined by " | ".
    assert(tprint("%", Shade.MID) == "MID", "member prints its name");
    assert(tprint("%", cast(int) Shade.MID) == "10", "cast(int) prints the value");
    assert(tprint("%", Perm.READ | Perm.EXEC) == "READ | EXEC", "flags print joined");

    // enum.6: a value without a name prints as a number.
    assert(tprint("%", cast(Shade) 99) == "99", "unnamed value prints the number");

    // enum.7: enum_flags members are powers of two.
    assert(cast(u32) Perm.READ == 1 && cast(u32) Perm.WRITE == 2 && cast(u32) Perm.EXEC == 4, "powers of two");

    // enum.8: flags combine with | and &, and `fl & .WRITE` works as an `if` condition.
    fl := Perm.READ | Perm.WRITE;
    assert(cast(u32) fl == 3, "| combines");
    hit := false;
    if fl & .WRITE hit = true;
    assert(hit, "fl & .WRITE is true");
    miss := false;
    if fl & .EXEC miss = true;
    assert(!miss, "fl & .EXEC is false");

    // enum.9: a loose enum converts implicitly to and from integers and the enum.
    l: Shade.loose = 10;
    i: int = l;
    assert(i == 10, "loose to int");
    s: Shade = l;
    assert(s == .MID, "loose to enum");
    back: Shade.loose = Shade.LIGHT;
    assert(cast(int) back == 11, "enum to loose");

    // enum.10: type_info gives the names and values.
    info := type_info(Shade);
    assert(info.names.count == 4 && info.values.count == 4, "four names and values");
    assert(info.names[1] == "MID" && info.values[1] == 10, "names and values line up");
    assert(info.names[3] == "BRIGHT" && info.values[3] == 12, "last member");

    // enum.11: enum_type_flags: FLAGS 0x1, COMPLETE 0x2, SPECIFIED 0x4.
    assert(cast(u16) type_info(Shade).enum_type_flags == 0, "plain enum has no flags");
    assert(cast(u16) type_info(Perm).enum_type_flags == 0x1, "enum_flags sets FLAGS");
    assert(cast(u16) type_info(Whole).enum_type_flags == 0x2, "#complete sets COMPLETE");
    assert(cast(u16) type_info(Exact).enum_type_flags == 0x4, "#specified sets SPECIFIED");
    assert(type_info(Perm).enum_type_flags & .FLAGS != 0, "FLAGS by name");

    // enum.12: enum_highest_value.
    assert(enum_highest_value(Shade) == 12, "highest value");

    // enum.13: members generated by #insert in the enum body.
    assert(cast(int) Generated.GEN_A == 0 && cast(int) Generated.GEN_B == 1, "inserted members");
    assert(cast(int) Generated.LAST == 2, "members after the insert continue");

    // enum.14: an inferred member on the left of a comparison takes the right side's type.
    r := Rank.SECOND;
    assert(.SECOND == r, "inferred member on the left");
    assert(!(.FIRST == r), "inferred member compares by value");

    // enum.15: a polymorphic struct's enum value parameter types .MEMBER arguments and defaults.
    t: Ticket(.THIRD);
    assert(t.order == .THIRD, "explicit argument");
    d: Ticket();
    assert(d.order == .FIRST, "default argument");


    // enum.16: a member's value may name the enum itself.
    assert(cast(s32) Sc.IPV6 == 51, "member names its own enum");

    print("ok\n");
}
