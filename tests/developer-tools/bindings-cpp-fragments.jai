#import "Basic";
#import "File";
B :: #import "Bindings_Generator";

main :: () {
    args := get_command_line_arguments();

    defer array_free(args);
    assert(args.count == 2);
    source: String_Builder;

    defer free_buffers(*source);
    append(*source, "#include <cassert>\n#include <cstdint>\n#include <cstring>\n#include <limits>\nnamespace Scope { enum class Native_Mode : int { VALUE=7 }; }\nint main() {\n");
    literal: B.Literal;
    literal.literal_kind = .INTEGER;
    literal.int_value = -9223372036854775807 - 1;
    append(*source, "auto minimum = ");
    assert(B.append_cpp_literal(*source, *literal, print_integers_as_hex = true));
    append(*source, "; assert(minimum == std::numeric_limits<std::int64_t>::min());\n");
    literal.literal_kind = .UNSIGNED_INTEGER;
    literal.uint_value = 0xffffffffffffffff;
    append(*source, "auto maximum = ");
    assert(B.append_cpp_literal(*source, *literal));
    append(*source, "; assert(maximum == std::numeric_limits<std::uint64_t>::max());\n");
    literal.literal_kind = .FLOAT;
    literal.float_value = 0.10000000000000002;
    append(*source, "double real = ");
    assert(B.append_cpp_literal(*source, *literal));
    append(*source, "; std::uint64_t bits; std::memcpy(&bits,&real,8); assert(bits == 0x3fb999999999999bULL);\n");
    bytes := u8.[0, 1, 10, 34, 92, 255, 65, 55];

    literal.literal_kind = .STRING;
    literal.string_value = .{ bytes.count, bytes.data };
    append(*source, "const char raw[] = ");
    assert(B.append_cpp_literal(*source, *literal));
    append(*source, "; const unsigned char expected[] = {0,1,10,34,92,255,65,55}; static_assert(sizeof(raw)==9); assert(std::memcmp(raw,expected,8)==0);\n");
    integer := B.get_int_type(4, true);

    defer free(integer);
    pointer: B.CType;
    pointer.pointer_to = integer;
    null_literal := B.create_null_literal();

    defer free(null_literal);
    assert(null_literal.kind == .LITERAL && null_literal.literal_kind == .NULL);
    append(*source, "int* pointer = ");
    assert(B.append_cpp_literal(*source, null_literal, target_type = *pointer));
    append(*source, "; assert(pointer == nullptr);\n");
    scope: B.Namespace;
    scope.kind = .NAMESPACE;
    scope.name = "Scope";
    scope.output_name = "Jai_Scope";
    enumeration: B.Enum;
    enumeration.kind = .ENUM;
    enumeration.name = "Native_Mode";
    enumeration.output_name = "Jai_Mode";
    enumeration.parent = cast(*B.Declaration) *scope;
    enumeration.type = integer;
    target: B.CType;
    target.type_of_enum = *enumeration;
    literal.literal_kind = .INTEGER;
    literal.int_value = 7;
    append(*source, "auto mode = ");
    assert(B.append_cpp_literal(*source, *literal, target_type = *target));
    append(*source, "; assert(mode == Scope::Native_Mode::VALUE);\n");
    cv_integer := integer.*;
    cv_integer.flags |= .CONST | .VOLATILE;
    append(*source, "auto cv_value = ");
    assert(B.append_cpp_literal(*source, *literal, target_type = *cv_integer));
    append(*source, "; assert(cv_value == 7);\n");
    enum_value: B.Declaration;
    enum_value.name = "VALUE";
    enum_value.parent = cast(*B.Declaration) *enumeration;
    literal.literal_kind = .ENUM;
    literal.enum_type = *enumeration;
    literal.enum_value = *enum_value;
    append(*source, "auto named_mode = ");
    assert(B.append_cpp_literal(*source, *literal));
    append(*source, "; assert(named_mode == mode);\n");
    function: B.Function;
    function.kind = .FUNCTION;
    function.name = "main";
    local: B.Declaration;
    local.kind = .DECLARATION;
    local.name = "local_value";
    local.parent = cast(*B.Declaration) *function;
    local.type = integer;
    literal.literal_kind = .IDENTIFIER;
    literal.identifier = *local;
    append(*source, "int local_value=9; auto copied = ");
    assert(B.append_cpp_literal(*source, *literal));
    append(*source, "; assert(copied == local_value);\n");
    seven, five, two: B.Literal;
    seven.literal_kind = .INTEGER;
    seven.int_value = 7;
    five.literal_kind = .INTEGER;
    five.int_value = 5;
    two.literal_kind = .INTEGER;
    two.int_value = 2;
    inner: B.Binary_Operator;
    inner.kind = .BINARY_OPERATOR;
    inner.op = "-";
    inner.lhs = cast(*B.Expression) *five;
    inner.rhs = cast(*B.Expression) *two;
    outer := inner;
    outer.lhs = cast(*B.Expression) *seven;
    outer.rhs = cast(*B.Expression) *inner;
    append(*source, "auto difference = ");
    assert(B.append_cpp_expression(*source, cast(*B.Expression) *outer));
    append(*source, "; assert(difference == 4);\n");
    array_type: B.CType;
    array_type.array_element_type = integer;
    array_type.array_element_count = 3;
    reference: B.Type_Reference;
    reference.kind = .TYPE_REFERENCE;
    reference.type = *array_type;
    size: B.Unary_Operator;
    size.kind = .UNARY_OPERATOR;
    size.op = "sizeof";
    size.child = cast(*B.Expression) *reference;
    append(*source, "auto array_size = ");
    assert(B.append_cpp_expression(*source, cast(*B.Expression) *size));
    append(*source, "; assert(array_size == 3*sizeof(int));\n");
    before := builder_to_string(*source, do_reset = false);

    defer free(before);
    literal.literal_kind = .MACRO;
    assert(!B.append_cpp_literal(*source, *literal));
    nonfinite_bits: u64 = 0x7ff0000000000000;

    literal.literal_kind = .FLOAT;
    literal.float_value = (cast(*float64) *nonfinite_bits).*;
    assert(!B.append_cpp_literal(*source, *literal));
    outer.op = "invalid_operator";
    assert(!B.append_cpp_expression(*source, cast(*B.Expression) *outer));
    after := builder_to_string(*source, do_reset = false);

    defer free(after);
    assert(before == after);
    append(*source, "}\n");
    assert(write_entire_file(tprint("%/developer-tools-cpp-fragments.cpp", args[1]), *source, false));
    print("ok\n");
}
