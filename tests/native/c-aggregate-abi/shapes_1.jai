cb_dbl_u8x3 :: (d1: float64, d2: float64, d3: float64, d4: float64, d5: float64, d6: float64, d7: float64, d8: float64, r: u8x3, seed: s32) -> s32 #c_call {
    return ifx d1 == 1 && d2 == 2 && d3 == 3 && d4 == 4 && d5 == 5 && d6 == 6 && d7 == 7 && d8 == 8 && is_u8x3(r, seed) then 1 else 0;
}

main :: () {
    if !is_f64x2(ret_f64x2(7), 7) fail("f64x2: foreign return");
    if !apply_check_f64x2(make_f64x2, 7) fail("f64x2: callback return read by C");
    if !is_f64x2(call_f64x2(make_f64x2, 9), 9) fail("f64x2: callback return round trip");
    if !check_f64x2(make_f64x2(7), 7) fail("f64x2: argument made in Jai");
    if !pass_f64x2(cb_pass_f64x2, 7) fail("f64x2: callback argument");
    if !passtail_f64x2(cb_tail_f64x2, 7) fail("f64x2: callback argument after five integers");
    if !passfar_f64x2(cb_far_f64x2, 7) fail("f64x2: callback argument after seven integers");
    if !passd_f64x2(cb_dbl_f64x2, 7) fail("f64x2: callback argument after eight doubles");
    if !is_f64x3(ret_f64x3(7), 7) fail("f64x3: foreign return");
    if !apply_check_f64x3(make_f64x3, 7) fail("f64x3: callback return read by C");
    if !is_f64x3(call_f64x3(make_f64x3, 9), 9) fail("f64x3: callback return round trip");
    if !check_f64x3(make_f64x3(7), 7) fail("f64x3: argument made in Jai");
    if !pass_f64x3(cb_pass_f64x3, 7) fail("f64x3: callback argument");
    if !passtail_f64x3(cb_tail_f64x3, 7) fail("f64x3: callback argument after five integers");
    if !passfar_f64x3(cb_far_f64x3, 7) fail("f64x3: callback argument after seven integers");
    if !passd_f64x3(cb_dbl_f64x3, 7) fail("f64x3: callback argument after eight doubles");
    if !is_f64x4(ret_f64x4(7), 7) fail("f64x4: foreign return");
    if !apply_check_f64x4(make_f64x4, 7) fail("f64x4: callback return read by C");
    if !is_f64x4(call_f64x4(make_f64x4, 9), 9) fail("f64x4: callback return round trip");
    if !check_f64x4(make_f64x4(7), 7) fail("f64x4: argument made in Jai");
    if !pass_f64x4(cb_pass_f64x4, 7) fail("f64x4: callback argument");
    if !passtail_f64x4(cb_tail_f64x4, 7) fail("f64x4: callback argument after five integers");
    if !passfar_f64x4(cb_far_f64x4, 7) fail("f64x4: callback argument after seven integers");
    if !passd_f64x4(cb_dbl_f64x4, 7) fail("f64x4: callback argument after eight doubles");
    if !is_i64f64(ret_i64f64(7), 7) fail("i64f64: foreign return");
    if !apply_check_i64f64(make_i64f64, 7) fail("i64f64: callback return read by C");
    if !is_i64f64(call_i64f64(make_i64f64, 9), 9) fail("i64f64: callback return round trip");
    if !check_i64f64(make_i64f64(7), 7) fail("i64f64: argument made in Jai");
    if !pass_i64f64(cb_pass_i64f64, 7) fail("i64f64: callback argument");
    if !passtail_i64f64(cb_tail_i64f64, 7) fail("i64f64: callback argument after five integers");
    if !passfar_i64f64(cb_far_i64f64, 7) fail("i64f64: callback argument after seven integers");
    if !passd_i64f64(cb_dbl_i64f64, 7) fail("i64f64: callback argument after eight doubles");
    if !is_f64i64(ret_f64i64(7), 7) fail("f64i64: foreign return");
    if !apply_check_f64i64(make_f64i64, 7) fail("f64i64: callback return read by C");
    if !is_f64i64(call_f64i64(make_f64i64, 9), 9) fail("f64i64: callback return round trip");
    if !check_f64i64(make_f64i64(7), 7) fail("f64i64: argument made in Jai");
    if !pass_f64i64(cb_pass_f64i64, 7) fail("f64i64: callback argument");
    if !passtail_f64i64(cb_tail_f64i64, 7) fail("f64i64: callback argument after five integers");
    if !passfar_f64i64(cb_far_f64i64, 7) fail("f64i64: callback argument after seven integers");
    if !passd_f64i64(cb_dbl_f64i64, 7) fail("f64i64: callback argument after eight doubles");
    if !is_i32f32(ret_i32f32(7), 7) fail("i32f32: foreign return");
    if !apply_check_i32f32(make_i32f32, 7) fail("i32f32: callback return read by C");
    if !is_i32f32(call_i32f32(make_i32f32, 9), 9) fail("i32f32: callback return round trip");
    if !check_i32f32(make_i32f32(7), 7) fail("i32f32: argument made in Jai");
    if !pass_i32f32(cb_pass_i32f32, 7) fail("i32f32: callback argument");
    if !passtail_i32f32(cb_tail_i32f32, 7) fail("i32f32: callback argument after five integers");
    if !passfar_i32f32(cb_far_i32f32, 7) fail("i32f32: callback argument after seven integers");
    if !passd_i32f32(cb_dbl_i32f32, 7) fail("i32f32: callback argument after eight doubles");
    if !is_f32i32f64(ret_f32i32f64(7), 7) fail("f32i32f64: foreign return");
    if !apply_check_f32i32f64(make_f32i32f64, 7) fail("f32i32f64: callback return read by C");
    if !is_f32i32f64(call_f32i32f64(make_f32i32f64, 9), 9) fail("f32i32f64: callback return round trip");
    if !check_f32i32f64(make_f32i32f64(7), 7) fail("f32i32f64: argument made in Jai");
    if !pass_f32i32f64(cb_pass_f32i32f64, 7) fail("f32i32f64: callback argument");
    if !passtail_f32i32f64(cb_tail_f32i32f64, 7) fail("f32i32f64: callback argument after five integers");
    if !passfar_f32i32f64(cb_far_f32i32f64, 7) fail("f32i32f64: callback argument after seven integers");
    if !passd_f32i32f64(cb_dbl_f32i32f64, 7) fail("f32i32f64: callback argument after eight doubles");
    if !is_f32x2i64(ret_f32x2i64(7), 7) fail("f32x2i64: foreign return");
    if !apply_check_f32x2i64(make_f32x2i64, 7) fail("f32x2i64: callback return read by C");
    if !is_f32x2i64(call_f32x2i64(make_f32x2i64, 9), 9) fail("f32x2i64: callback return round trip");
    if !check_f32x2i64(make_f32x2i64(7), 7) fail("f32x2i64: argument made in Jai");
    if !pass_f32x2i64(cb_pass_f32x2i64, 7) fail("f32x2i64: callback argument");
    if !passtail_f32x2i64(cb_tail_f32x2i64, 7) fail("f32x2i64: callback argument after five integers");
    if !passfar_f32x2i64(cb_far_f32x2i64, 7) fail("f32x2i64: callback argument after seven integers");
    if !passd_f32x2i64(cb_dbl_f32x2i64, 7) fail("f32x2i64: callback argument after eight doubles");
    if !is_f64f32x2(ret_f64f32x2(7), 7) fail("f64f32x2: foreign return");
    if !apply_check_f64f32x2(make_f64f32x2, 7) fail("f64f32x2: callback return read by C");
    if !is_f64f32x2(call_f64f32x2(make_f64f32x2, 9), 9) fail("f64f32x2: callback return round trip");
    if !check_f64f32x2(make_f64f32x2(7), 7) fail("f64f32x2: argument made in Jai");
    if !pass_f64f32x2(cb_pass_f64f32x2, 7) fail("f64f32x2: callback argument");
    if !passtail_f64f32x2(cb_tail_f64f32x2, 7) fail("f64f32x2: callback argument after five integers");
    if !passfar_f64f32x2(cb_far_f64f32x2, 7) fail("f64f32x2: callback argument after seven integers");
    if !passd_f64f32x2(cb_dbl_f64f32x2, 7) fail("f64f32x2: callback argument after eight doubles");
    if !is_u8x3(ret_u8x3(7), 7) fail("u8x3: foreign return");
    if !apply_check_u8x3(make_u8x3, 7) fail("u8x3: callback return read by C");
    if !is_u8x3(call_u8x3(make_u8x3, 9), 9) fail("u8x3: callback return round trip");
    if !check_u8x3(make_u8x3(7), 7) fail("u8x3: argument made in Jai");
    if !pass_u8x3(cb_pass_u8x3, 7) fail("u8x3: callback argument");
    if !passtail_u8x3(cb_tail_u8x3, 7) fail("u8x3: callback argument after five integers");
    if !passfar_u8x3(cb_far_u8x3, 7) fail("u8x3: callback argument after seven integers");
    if !passd_u8x3(cb_dbl_u8x3, 7) fail("u8x3: callback argument after eight doubles");
    if failures == 0 print("ok\n");
}
