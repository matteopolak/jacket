ret_uf32x2i64 :: (seed: s32) -> uf32x2i64 #foreign shapes;
call_uf32x2i64 :: (cb: (seed: s32) -> uf32x2i64 #c_call, seed: s32) -> uf32x2i64 #foreign shapes;
apply_check_uf32x2i64 :: (cb: (seed: s32) -> uf32x2i64 #c_call, seed: s32) -> s32 #foreign shapes;
check_uf32x2i64 :: (r: uf32x2i64, seed: s32) -> s32 #foreign shapes;
pass_uf32x2i64 :: (cb: (r: uf32x2i64, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passtail_uf32x2i64 :: (cb: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, r: uf32x2i64, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passfar_uf32x2i64 :: (cb: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, a6: s64, a7: s64, r: uf32x2i64, d: float64, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passd_uf32x2i64 :: (cb: (d1: float64, d2: float64, d3: float64, d4: float64, d5: float64, d6: float64, d7: float64, d8: float64, r: uf32x2i64, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;

make_uf32x2i64 :: (seed: s32) -> uf32x2i64 #c_call {
    r: uf32x2i64;
    r.f0.f0 = cast(float32) (seed + 1.5);
    r.f0.f1 = cast(float32) (seed + 2.5);
    return r;
}

is_uf32x2i64 :: (r: uf32x2i64, seed: s32) -> bool #c_call {
    return r.f0.f0 == cast(float32) (seed + 1.5) && r.f0.f1 == cast(float32) (seed + 2.5);
}

cb_pass_uf32x2i64 :: (r: uf32x2i64, seed: s32) -> s32 #c_call {
    return ifx is_uf32x2i64(r, seed) then 1 else 0;
}

cb_tail_uf32x2i64 :: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, r: uf32x2i64, seed: s32) -> s32 #c_call {
    return ifx a1 == 1 && a2 == 2 && a3 == 3 && a4 == 4 && a5 == 5 && is_uf32x2i64(r, seed) then 1 else 0;
}

cb_far_uf32x2i64 :: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, a6: s64, a7: s64, r: uf32x2i64, d: float64, seed: s32) -> s32 #c_call {
    return ifx a1 == 1 && a2 == 2 && a3 == 3 && a4 == 4 && a5 == 5 && a6 == 6 && a7 == 7 && d == 0.5 && is_uf32x2i64(r, seed) then 1 else 0;
}

cb_dbl_uf32x2i64 :: (d1: float64, d2: float64, d3: float64, d4: float64, d5: float64, d6: float64, d7: float64, d8: float64, r: uf32x2i64, seed: s32) -> s32 #c_call {
    return ifx d1 == 1 && d2 == 2 && d3 == 3 && d4 == 4 && d5 == 5 && d6 == 6 && d7 == 7 && d8 == 8 && is_uf32x2i64(r, seed) then 1 else 0;
}

nmix_f0 :: struct {
    f0: s32;
    f1: float32;
}

nmix :: struct {
    f0: nmix_f0;
    f1: float64;
}

ret_nmix :: (seed: s32) -> nmix #foreign shapes;
call_nmix :: (cb: (seed: s32) -> nmix #c_call, seed: s32) -> nmix #foreign shapes;
apply_check_nmix :: (cb: (seed: s32) -> nmix #c_call, seed: s32) -> s32 #foreign shapes;
check_nmix :: (r: nmix, seed: s32) -> s32 #foreign shapes;
pass_nmix :: (cb: (r: nmix, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passtail_nmix :: (cb: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, r: nmix, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passfar_nmix :: (cb: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, a6: s64, a7: s64, r: nmix, d: float64, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passd_nmix :: (cb: (d1: float64, d2: float64, d3: float64, d4: float64, d5: float64, d6: float64, d7: float64, d8: float64, r: nmix, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;

make_nmix :: (seed: s32) -> nmix #c_call {
    r: nmix;
    r.f0.f0 = cast(s32) (seed + 1);
    r.f0.f1 = cast(float32) (seed + 2.5);
    r.f1 = cast(float64) (seed + 3.5);
    return r;
}

is_nmix :: (r: nmix, seed: s32) -> bool #c_call {
    return r.f0.f0 == cast(s32) (seed + 1) && r.f0.f1 == cast(float32) (seed + 2.5) && r.f1 == cast(float64) (seed + 3.5);
}

cb_pass_nmix :: (r: nmix, seed: s32) -> s32 #c_call {
    return ifx is_nmix(r, seed) then 1 else 0;
}

cb_tail_nmix :: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, r: nmix, seed: s32) -> s32 #c_call {
    return ifx a1 == 1 && a2 == 2 && a3 == 3 && a4 == 4 && a5 == 5 && is_nmix(r, seed) then 1 else 0;
}

cb_far_nmix :: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, a6: s64, a7: s64, r: nmix, d: float64, seed: s32) -> s32 #c_call {
    return ifx a1 == 1 && a2 == 2 && a3 == 3 && a4 == 4 && a5 == 5 && a6 == 6 && a7 == 7 && d == 0.5 && is_nmix(r, seed) then 1 else 0;
}

cb_dbl_nmix :: (d1: float64, d2: float64, d3: float64, d4: float64, d5: float64, d6: float64, d7: float64, d8: float64, r: nmix, seed: s32) -> s32 #c_call {
    return ifx d1 == 1 && d2 == 2 && d3 == 3 && d4 == 4 && d5 == 5 && d6 == 6 && d7 == 7 && d8 == 8 && is_nmix(r, seed) then 1 else 0;
}

nf32_f0 :: struct {
    f0: float32;
    f1: float32;
}

nf32_f1 :: struct {
    f0: float32;
    f1: float32;
}

nf32 :: struct {
    f0: nf32_f0;
    f1: nf32_f1;
}

ret_nf32 :: (seed: s32) -> nf32 #foreign shapes;
call_nf32 :: (cb: (seed: s32) -> nf32 #c_call, seed: s32) -> nf32 #foreign shapes;
apply_check_nf32 :: (cb: (seed: s32) -> nf32 #c_call, seed: s32) -> s32 #foreign shapes;
check_nf32 :: (r: nf32, seed: s32) -> s32 #foreign shapes;
pass_nf32 :: (cb: (r: nf32, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passtail_nf32 :: (cb: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, r: nf32, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passfar_nf32 :: (cb: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, a6: s64, a7: s64, r: nf32, d: float64, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passd_nf32 :: (cb: (d1: float64, d2: float64, d3: float64, d4: float64, d5: float64, d6: float64, d7: float64, d8: float64, r: nf32, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;

make_nf32 :: (seed: s32) -> nf32 #c_call {
    r: nf32;
    r.f0.f0 = cast(float32) (seed + 1.5);
    r.f0.f1 = cast(float32) (seed + 2.5);
    r.f1.f0 = cast(float32) (seed + 3.5);
    r.f1.f1 = cast(float32) (seed + 4.5);
    return r;
}

is_nf32 :: (r: nf32, seed: s32) -> bool #c_call {
    return r.f0.f0 == cast(float32) (seed + 1.5) && r.f0.f1 == cast(float32) (seed + 2.5) && r.f1.f0 == cast(float32) (seed + 3.5) && r.f1.f1 == cast(float32) (seed + 4.5);
}

cb_pass_nf32 :: (r: nf32, seed: s32) -> s32 #c_call {
    return ifx is_nf32(r, seed) then 1 else 0;
}

cb_tail_nf32 :: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, r: nf32, seed: s32) -> s32 #c_call {
    return ifx a1 == 1 && a2 == 2 && a3 == 3 && a4 == 4 && a5 == 5 && is_nf32(r, seed) then 1 else 0;
}

cb_far_nf32 :: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, a6: s64, a7: s64, r: nf32, d: float64, seed: s32) -> s32 #c_call {
    return ifx a1 == 1 && a2 == 2 && a3 == 3 && a4 == 4 && a5 == 5 && a6 == 6 && a7 == 7 && d == 0.5 && is_nf32(r, seed) then 1 else 0;
}

cb_dbl_nf32 :: (d1: float64, d2: float64, d3: float64, d4: float64, d5: float64, d6: float64, d7: float64, d8: float64, r: nf32, seed: s32) -> s32 #c_call {
    return ifx d1 == 1 && d2 == 2 && d3 == 3 && d4 == 4 && d5 == 5 && d6 == 6 && d7 == 7 && d8 == 8 && is_nf32(r, seed) then 1 else 0;
}

main :: () {
    if !is_ai8x9(ret_ai8x9(7), 7) fail("ai8x9: foreign return");
    if !apply_check_ai8x9(make_ai8x9, 7) fail("ai8x9: callback return read by C");
    if !is_ai8x9(call_ai8x9(make_ai8x9, 9), 9) fail("ai8x9: callback return round trip");
    if !check_ai8x9(make_ai8x9(7), 7) fail("ai8x9: argument made in Jai");
    if !pass_ai8x9(cb_pass_ai8x9, 7) fail("ai8x9: callback argument");
    if !passtail_ai8x9(cb_tail_ai8x9, 7) fail("ai8x9: callback argument after five integers");
    if !passfar_ai8x9(cb_far_ai8x9, 7) fail("ai8x9: callback argument after seven integers");
    if !passd_ai8x9(cb_dbl_ai8x9, 7) fail("ai8x9: callback argument after eight doubles");
    if !is_ai32x3(ret_ai32x3(7), 7) fail("ai32x3: foreign return");
    if !apply_check_ai32x3(make_ai32x3, 7) fail("ai32x3: callback return read by C");
    if !is_ai32x3(call_ai32x3(make_ai32x3, 9), 9) fail("ai32x3: callback return round trip");
    if !check_ai32x3(make_ai32x3(7), 7) fail("ai32x3: argument made in Jai");
    if !pass_ai32x3(cb_pass_ai32x3, 7) fail("ai32x3: callback argument");
    if !passtail_ai32x3(cb_tail_ai32x3, 7) fail("ai32x3: callback argument after five integers");
    if !passfar_ai32x3(cb_far_ai32x3, 7) fail("ai32x3: callback argument after seven integers");
    if !passd_ai32x3(cb_dbl_ai32x3, 7) fail("ai32x3: callback argument after eight doubles");
    if !is_af32x2(ret_af32x2(7), 7) fail("af32x2: foreign return");
    if !apply_check_af32x2(make_af32x2, 7) fail("af32x2: callback return read by C");
    if !is_af32x2(call_af32x2(make_af32x2, 9), 9) fail("af32x2: callback return round trip");
    if !check_af32x2(make_af32x2(7), 7) fail("af32x2: argument made in Jai");
    if !pass_af32x2(cb_pass_af32x2, 7) fail("af32x2: callback argument");
    if !passtail_af32x2(cb_tail_af32x2, 7) fail("af32x2: callback argument after five integers");
    if !passfar_af32x2(cb_far_af32x2, 7) fail("af32x2: callback argument after seven integers");
    if !passd_af32x2(cb_dbl_af32x2, 7) fail("af32x2: callback argument after eight doubles");
    if !is_af64x3(ret_af64x3(7), 7) fail("af64x3: foreign return");
    if !apply_check_af64x3(make_af64x3, 7) fail("af64x3: callback return read by C");
    if !is_af64x3(call_af64x3(make_af64x3, 9), 9) fail("af64x3: callback return round trip");
    if !check_af64x3(make_af64x3(7), 7) fail("af64x3: argument made in Jai");
    if !pass_af64x3(cb_pass_af64x3, 7) fail("af64x3: callback argument");
    if !passtail_af64x3(cb_tail_af64x3, 7) fail("af64x3: callback argument after five integers");
    if !passfar_af64x3(cb_far_af64x3, 7) fail("af64x3: callback argument after seven integers");
    if !passd_af64x3(cb_dbl_af64x3, 7) fail("af64x3: callback argument after eight doubles");
    if !is_asmix(ret_asmix(7), 7) fail("asmix: foreign return");
    if !apply_check_asmix(make_asmix, 7) fail("asmix: callback return read by C");
    if !is_asmix(call_asmix(make_asmix, 9), 9) fail("asmix: callback return round trip");
    if !check_asmix(make_asmix(7), 7) fail("asmix: argument made in Jai");
    if !pass_asmix(cb_pass_asmix, 7) fail("asmix: callback argument");
    if !passtail_asmix(cb_tail_asmix, 7) fail("asmix: callback argument after five integers");
    if !passfar_asmix(cb_far_asmix, 7) fail("asmix: callback argument after seven integers");
    if !passd_asmix(cb_dbl_asmix, 7) fail("asmix: callback argument after eight doubles");
    if !is_ui32f32(ret_ui32f32(7), 7) fail("ui32f32: foreign return");
    if !apply_check_ui32f32(make_ui32f32, 7) fail("ui32f32: callback return read by C");
    if !is_ui32f32(call_ui32f32(make_ui32f32, 9), 9) fail("ui32f32: callback return round trip");
    if !check_ui32f32(make_ui32f32(7), 7) fail("ui32f32: argument made in Jai");
    if !pass_ui32f32(cb_pass_ui32f32, 7) fail("ui32f32: callback argument");
    if !passtail_ui32f32(cb_tail_ui32f32, 7) fail("ui32f32: callback argument after five integers");
    if !passfar_ui32f32(cb_far_ui32f32, 7) fail("ui32f32: callback argument after seven integers");
    if !passd_ui32f32(cb_dbl_ui32f32, 7) fail("ui32f32: callback argument after eight doubles");
    if !is_ui64f64(ret_ui64f64(7), 7) fail("ui64f64: foreign return");
    if !apply_check_ui64f64(make_ui64f64, 7) fail("ui64f64: callback return read by C");
    if !is_ui64f64(call_ui64f64(make_ui64f64, 9), 9) fail("ui64f64: callback return round trip");
    if !check_ui64f64(make_ui64f64(7), 7) fail("ui64f64: argument made in Jai");
    if !pass_ui64f64(cb_pass_ui64f64, 7) fail("ui64f64: callback argument");
    if !passtail_ui64f64(cb_tail_ui64f64, 7) fail("ui64f64: callback argument after five integers");
    if !passfar_ui64f64(cb_far_ui64f64, 7) fail("ui64f64: callback argument after seven integers");
    if !passd_ui64f64(cb_dbl_ui64f64, 7) fail("ui64f64: callback argument after eight doubles");
    if !is_uf32x2i64(ret_uf32x2i64(7), 7) fail("uf32x2i64: foreign return");
    if !apply_check_uf32x2i64(make_uf32x2i64, 7) fail("uf32x2i64: callback return read by C");
    if !is_uf32x2i64(call_uf32x2i64(make_uf32x2i64, 9), 9) fail("uf32x2i64: callback return round trip");
    if !check_uf32x2i64(make_uf32x2i64(7), 7) fail("uf32x2i64: argument made in Jai");
    if !pass_uf32x2i64(cb_pass_uf32x2i64, 7) fail("uf32x2i64: callback argument");
    if !passtail_uf32x2i64(cb_tail_uf32x2i64, 7) fail("uf32x2i64: callback argument after five integers");
    if !passfar_uf32x2i64(cb_far_uf32x2i64, 7) fail("uf32x2i64: callback argument after seven integers");
    if !passd_uf32x2i64(cb_dbl_uf32x2i64, 7) fail("uf32x2i64: callback argument after eight doubles");
    if !is_nmix(ret_nmix(7), 7) fail("nmix: foreign return");
    if !apply_check_nmix(make_nmix, 7) fail("nmix: callback return read by C");
    if !is_nmix(call_nmix(make_nmix, 9), 9) fail("nmix: callback return round trip");
    if !check_nmix(make_nmix(7), 7) fail("nmix: argument made in Jai");
    if !pass_nmix(cb_pass_nmix, 7) fail("nmix: callback argument");
    if !passtail_nmix(cb_tail_nmix, 7) fail("nmix: callback argument after five integers");
    if !passfar_nmix(cb_far_nmix, 7) fail("nmix: callback argument after seven integers");
    if !passd_nmix(cb_dbl_nmix, 7) fail("nmix: callback argument after eight doubles");
    if !is_nf32(ret_nf32(7), 7) fail("nf32: foreign return");
    if !apply_check_nf32(make_nf32, 7) fail("nf32: callback return read by C");
    if !is_nf32(call_nf32(make_nf32, 9), 9) fail("nf32: callback return round trip");
    if !check_nf32(make_nf32(7), 7) fail("nf32: argument made in Jai");
    if !pass_nf32(cb_pass_nf32, 7) fail("nf32: callback argument");
    if !passtail_nf32(cb_tail_nf32, 7) fail("nf32: callback argument after five integers");
    if !passfar_nf32(cb_far_nf32, 7) fail("nf32: callback argument after seven integers");
    if !passd_nf32(cb_dbl_nf32, 7) fail("nf32: callback argument after eight doubles");
    if failures == 0 print("ok\n");
}
