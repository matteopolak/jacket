pass_f32x3 :: (cb: (r: f32x3, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passtail_f32x3 :: (cb: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, r: f32x3, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passfar_f32x3 :: (cb: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, a6: s64, a7: s64, r: f32x3, d: float64, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;
passd_f32x3 :: (cb: (d1: float64, d2: float64, d3: float64, d4: float64, d5: float64, d6: float64, d7: float64, d8: float64, r: f32x3, seed: s32) -> s32 #c_call, seed: s32) -> s32 #foreign shapes;

make_f32x3 :: (seed: s32) -> f32x3 #c_call {
    r: f32x3;
    r.f0 = cast(float32) (seed + 1.5);
    r.f1 = cast(float32) (seed + 2.5);
    r.f2 = cast(float32) (seed + 3.5);
    return r;
}

is_f32x3 :: (r: f32x3, seed: s32) -> bool #c_call {
    return r.f0 == cast(float32) (seed + 1.5) && r.f1 == cast(float32) (seed + 2.5) && r.f2 == cast(float32) (seed + 3.5);
}

cb_pass_f32x3 :: (r: f32x3, seed: s32) -> s32 #c_call {
    return ifx is_f32x3(r, seed) then 1 else 0;
}

cb_tail_f32x3 :: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, r: f32x3, seed: s32) -> s32 #c_call {
    return ifx a1 == 1 && a2 == 2 && a3 == 3 && a4 == 4 && a5 == 5 && is_f32x3(r, seed) then 1 else 0;
}

cb_far_f32x3 :: (a1: s64, a2: s64, a3: s64, a4: s64, a5: s64, a6: s64, a7: s64, r: f32x3, d: float64, seed: s32) -> s32 #c_call {
    return ifx a1 == 1 && a2 == 2 && a3 == 3 && a4 == 4 && a5 == 5 && a6 == 6 && a7 == 7 && d == 0.5 && is_f32x3(r, seed) then 1 else 0;
}

cb_dbl_f32x3 :: (d1: float64, d2: float64, d3: float64, d4: float64, d5: float64, d6: float64, d7: float64, d8: float64, r: f32x3, seed: s32) -> s32 #c_call {
    return ifx d1 == 1 && d2 == 2 && d3 == 3 && d4 == 4 && d5 == 5 && d6 == 6 && d7 == 7 && d8 == 8 && is_f32x3(r, seed) then 1 else 0;
}

