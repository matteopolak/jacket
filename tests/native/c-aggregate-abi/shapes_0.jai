main :: () {
    if !is_i64x2(ret_i64x2(7), 7) fail("i64x2: foreign return");
    if !apply_check_i64x2(make_i64x2, 7) fail("i64x2: callback return read by C");
    if !is_i64x2(call_i64x2(make_i64x2, 9), 9) fail("i64x2: callback return round trip");
    if !check_i64x2(make_i64x2(7), 7) fail("i64x2: argument made in Jai");
    if !pass_i64x2(cb_pass_i64x2, 7) fail("i64x2: callback argument");
    if !passtail_i64x2(cb_tail_i64x2, 7) fail("i64x2: callback argument after five integers");
    if !passfar_i64x2(cb_far_i64x2, 7) fail("i64x2: callback argument after seven integers");
    if !passd_i64x2(cb_dbl_i64x2, 7) fail("i64x2: callback argument after eight doubles");
    if !is_i32i64(ret_i32i64(7), 7) fail("i32i64: foreign return");
    if !apply_check_i32i64(make_i32i64, 7) fail("i32i64: callback return read by C");
    if !is_i32i64(call_i32i64(make_i32i64, 9), 9) fail("i32i64: callback return round trip");
    if !check_i32i64(make_i32i64(7), 7) fail("i32i64: argument made in Jai");
    if !pass_i32i64(cb_pass_i32i64, 7) fail("i32i64: callback argument");
    if !passtail_i32i64(cb_tail_i32i64, 7) fail("i32i64: callback argument after five integers");
    if !passfar_i32i64(cb_far_i32i64, 7) fail("i32i64: callback argument after seven integers");
    if !passd_i32i64(cb_dbl_i32i64, 7) fail("i32i64: callback argument after eight doubles");
    if !is_i8i64(ret_i8i64(7), 7) fail("i8i64: foreign return");
    if !apply_check_i8i64(make_i8i64, 7) fail("i8i64: callback return read by C");
    if !is_i8i64(call_i8i64(make_i8i64, 9), 9) fail("i8i64: callback return round trip");
    if !check_i8i64(make_i8i64(7), 7) fail("i8i64: argument made in Jai");
    if !pass_i8i64(cb_pass_i8i64, 7) fail("i8i64: callback argument");
    if !passtail_i8i64(cb_tail_i8i64, 7) fail("i8i64: callback argument after five integers");
    if !passfar_i8i64(cb_far_i8i64, 7) fail("i8i64: callback argument after seven integers");
    if !passd_i8i64(cb_dbl_i8i64, 7) fail("i8i64: callback argument after eight doubles");
    if !is_i16i8i32(ret_i16i8i32(7), 7) fail("i16i8i32: foreign return");
    if !apply_check_i16i8i32(make_i16i8i32, 7) fail("i16i8i32: callback return read by C");
    if !is_i16i8i32(call_i16i8i32(make_i16i8i32, 9), 9) fail("i16i8i32: callback return round trip");
    if !check_i16i8i32(make_i16i8i32(7), 7) fail("i16i8i32: argument made in Jai");
    if !pass_i16i8i32(cb_pass_i16i8i32, 7) fail("i16i8i32: callback argument");
    if !passtail_i16i8i32(cb_tail_i16i8i32, 7) fail("i16i8i32: callback argument after five integers");
    if !passfar_i16i8i32(cb_far_i16i8i32, 7) fail("i16i8i32: callback argument after seven integers");
    if !passd_i16i8i32(cb_dbl_i16i8i32, 7) fail("i16i8i32: callback argument after eight doubles");
    if !is_i64x3(ret_i64x3(7), 7) fail("i64x3: foreign return");
    if !apply_check_i64x3(make_i64x3, 7) fail("i64x3: callback return read by C");
    if !is_i64x3(call_i64x3(make_i64x3, 9), 9) fail("i64x3: callback return round trip");
    if !check_i64x3(make_i64x3(7), 7) fail("i64x3: argument made in Jai");
    if !pass_i64x3(cb_pass_i64x3, 7) fail("i64x3: callback argument");
    if !passtail_i64x3(cb_tail_i64x3, 7) fail("i64x3: callback argument after five integers");
    if !passfar_i64x3(cb_far_i64x3, 7) fail("i64x3: callback argument after seven integers");
    if !passd_i64x3(cb_dbl_i64x3, 7) fail("i64x3: callback argument after eight doubles");
    if !is_i64x5(ret_i64x5(7), 7) fail("i64x5: foreign return");
    if !apply_check_i64x5(make_i64x5, 7) fail("i64x5: callback return read by C");
    if !is_i64x5(call_i64x5(make_i64x5, 9), 9) fail("i64x5: callback return round trip");
    if !check_i64x5(make_i64x5(7), 7) fail("i64x5: argument made in Jai");
    if !pass_i64x5(cb_pass_i64x5, 7) fail("i64x5: callback argument");
    if !passtail_i64x5(cb_tail_i64x5, 7) fail("i64x5: callback argument after five integers");
    if !passfar_i64x5(cb_far_i64x5, 7) fail("i64x5: callback argument after seven integers");
    if !passd_i64x5(cb_dbl_i64x5, 7) fail("i64x5: callback argument after eight doubles");
    if !is_f32x2(ret_f32x2(7), 7) fail("f32x2: foreign return");
    if !apply_check_f32x2(make_f32x2, 7) fail("f32x2: callback return read by C");
    if !is_f32x2(call_f32x2(make_f32x2, 9), 9) fail("f32x2: callback return round trip");
    if !check_f32x2(make_f32x2(7), 7) fail("f32x2: argument made in Jai");
    if !pass_f32x2(cb_pass_f32x2, 7) fail("f32x2: callback argument");
    if !passtail_f32x2(cb_tail_f32x2, 7) fail("f32x2: callback argument after five integers");
    if !passfar_f32x2(cb_far_f32x2, 7) fail("f32x2: callback argument after seven integers");
    if !passd_f32x2(cb_dbl_f32x2, 7) fail("f32x2: callback argument after eight doubles");
    if !is_f32x3(ret_f32x3(7), 7) fail("f32x3: foreign return");
    if !apply_check_f32x3(make_f32x3, 7) fail("f32x3: callback return read by C");
    if !is_f32x3(call_f32x3(make_f32x3, 9), 9) fail("f32x3: callback return round trip");
    if !check_f32x3(make_f32x3(7), 7) fail("f32x3: argument made in Jai");
    if !pass_f32x3(cb_pass_f32x3, 7) fail("f32x3: callback argument");
    if !passtail_f32x3(cb_tail_f32x3, 7) fail("f32x3: callback argument after five integers");
    if !passfar_f32x3(cb_far_f32x3, 7) fail("f32x3: callback argument after seven integers");
    if !passd_f32x3(cb_dbl_f32x3, 7) fail("f32x3: callback argument after eight doubles");
    if !is_f32x4(ret_f32x4(7), 7) fail("f32x4: foreign return");
    if !apply_check_f32x4(make_f32x4, 7) fail("f32x4: callback return read by C");
    if !is_f32x4(call_f32x4(make_f32x4, 9), 9) fail("f32x4: callback return round trip");
    if !check_f32x4(make_f32x4(7), 7) fail("f32x4: argument made in Jai");
    if !pass_f32x4(cb_pass_f32x4, 7) fail("f32x4: callback argument");
    if !passtail_f32x4(cb_tail_f32x4, 7) fail("f32x4: callback argument after five integers");
    if !passfar_f32x4(cb_far_f32x4, 7) fail("f32x4: callback argument after seven integers");
    if !passd_f32x4(cb_dbl_f32x4, 7) fail("f32x4: callback argument after eight doubles");
    if !is_f32x5(ret_f32x5(7), 7) fail("f32x5: foreign return");
    if !apply_check_f32x5(make_f32x5, 7) fail("f32x5: callback return read by C");
    if !is_f32x5(call_f32x5(make_f32x5, 9), 9) fail("f32x5: callback return round trip");
    if !check_f32x5(make_f32x5(7), 7) fail("f32x5: argument made in Jai");
    if !pass_f32x5(cb_pass_f32x5, 7) fail("f32x5: callback argument");
    if !passtail_f32x5(cb_tail_f32x5, 7) fail("f32x5: callback argument after five integers");
    if !passfar_f32x5(cb_far_f32x5, 7) fail("f32x5: callback argument after seven integers");
    if !passd_f32x5(cb_dbl_f32x5, 7) fail("f32x5: callback argument after eight doubles");
    if failures == 0 print("ok\n");
}
