main :: () {
    if !is_pk_i16i32(ret_pk_i16i32(7), 7) fail("pk_i16i32: foreign return");
    if !apply_check_pk_i16i32(make_pk_i16i32, 7) fail("pk_i16i32: callback return read by C");
    if !is_pk_i16i32(call_pk_i16i32(make_pk_i16i32, 9), 9) fail("pk_i16i32: callback return round trip");
    if !check_pk_i16i32(make_pk_i16i32(7), 7) fail("pk_i16i32: argument made in Jai");
    if !pass_pk_i16i32(cb_pass_pk_i16i32, 7) fail("pk_i16i32: callback argument");
    if !passtail_pk_i16i32(cb_tail_pk_i16i32, 7) fail("pk_i16i32: callback argument after five integers");
    if !passfar_pk_i16i32(cb_far_pk_i16i32, 7) fail("pk_i16i32: callback argument after seven integers");
    if !passd_pk_i16i32(cb_dbl_pk_i16i32, 7) fail("pk_i16i32: callback argument after eight doubles");
    if !is_pk_i8x3(ret_pk_i8x3(7), 7) fail("pk_i8x3: foreign return");
    if !apply_check_pk_i8x3(make_pk_i8x3, 7) fail("pk_i8x3: callback return read by C");
    if !is_pk_i8x3(call_pk_i8x3(make_pk_i8x3, 9), 9) fail("pk_i8x3: callback return round trip");
    if !check_pk_i8x3(make_pk_i8x3(7), 7) fail("pk_i8x3: argument made in Jai");
    if !pass_pk_i8x3(cb_pass_pk_i8x3, 7) fail("pk_i8x3: callback argument");
    if !passtail_pk_i8x3(cb_tail_pk_i8x3, 7) fail("pk_i8x3: callback argument after five integers");
    if !passfar_pk_i8x3(cb_far_pk_i8x3, 7) fail("pk_i8x3: callback argument after seven integers");
    if !passd_pk_i8x3(cb_dbl_pk_i8x3, 7) fail("pk_i8x3: callback argument after eight doubles");
    if !is_pk_i8i64x2(ret_pk_i8i64x2(7), 7) fail("pk_i8i64x2: foreign return");
    if !apply_check_pk_i8i64x2(make_pk_i8i64x2, 7) fail("pk_i8i64x2: callback return read by C");
    if !is_pk_i8i64x2(call_pk_i8i64x2(make_pk_i8i64x2, 9), 9) fail("pk_i8i64x2: callback return round trip");
    if !check_pk_i8i64x2(make_pk_i8i64x2(7), 7) fail("pk_i8i64x2: argument made in Jai");
    if !pass_pk_i8i64x2(cb_pass_pk_i8i64x2, 7) fail("pk_i8i64x2: callback argument");
    if !passtail_pk_i8i64x2(cb_tail_pk_i8i64x2, 7) fail("pk_i8i64x2: callback argument after five integers");
    if !passfar_pk_i8i64x2(cb_far_pk_i8i64x2, 7) fail("pk_i8i64x2: callback argument after seven integers");
    if !passd_pk_i8i64x2(cb_dbl_pk_i8i64x2, 7) fail("pk_i8i64x2: callback argument after eight doubles");
    if !is_pk_f64x4(ret_pk_f64x4(7), 7) fail("pk_f64x4: foreign return");
    if !apply_check_pk_f64x4(make_pk_f64x4, 7) fail("pk_f64x4: callback return read by C");
    if !is_pk_f64x4(call_pk_f64x4(make_pk_f64x4, 9), 9) fail("pk_f64x4: callback return round trip");
    if !check_pk_f64x4(make_pk_f64x4(7), 7) fail("pk_f64x4: argument made in Jai");
    if !pass_pk_f64x4(cb_pass_pk_f64x4, 7) fail("pk_f64x4: callback argument");
    if !passtail_pk_f64x4(cb_tail_pk_f64x4, 7) fail("pk_f64x4: callback argument after five integers");
    if !passfar_pk_f64x4(cb_far_pk_f64x4, 7) fail("pk_f64x4: callback argument after seven integers");
    if !passd_pk_f64x4(cb_dbl_pk_f64x4, 7) fail("pk_f64x4: callback argument after eight doubles");
    if !is_pk_i32f64(ret_pk_i32f64(7), 7) fail("pk_i32f64: foreign return");
    if !apply_check_pk_i32f64(make_pk_i32f64, 7) fail("pk_i32f64: callback return read by C");
    if !is_pk_i32f64(call_pk_i32f64(make_pk_i32f64, 9), 9) fail("pk_i32f64: callback return round trip");
    if !check_pk_i32f64(make_pk_i32f64(7), 7) fail("pk_i32f64: argument made in Jai");
    if !pass_pk_i32f64(cb_pass_pk_i32f64, 7) fail("pk_i32f64: callback argument");
    if !passtail_pk_i32f64(cb_tail_pk_i32f64, 7) fail("pk_i32f64: callback argument after five integers");
    if !passfar_pk_i32f64(cb_far_pk_i32f64, 7) fail("pk_i32f64: callback argument after seven integers");
    if !passd_pk_i32f64(cb_dbl_pk_i32f64, 7) fail("pk_i32f64: callback argument after eight doubles");
    if !is_pk_f64i32(ret_pk_f64i32(7), 7) fail("pk_f64i32: foreign return");
    if !apply_check_pk_f64i32(make_pk_f64i32, 7) fail("pk_f64i32: callback return read by C");
    if !is_pk_f64i32(call_pk_f64i32(make_pk_f64i32, 9), 9) fail("pk_f64i32: callback return round trip");
    if !check_pk_f64i32(make_pk_f64i32(7), 7) fail("pk_f64i32: argument made in Jai");
    if !pass_pk_f64i32(cb_pass_pk_f64i32, 7) fail("pk_f64i32: callback argument");
    if !passtail_pk_f64i32(cb_tail_pk_f64i32, 7) fail("pk_f64i32: callback argument after five integers");
    if !passfar_pk_f64i32(cb_far_pk_f64i32, 7) fail("pk_f64i32: callback argument after seven integers");
    if !passd_pk_f64i32(cb_dbl_pk_f64i32, 7) fail("pk_f64i32: callback argument after eight doubles");
    if !is_pk_i32x2(ret_pk_i32x2(7), 7) fail("pk_i32x2: foreign return");
    if !apply_check_pk_i32x2(make_pk_i32x2, 7) fail("pk_i32x2: callback return read by C");
    if !is_pk_i32x2(call_pk_i32x2(make_pk_i32x2, 9), 9) fail("pk_i32x2: callback return round trip");
    if !check_pk_i32x2(make_pk_i32x2(7), 7) fail("pk_i32x2: argument made in Jai");
    if !pass_pk_i32x2(cb_pass_pk_i32x2, 7) fail("pk_i32x2: callback argument");
    if !passtail_pk_i32x2(cb_tail_pk_i32x2, 7) fail("pk_i32x2: callback argument after five integers");
    if !passfar_pk_i32x2(cb_far_pk_i32x2, 7) fail("pk_i32x2: callback argument after seven integers");
    if !passd_pk_i32x2(cb_dbl_pk_i32x2, 7) fail("pk_i32x2: callback argument after eight doubles");
    if !is_pk_f32f64(ret_pk_f32f64(7), 7) fail("pk_f32f64: foreign return");
    if !apply_check_pk_f32f64(make_pk_f32f64, 7) fail("pk_f32f64: callback return read by C");
    if !is_pk_f32f64(call_pk_f32f64(make_pk_f32f64, 9), 9) fail("pk_f32f64: callback return round trip");
    if !check_pk_f32f64(make_pk_f32f64(7), 7) fail("pk_f32f64: argument made in Jai");
    if !pass_pk_f32f64(cb_pass_pk_f32f64, 7) fail("pk_f32f64: callback argument");
    if !passtail_pk_f32f64(cb_tail_pk_f32f64, 7) fail("pk_f32f64: callback argument after five integers");
    if !passfar_pk_f32f64(cb_far_pk_f32f64, 7) fail("pk_f32f64: callback argument after seven integers");
    if !passd_pk_f32f64(cb_dbl_pk_f32f64, 7) fail("pk_f32f64: callback argument after eight doubles");
    if !is_pk_i8f32x2(ret_pk_i8f32x2(7), 7) fail("pk_i8f32x2: foreign return");
    if !apply_check_pk_i8f32x2(make_pk_i8f32x2, 7) fail("pk_i8f32x2: callback return read by C");
    if !is_pk_i8f32x2(call_pk_i8f32x2(make_pk_i8f32x2, 9), 9) fail("pk_i8f32x2: callback return round trip");
    if !check_pk_i8f32x2(make_pk_i8f32x2(7), 7) fail("pk_i8f32x2: argument made in Jai");
    if !pass_pk_i8f32x2(cb_pass_pk_i8f32x2, 7) fail("pk_i8f32x2: callback argument");
    if !passtail_pk_i8f32x2(cb_tail_pk_i8f32x2, 7) fail("pk_i8f32x2: callback argument after five integers");
    if !passfar_pk_i8f32x2(cb_far_pk_i8f32x2, 7) fail("pk_i8f32x2: callback argument after seven integers");
    if !passd_pk_i8f32x2(cb_dbl_pk_i8f32x2, 7) fail("pk_i8f32x2: callback argument after eight doubles");
    if !is_pk_ai32x2(ret_pk_ai32x2(7), 7) fail("pk_ai32x2: foreign return");
    if !apply_check_pk_ai32x2(make_pk_ai32x2, 7) fail("pk_ai32x2: callback return read by C");
    if !is_pk_ai32x2(call_pk_ai32x2(make_pk_ai32x2, 9), 9) fail("pk_ai32x2: callback return round trip");
    if !check_pk_ai32x2(make_pk_ai32x2(7), 7) fail("pk_ai32x2: argument made in Jai");
    if !pass_pk_ai32x2(cb_pass_pk_ai32x2, 7) fail("pk_ai32x2: callback argument");
    if !passtail_pk_ai32x2(cb_tail_pk_ai32x2, 7) fail("pk_ai32x2: callback argument after five integers");
    if !passfar_pk_ai32x2(cb_far_pk_ai32x2, 7) fail("pk_ai32x2: callback argument after seven integers");
    if !passd_pk_ai32x2(cb_dbl_pk_ai32x2, 7) fail("pk_ai32x2: callback argument after eight doubles");
    if failures == 0 print("ok\n");
}
