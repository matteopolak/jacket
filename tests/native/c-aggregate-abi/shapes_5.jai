main :: () {
    if !is_pk_nested(ret_pk_nested(7), 7) fail("pk_nested: foreign return");
    if !apply_check_pk_nested(make_pk_nested, 7) fail("pk_nested: callback return read by C");
    if !is_pk_nested(call_pk_nested(make_pk_nested, 9), 9) fail("pk_nested: callback return round trip");
    if !check_pk_nested(make_pk_nested(7), 7) fail("pk_nested: argument made in Jai");
    if !pass_pk_nested(cb_pass_pk_nested, 7) fail("pk_nested: callback argument");
    if !passtail_pk_nested(cb_tail_pk_nested, 7) fail("pk_nested: callback argument after five integers");
    if !passfar_pk_nested(cb_far_pk_nested, 7) fail("pk_nested: callback argument after seven integers");
    if !passd_pk_nested(cb_dbl_pk_nested, 7) fail("pk_nested: callback argument after eight doubles");
    if !is_big1k(ret_big1k(7), 7) fail("big1k: foreign return");
    if !apply_check_big1k(make_big1k, 7) fail("big1k: callback return read by C");
    if !is_big1k(call_big1k(make_big1k, 9), 9) fail("big1k: callback return round trip");
    if failures == 0 print("ok\n");
}
