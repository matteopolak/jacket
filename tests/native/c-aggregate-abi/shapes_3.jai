main :: () {
    if !is_nsmall(ret_nsmall(7), 7) fail("nsmall: foreign return");
    if !apply_check_nsmall(make_nsmall, 7) fail("nsmall: callback return read by C");
    if !is_nsmall(call_nsmall(make_nsmall, 9), 9) fail("nsmall: callback return round trip");
    if !check_nsmall(make_nsmall(7), 7) fail("nsmall: argument made in Jai");
    if !pass_nsmall(cb_pass_nsmall, 7) fail("nsmall: callback argument");
    if !passtail_nsmall(cb_tail_nsmall, 7) fail("nsmall: callback argument after five integers");
    if !passfar_nsmall(cb_far_nsmall, 7) fail("nsmall: callback argument after seven integers");
    if !passd_nsmall(cb_dbl_nsmall, 7) fail("nsmall: callback argument after eight doubles");
    if !is_nbig(ret_nbig(7), 7) fail("nbig: foreign return");
    if !apply_check_nbig(make_nbig, 7) fail("nbig: callback return read by C");
    if !is_nbig(call_nbig(make_nbig, 9), 9) fail("nbig: callback return round trip");
    if !check_nbig(make_nbig(7), 7) fail("nbig: argument made in Jai");
    if !pass_nbig(cb_pass_nbig, 7) fail("nbig: callback argument");
    if !passtail_nbig(cb_tail_nbig, 7) fail("nbig: callback argument after five integers");
    if !passfar_nbig(cb_far_nbig, 7) fail("nbig: callback argument after seven integers");
    if !passd_nbig(cb_dbl_nbig, 7) fail("nbig: callback argument after eight doubles");
    if !is_pk_i8i32(ret_pk_i8i32(7), 7) fail("pk_i8i32: foreign return");
    if !apply_check_pk_i8i32(make_pk_i8i32, 7) fail("pk_i8i32: callback return read by C");
    if !is_pk_i8i32(call_pk_i8i32(make_pk_i8i32, 9), 9) fail("pk_i8i32: callback return round trip");
    if !check_pk_i8i32(make_pk_i8i32(7), 7) fail("pk_i8i32: argument made in Jai");
    if !pass_pk_i8i32(cb_pass_pk_i8i32, 7) fail("pk_i8i32: callback argument");
    if !passtail_pk_i8i32(cb_tail_pk_i8i32, 7) fail("pk_i8i32: callback argument after five integers");
    if !passfar_pk_i8i32(cb_far_pk_i8i32, 7) fail("pk_i8i32: callback argument after seven integers");
    if !passd_pk_i8i32(cb_dbl_pk_i8i32, 7) fail("pk_i8i32: callback argument after eight doubles");
    if !is_pk_i8i32a(ret_pk_i8i32a(7), 7) fail("pk_i8i32a: foreign return");
    if !apply_check_pk_i8i32a(make_pk_i8i32a, 7) fail("pk_i8i32a: callback return read by C");
    if !is_pk_i8i32a(call_pk_i8i32a(make_pk_i8i32a, 9), 9) fail("pk_i8i32a: callback return round trip");
    if !check_pk_i8i32a(make_pk_i8i32a(7), 7) fail("pk_i8i32a: argument made in Jai");
    if !pass_pk_i8i32a(cb_pass_pk_i8i32a, 7) fail("pk_i8i32a: callback argument");
    if !passtail_pk_i8i32a(cb_tail_pk_i8i32a, 7) fail("pk_i8i32a: callback argument after five integers");
    if !passfar_pk_i8i32a(cb_far_pk_i8i32a, 7) fail("pk_i8i32a: callback argument after seven integers");
    if !passd_pk_i8i32a(cb_dbl_pk_i8i32a, 7) fail("pk_i8i32a: callback argument after eight doubles");
    if !is_pk_i8i64(ret_pk_i8i64(7), 7) fail("pk_i8i64: foreign return");
    if !apply_check_pk_i8i64(make_pk_i8i64, 7) fail("pk_i8i64: callback return read by C");
    if !is_pk_i8i64(call_pk_i8i64(make_pk_i8i64, 9), 9) fail("pk_i8i64: callback return round trip");
    if !check_pk_i8i64(make_pk_i8i64(7), 7) fail("pk_i8i64: argument made in Jai");
    if !pass_pk_i8i64(cb_pass_pk_i8i64, 7) fail("pk_i8i64: callback argument");
    if !passtail_pk_i8i64(cb_tail_pk_i8i64, 7) fail("pk_i8i64: callback argument after five integers");
    if !passfar_pk_i8i64(cb_far_pk_i8i64, 7) fail("pk_i8i64: callback argument after seven integers");
    if !passd_pk_i8i64(cb_dbl_pk_i8i64, 7) fail("pk_i8i64: callback argument after eight doubles");
    if !is_pk_i8f64(ret_pk_i8f64(7), 7) fail("pk_i8f64: foreign return");
    if !apply_check_pk_i8f64(make_pk_i8f64, 7) fail("pk_i8f64: callback return read by C");
    if !is_pk_i8f64(call_pk_i8f64(make_pk_i8f64, 9), 9) fail("pk_i8f64: callback return round trip");
    if !check_pk_i8f64(make_pk_i8f64(7), 7) fail("pk_i8f64: argument made in Jai");
    if !pass_pk_i8f64(cb_pass_pk_i8f64, 7) fail("pk_i8f64: callback argument");
    if !passtail_pk_i8f64(cb_tail_pk_i8f64, 7) fail("pk_i8f64: callback argument after five integers");
    if !passfar_pk_i8f64(cb_far_pk_i8f64, 7) fail("pk_i8f64: callback argument after seven integers");
    if !passd_pk_i8f64(cb_dbl_pk_i8f64, 7) fail("pk_i8f64: callback argument after eight doubles");
    if !is_pk_i8f32(ret_pk_i8f32(7), 7) fail("pk_i8f32: foreign return");
    if !apply_check_pk_i8f32(make_pk_i8f32, 7) fail("pk_i8f32: callback return read by C");
    if !is_pk_i8f32(call_pk_i8f32(make_pk_i8f32, 9), 9) fail("pk_i8f32: callback return round trip");
    if !check_pk_i8f32(make_pk_i8f32(7), 7) fail("pk_i8f32: argument made in Jai");
    if !pass_pk_i8f32(cb_pass_pk_i8f32, 7) fail("pk_i8f32: callback argument");
    if !passtail_pk_i8f32(cb_tail_pk_i8f32, 7) fail("pk_i8f32: callback argument after five integers");
    if !passfar_pk_i8f32(cb_far_pk_i8f32, 7) fail("pk_i8f32: callback argument after seven integers");
    if !passd_pk_i8f32(cb_dbl_pk_i8f32, 7) fail("pk_i8f32: callback argument after eight doubles");
    if !is_pk_f32x2(ret_pk_f32x2(7), 7) fail("pk_f32x2: foreign return");
    if !apply_check_pk_f32x2(make_pk_f32x2, 7) fail("pk_f32x2: callback return read by C");
    if !is_pk_f32x2(call_pk_f32x2(make_pk_f32x2, 9), 9) fail("pk_f32x2: callback return round trip");
    if !check_pk_f32x2(make_pk_f32x2(7), 7) fail("pk_f32x2: argument made in Jai");
    if !pass_pk_f32x2(cb_pass_pk_f32x2, 7) fail("pk_f32x2: callback argument");
    if !passtail_pk_f32x2(cb_tail_pk_f32x2, 7) fail("pk_f32x2: callback argument after five integers");
    if !passfar_pk_f32x2(cb_far_pk_f32x2, 7) fail("pk_f32x2: callback argument after seven integers");
    if !passd_pk_f32x2(cb_dbl_pk_f32x2, 7) fail("pk_f32x2: callback argument after eight doubles");
    if !is_pk_f32x2a(ret_pk_f32x2a(7), 7) fail("pk_f32x2a: foreign return");
    if !apply_check_pk_f32x2a(make_pk_f32x2a, 7) fail("pk_f32x2a: callback return read by C");
    if !is_pk_f32x2a(call_pk_f32x2a(make_pk_f32x2a, 9), 9) fail("pk_f32x2a: callback return round trip");
    if !check_pk_f32x2a(make_pk_f32x2a(7), 7) fail("pk_f32x2a: argument made in Jai");
    if !pass_pk_f32x2a(cb_pass_pk_f32x2a, 7) fail("pk_f32x2a: callback argument");
    if !passtail_pk_f32x2a(cb_tail_pk_f32x2a, 7) fail("pk_f32x2a: callback argument after five integers");
    if !passfar_pk_f32x2a(cb_far_pk_f32x2a, 7) fail("pk_f32x2a: callback argument after seven integers");
    if !passd_pk_f32x2a(cb_dbl_pk_f32x2a, 7) fail("pk_f32x2a: callback argument after eight doubles");
    if !is_pk_i8i16i8i32(ret_pk_i8i16i8i32(7), 7) fail("pk_i8i16i8i32: foreign return");
    if !apply_check_pk_i8i16i8i32(make_pk_i8i16i8i32, 7) fail("pk_i8i16i8i32: callback return read by C");
    if !is_pk_i8i16i8i32(call_pk_i8i16i8i32(make_pk_i8i16i8i32, 9), 9) fail("pk_i8i16i8i32: callback return round trip");
    if !check_pk_i8i16i8i32(make_pk_i8i16i8i32(7), 7) fail("pk_i8i16i8i32: argument made in Jai");
    if !pass_pk_i8i16i8i32(cb_pass_pk_i8i16i8i32, 7) fail("pk_i8i16i8i32: callback argument");
    if !passtail_pk_i8i16i8i32(cb_tail_pk_i8i16i8i32, 7) fail("pk_i8i16i8i32: callback argument after five integers");
    if !passfar_pk_i8i16i8i32(cb_far_pk_i8i16i8i32, 7) fail("pk_i8i16i8i32: callback argument after seven integers");
    if !passd_pk_i8i16i8i32(cb_dbl_pk_i8i16i8i32, 7) fail("pk_i8i16i8i32: callback argument after eight doubles");
    if failures == 0 print("ok\n");
}
