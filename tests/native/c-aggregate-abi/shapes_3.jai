cb_dbl_pk_i8i16i8i32 :: (d1: float64, d2: float64, d3: float64, d4: float64, d5: float64, d6: float64, d7: float64, d8: float64, r: pk_i8i16i8i32, seed: s32) -> s32 #c_call {
