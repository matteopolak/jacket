call_pk_f32x2 :: (cb: (seed: s32) -> pk_f32x2 #c_call, seed: s32) -> pk_f32x2 #foreign shapes;
apply_check_pk_f32x2 :: (cb: (seed: s32) -> pk_f32x2 #c_call, seed: s32) -> s32 #foreign shapes;
